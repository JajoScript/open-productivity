import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

// A button drawn like an `InkField`: the face of a dropdown or of a date field. Enter, Space and the
// vertical arrows press it.
export component InkFieldButton {
    in property <string> text;
    // Drawn at the right edge.
    in property <image> icon;
    // Names the field for screen readers; the text alone would only say its value.
    in property <string> label;
    out property <bool> has-focus: focus.has-focus;
    callback clicked;

    min-height: 36px;
    // Fills its parent even outside a layout, like a field (a select's face, a date over its popup).
    preferred-width: 100%;
    horizontal-stretch: 1;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.text;
    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        border-radius: 6px;
        background: focus.has-focus ? Palette.background : touch.has-hover ? Theme.hover : Theme.field;
        border-width: 1px;
        border-color: focus.has-focus ? Theme.ink : Theme.hairline;
        animate background, border-color { duration: Theme.fast; easing: Theme.ease-out; }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        Image {
            source: root.icon;
            colorize: Theme.muted;
            width: 16px;
            image-fit: contain;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}
