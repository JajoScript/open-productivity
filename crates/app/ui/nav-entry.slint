import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component NavEntry inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <int> count;
    in property <bool> selected;
    callback clicked;

    height: 36px;
    border-radius: 6px;
    background: root.selected ? Theme.selected : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }
    forward-focus: focus;
    accessible-role: list-item;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Image {
            source: root.icon;
            colorize: root.selected ? Palette.foreground : Theme.muted;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            accessible-role: none;
        }

        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        // An empty count is noise, not information.
        if root.count > 0: Text {
            text: root.count;
            vertical-alignment: center;
            color: Theme.muted;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}
