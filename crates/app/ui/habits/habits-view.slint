import { Date, Palette, ScrollView } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { DayState, HabitCell } from "habit-cell.slint";

export { DayState }

// A habit with its days of the month, in the same blocks of seven as `HabitsView.day-numbers`.
export struct HabitRow {
    id: int,
    name: string,
    streak: int,
    best: int,
    month-pct: int,
    // Monday first, and the day it starts: the editor's initial values.
    weekdays: [bool],
    start: Date,
    weeks: [[DayState]],
}

export struct ArchivedRow {
    id: int,
    name: string,
}

// The month of habits: title and month navigation, the button that opens the creator, and the grid.
export component HabitsView inherits VerticalLayout {
    in property <[HabitRow]> habits;
    // Day of the month per cell, in blocks of seven.
    in property <[[int]]> day-numbers;
    in property <string> error;
    in property <int> archived-count;
    callback open-archived();
    // The month shown; only its month and year matter.
    in property <Date> month;
    // Day of the month that is today; 0 when another month is shown.
    in property <int> today-day;
    in property <bool> can-next;
    callback new-habit();
    callback edit-habit(HabitRow);
    // -1 / +1 moves a month; 0 goes back to the current one.
    callback shift(int);
    callback set-habit-done(int, int, bool);

    padding: 24px;
    padding-top: 20px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 4px;
        Text {
            text: @tr("Habits");
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        SubtleButton {
            icon: @image-url("../icons/chevron-left.svg");
            label: @tr("Previous month");
            clicked => {
                root.shift(-1);
            }
        }

        Text {
            text: Strings.month-year(root.month.month, root.month.year);
            vertical-alignment: center;
            horizontal-alignment: center;
            min-width: 120px;
        }

        SubtleButton {
            icon: @image-url("../icons/chevron-right.svg");
            label: @tr("Next month");
            opacity: root.can-next ? 1 : 0.35;
            clicked => {
                if root.can-next {
                    root.shift(1);
                }
            }
        }

        SubtleButton {
            text: @tr("Today");
            color: Palette.foreground;
            clicked => {
                root.shift(0);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        InkButton {
            text: @tr("Add habit");
            clicked => {
                root.new-habit();
            }
        }
    }

    if root.error != "": Text {
        text: root.error;
        color: Theme.critical;
        wrap: word-wrap;
    }

    if root.habits.length == 0: Text {
        text: @tr("No habits yet. Add one above.");
        color: Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }

    // With no active habits the grid is gone, so the link sits under the empty state.
    if root.habits.length == 0 && root.archived-count > 0: HorizontalLayout {
        alignment: center;
        SubtleButton {
            text: @tr("Archived ({})", root.archived-count);
            clicked => {
                root.open-archived();
            }
        }
    }

    // 31 days do not fit the default window next to the names: scroll sideways.
    if root.habits.length > 0: ScrollView {
        VerticalLayout {
            spacing: 6px;
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 112px;
                }

                for week[w] in root.day-numbers: VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: Strings.week-label(w + 1);
                        color: Theme.muted;
                        font-size: 10px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 3px;
                        for day in week: Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 5px;
                            background: day == root.today-day ? Theme.ink : transparent;
                            Text {
                                text: day;
                                font-size: 11px;
                                font-weight: day == root.today-day ? 700 : 400;
                                color: day == root.today-day ? Theme.on-ink : Theme.muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            for habit in root.habits: HorizontalLayout {
                spacing: 8px;
                // The name and stats block opens the editor.
                Rectangle {
                    width: 112px;
                    border-radius: 6px;
                    background: name-touch.has-hover ? Theme.hover : transparent;
                    animate background { duration: Theme.fast; easing: Theme.ease-out; }
                    accessible-role: button;
                    accessible-label: habit.name;
                    accessible-action-default => {
                        root.edit-habit(habit);
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: habit.name;
                            overflow: elide;
                        }

                        // The month's percentage stays visible; only the streaks elide.
                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: Strings.habit-streaks(habit.streak, habit.best);
                                color: Theme.muted;
                                font-size: 10px;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: Strings.percent(habit.month-pct);
                                color: Theme.muted;
                                font-size: 10px;
                                horizontal-stretch: 0;
                            }
                        }
                    }

                    name-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.edit-habit(habit);
                        }
                    }
                }

                for week[w] in habit.weeks: HorizontalLayout {
                    spacing: 3px;
                    for state[i] in week: HabitCell {
                        state: state;
                        label: habit.name + " " + Strings.date(root.day-numbers[w][i], root.month.month, root.month.year);
                        toggled(done) => {
                            root.set-habit-done(habit.id, root.day-numbers[w][i], done);
                        }
                    }
                }
            }

            // Right under the last habit, out of the way of the grid.
            if root.archived-count > 0: HorizontalLayout {
                alignment: start;
                padding-top: 8px;
                SubtleButton {
                    text: @tr("Archived ({})", root.archived-count);
                    clicked => {
                        root.open-archived();
                    }
                }
            }
        }
    }
}
