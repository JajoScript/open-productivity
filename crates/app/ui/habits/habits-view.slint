import { Date, Palette, ScrollView } from "std-widgets.slint";
import { EmptyState } from "../empty-state.slint";
import { InkButton } from "../ink-button.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { DayState, HabitCell } from "habit-cell.slint";
import { HabitPreview } from "habit-preview.slint";
import { HeatCell, HeatLevel, MonthMap, MonthTotal } from "month-summary.slint";

export { DayState, HeatCell, HeatLevel }

// A habit with its days of the month, in the same blocks of seven as `HabitsView.day-numbers`.
export struct HabitRow {
    id: int,
    name: string,
    streak: int,
    best: int,
    month-pct: int,
    // Monday first, and the day it starts: the editor's initial values.
    weekdays: [bool],
    start: Date,
    weeks: [[DayState]],
}

// Totals of one block of seven days, in the same blocks as `HabitsView.day-numbers`.
export struct WeekTotal {
    done: int,
    applicable: int,
    pct: int,
}

export struct ArchivedRow {
    id: int,
    name: string,
}

// The month of habits: title and month navigation, the button that opens the creator, and the grid.
export component HabitsView inherits VerticalLayout {
    in property <[HabitRow]> habits;
    // Day of the month per cell, in blocks of seven.
    in property <[[int]]> day-numbers;
    in property <[WeekTotal]> week-totals;
    in property <WeekTotal> month-total;
    // The month map in rows of seven, Monday first.
    in property <[[HeatCell]]> heat;
    in property <string> error;
    in property <int> archived-count;
    callback open-archived();
    // The month shown; only its month and year matter.
    in property <Date> month;
    // Day of the month that is today; 0 when another month is shown.
    in property <int> today-day;
    in property <bool> can-next;
    callback new-habit();
    callback edit-habit(HabitRow);
    // -1 / +1 moves a month; 0 goes back to the current one.
    callback shift(int);
    callback set-habit-done(int, int, bool);

    padding: 24px;
    padding-top: 20px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 4px;
        Text {
            text: @tr("Habits");
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        SubtleButton {
            icon: @image-url("../icons/chevron-left.svg");
            label: @tr("Previous month");
            clicked => {
                root.shift(-1);
            }
        }

        Text {
            text: Strings.month-year(root.month.month, root.month.year);
            vertical-alignment: center;
            horizontal-alignment: center;
            min-width: 120px;
        }

        SubtleButton {
            icon: @image-url("../icons/chevron-right.svg");
            label: @tr("Next month");
            opacity: root.can-next ? 1 : 0.35;
            clicked => {
                if root.can-next {
                    root.shift(1);
                }
            }
        }

        SubtleButton {
            text: @tr("Today");
            color: Palette.foreground;
            clicked => {
                root.shift(0);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // With no habits, the empty state carries this button.
        if root.habits.length > 0: InkButton {
            text: @tr("Add habit");
            clicked => {
                root.new-habit();
            }
        }
    }

    if root.error != "": Text {
        text: root.error;
        color: Theme.critical;
        wrap: word-wrap;
    }

    if root.habits.length == 0: EmptyState {
        title: @tr("No habits yet.");
        description: @tr("A habit is something you want to repeat on the days you choose. Mark each day on the monthly grid to build your streak and see your progress.");
        action: @tr("Add habit");
        clicked => {
            root.new-habit();
        }

        HabitPreview { }
    }

    // With no active habits the grid is gone, so the link sits under the empty state.
    if root.habits.length == 0 && root.archived-count > 0: HorizontalLayout {
        alignment: center;
        SubtleButton {
            text: @tr("Archived ({})", root.archived-count);
            clicked => {
                root.open-archived();
            }
        }
    }

    // Sizes follow the window: day cells stay at mouse size and the names take the spare
    // width, so the grid never scrolls sideways; a wide window moves the month summary aside.
    property <length> content-w: root.width - 48px;
    property <bool> wide: root.content-w >= 984px;
    // As wide as the month map: seven 18px cells and six 3px gaps.
    property <length> panel-w: 144px;
    // Room for the vertical scrollbar, so it never covers the last day.
    property <length> grid-w: (root.wide ? root.content-w - root.panel-w - 33px : root.content-w) - 16px;
    property <int> blocks: root.day-numbers.length;
    property <int> days: root.blocks == 0 ? 0 : (root.blocks - 1) * 7 + root.day-numbers[root.blocks - 1].length;
    property <length> gaps-w: root.blocks * 8px + (root.days - root.blocks) * 3px;
    property <length> cell: root.days == 0 ? 20px : max(18px, min(20px, Math.floor((root.grid-w - 112px - root.gaps-w) / root.days / 1px) * 1px));
    property <length> name-w: max(112px, min(240px, root.grid-w - root.gaps-w - root.days * root.cell));
    // What the grid really takes once the names hit their cap, so the panel follows it closely.
    property <length> used-w: root.name-w + root.gaps-w + root.days * root.cell;

    if root.habits.length > 0: scroll := ScrollView {
        content-width: self.visible-width;
        VerticalLayout {
            width: scroll.visible-width;
            spacing: 16px;
            alignment: start;

            // Narrow window: the month summary sits above the grid, total beside the map.
            if !root.wide: HorizontalLayout {
                spacing: 24px;
                alignment: start;
                MonthTotal {
                    width: 168px;
                    done: root.month-total.done;
                    applicable: root.month-total.applicable;
                    pct: root.month-total.pct;
                }

                MonthMap {
                    heat: root.heat;
                }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: start;

                VerticalLayout {
                    width: min(root.grid-w, root.used-w);
                    spacing: 6px;
                    alignment: start;

                    // Day numbers in blocks of seven, today on an ink plate.
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: root.name-w;
                        }

                        for week[w] in root.day-numbers: VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: Strings.week-label(w + 1);
                                color: Theme.muted;
                                font-size: 11px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 3px;
                                for day in week: Rectangle {
                                    width: root.cell;
                                    height: 20px;
                                    border-radius: 5px;
                                    background: day == root.today-day ? Theme.ink : transparent;
                                    Text {
                                        text: day;
                                        font-size: 11px;
                                        font-weight: day == root.today-day ? 700 : 400;
                                        color: day == root.today-day ? Theme.on-ink : Theme.muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Each block as "x/y z%" with its progress.
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: root.name-w;
                        }

                        for week[w] in root.week-totals: VerticalLayout {
                            // Room for the block's own width: the short last block only fits the share.
                            width: root.day-numbers[w].length * root.cell + (root.day-numbers[w].length - 1) * 3px;
                            spacing: 3px;
                            Text {
                                text: root.day-numbers[w].length < 4 ? Strings.percent(week.pct) : Strings.week-total(week.done, week.applicable, week.pct);
                                color: Theme.muted;
                                font-size: 11px;
                                overflow: elide;
                            }

                            Rectangle {
                                height: 3px;
                                border-radius: 1.5px;
                                background: Theme.hover;
                                clip: true;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * week.pct / 100;
                                    background: Theme.ink;
                                }
                            }
                        }
                    }

                    for habit in root.habits: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        // The name and stats block opens the editor.
                        Rectangle {
                            width: root.name-w;
                            border-radius: 6px;
                            background: name-touch.has-hover ? Theme.hover : transparent;
                            animate background { duration: Theme.fast; easing: Theme.ease-out; }
                            accessible-role: button;
                            accessible-label: habit.name;
                            accessible-action-default => {
                                root.edit-habit(habit);
                            }

                            VerticalLayout {
                                alignment: center;
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: habit.name;
                                    overflow: elide;
                                }

                                // The month's percentage stays visible; only the streaks elide.
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: Strings.habit-streaks(habit.streak, habit.best);
                                        color: Theme.muted;
                                        font-size: 11px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: Strings.percent(habit.month-pct);
                                        color: Theme.muted;
                                        font-size: 11px;
                                        horizontal-stretch: 0;
                                    }
                                }
                            }

                            name-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.edit-habit(habit);
                                }
                            }
                        }

                        for week[w] in habit.weeks: HorizontalLayout {
                            spacing: 3px;
                            for state[i] in week: HabitCell {
                                size: root.cell;
                                state: state;
                                today: root.day-numbers[w][i] == root.today-day;
                                label: habit.name + " " + Strings.date(root.day-numbers[w][i], root.month.month, root.month.year);
                                toggled(done) => {
                                    root.set-habit-done(habit.id, root.day-numbers[w][i], done);
                                }
                            }
                        }
                    }

                    // Right under the last habit, out of the way of the grid.
                    if root.archived-count > 0: HorizontalLayout {
                        alignment: start;
                        padding-top: 8px;
                        SubtleButton {
                            text: @tr("Archived ({})", root.archived-count);
                            clicked => {
                                root.open-archived();
                            }
                        }
                    }
                }

                // Wide window: the month summary is a side panel past a hairline.
                if root.wide: Rectangle {
                    width: 1px;
                    background: Theme.hairline;
                }

                if root.wide: VerticalLayout {
                    width: root.panel-w;
                    spacing: 16px;
                    alignment: start;
                    MonthTotal {
                        done: root.month-total.done;
                        applicable: root.month-total.applicable;
                        pct: root.month-total.pct;
                    }

                    MonthMap {
                        heat: root.heat;
                    }
                }
            }
        }
    }
}
