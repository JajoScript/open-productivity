import { Date, Palette } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { Calendar, InkDatePopup } from "../ink-date-popup.slint";
import { InkField } from "../ink-field.slint";
import { PopupSurface } from "../popup-surface.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";

// One weekday toggle: a letter in a square, labelled with the full day name.
component DayToggle inherits Rectangle {
    in property <string> letter;
    in property <string> label;
    in property <bool> on;
    callback toggled;

    width: 36px;
    height: 36px;
    border-radius: 6px;
    border-width: root.on ? 0px : 1px;
    border-color: Theme.hairline;
    background: root.on ? Theme.ink : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }
    forward-focus: focus;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => {
        root.toggled();
    }

    Text {
        text: root.letter;
        // Off reads as empty: muted, regular weight; on is an ink plate.
        color: root.on ? Theme.on-ink : Theme.muted;
        font-weight: root.on ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            reject
        }
    }

    // Keyboard focus ring.
    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}

// Rebuilt on every show(), so the fields, the error and the confirmation always start fresh.
component CreatorBody inherits FocusScope {
    in property <bool> editing;
    // Like the days and the date, the modal gives the initial name and the user edits it here.
    in-out property <string> habit-name;
    // Monday first. The modal gives the initial days and date; the user changes them here.
    in-out property <[bool]> days;
    in-out property <Date> start-date;
    callback save(string, [bool], Date) -> string;
    callback archive;
    callback cancel;

    property <string> error;
    property <bool> confirming;

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    function submit() {
        root.error = root.save(root.habit-name, root.days, root.start-date);
    }

    VerticalLayout {
        padding: 16px;
        // The collapsed date row would still add spacing around it while confirming.
        spacing: root.confirming ? 0px : 12px;

        if !root.confirming: VerticalLayout {
            spacing: 12px;
            Text {
                text: root.editing ? @tr("Edit habit") : @tr("New habit");
                font-size: 14px;
                font-weight: 700;
            }

            InkField {
                text <=> root.habit-name;
                placeholder-text: @tr("Habit name");
                init => {
                    self.focus();
                }
                accepted(text) => {
                    root.submit();
                }
            }

            Text {
                text: @tr("Repeat on");
                color: Theme.muted;
            }

            HorizontalLayout {
                spacing: 4px;
                for letter[i] in Strings.day-letters: DayToggle {
                    letter: letter;
                    label: Strings.weekday-name(i);
                    on: root.days[i];
                    toggled => {
                        root.days[i] = !root.days[i];
                    }
                }
            }

            Text {
                text: @tr("Starts on");
                color: Theme.muted;
            }
        }

        HorizontalLayout {
            visible: !root.confirming;
            // Always present, so the date popup can live here (a popup cannot be conditional).
            height: root.confirming ? 0px : 36px;
            alignment: start;
            picker := InkDatePopup {
                y: 36px;
                day: root.start-date.day;
                month: root.start-date.month;
                year: root.start-date.year;
                picked(date) => {
                    root.start-date = date;
                }
            }

            SubtleButton {
                text: Strings.date(root.start-date.day, root.start-date.month, root.start-date.year);
                icon: @image-url("../icons/calendar.svg");
                color: Palette.foreground;
                clicked => {
                    picker.show();
                }
            }
        }

        if !root.confirming: VerticalLayout {
            spacing: 12px;
            if root.error != "": Text {
                text: root.error;
                color: Theme.critical;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                if root.editing: SubtleButton {
                    icon: @image-url("../icons/archive.svg");
                    text: @tr("Archive habit");
                    color: Theme.critical;
                    clicked => {
                        root.confirming = true;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                SubtleButton {
                    text: @tr("Cancel");
                    color: Palette.foreground;
                    clicked => {
                        root.cancel();
                    }
                }

                InkButton {
                    text: root.editing ? @tr("Save") : @tr("Create");
                    clicked => {
                        root.submit();
                    }
                }
            }
        }

        if root.confirming: VerticalLayout {
            spacing: 12px;
            Text {
                text: @tr("Archive \"{}\"? It leaves the grid, but its history is kept.", root.habit-name);
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                SubtleButton {
                    text: @tr("Cancel");
                    color: Palette.foreground;
                    init => {
                        self.focus();
                    }
                    clicked => {
                        root.cancel();
                    }
                }

                InkButton {
                    text: @tr("Archive");
                    clicked => {
                        root.archive();
                    }
                }
            }
        }
    }
}

// Creates a habit or edits one, depending on how it is opened. Closing by clicking outside
// discards the changes.
export component HabitCreator inherits PopupWindow {
    // Return the error to show; empty means it worked and the modal closes.
    callback create(string, [bool], Date) -> string;
    callback update(int, string, [bool], Date) -> string;
    callback archive(int);

    // Set by the opener before show(): a new habit has days all off, so the user picks them.
    in property <bool> editing;
    in property <int> habit-id;
    in property <string> habit-name;
    in property <[bool]> days;
    in property <Date> start-date;

    close-policy: close-on-click-outside;
    width: 360px;

    PopupSurface {
        CreatorBody {
            editing: root.editing;
            habit-name: root.habit-name;
            days: root.days;
            start-date: root.start-date;
            save(name, days, start) => {
                let error = root.editing ? root.update(root.habit-id, name, days, start) : root.create(name, days, start);
                if error == "" {
                    root.close();
                }
                return error;
            }
            archive => {
                root.close();
                root.archive(root.habit-id);
            }
            cancel => {
                root.close();
            }
        }
    }
}
