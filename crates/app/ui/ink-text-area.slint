import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Multi-line text field in the monochrome system, the same look as InkField.
// Enter inserts a newline; Ctrl+Enter emits `submitted`.
export component InkTextArea {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    callback submitted;

    min-height: 96px;
    horizontal-stretch: 1;
    forward-focus: keys;

    frame := Rectangle {
        border-radius: 6px;
        background: input.has-focus ? Palette.background : touch.has-hover ? Theme.hover : Theme.field;
        border-width: 1px;
        border-color: input.has-focus ? Theme.ink : Theme.hairline;
        animate background, border-color { duration: Theme.fast; easing: Theme.ease-out; }
    }

    // Below the input: only shows the hover wash and the text cursor over the padding.
    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    if root.text == "": Text {
        x: 12px;
        y: 8px;
        width: root.width - 24px;
        text: root.placeholder-text;
        color: Theme.muted;
        overflow: elide;
        accessible-role: none;
    }

    keys := FocusScope {
        forward-focus: input;
        capture-key-pressed(event) => {
            if event.text == Key.Return && event.modifiers.control {
                root.submitted();
                return accept;
            }
            reject
        }

        flick := Flickable {
            x: 12px;
            y: 8px;
            width: root.width - 24px;
            height: root.height - 16px;

            input := TextInput {
                width: flick.width;
                height: max(flick.height, self.preferred-height);
                single-line: false;
                wrap: word-wrap;
                color: Palette.foreground;
                selection-background-color: Theme.selection;
                selection-foreground-color: Palette.foreground;
                accessible-label: root.placeholder-text;
                // Keep the cursor line inside the visible part.
                cursor-position-changed(pos) => {
                    if pos.y + flick.content-y < 0 {
                        flick.content-y = -pos.y;
                    } else if pos.y + 22px + flick.content-y > flick.height {
                        flick.content-y = flick.height - pos.y - 22px;
                    }
                }
            }
        }
    }
}
