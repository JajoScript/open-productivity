import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Primary action in the monochrome system: an ink plate instead of Fluent's accent fill.
export component InkButton {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;

    min-width: label.preferred-width + 32px + (root.icon.width > 0 ? 24px : 0px);
    min-height: 32px;
    horizontal-stretch: 0;
    opacity: root.enabled ? 1 : 0.4;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }

    plate := Rectangle {
        border-radius: 6px;
        background: Theme.ink;
        opacity: touch.pressed ? 0.78 : touch.has-hover ? 0.88 : 1;
        animate opacity { duration: Theme.fast; easing: Theme.ease-out; }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: Theme.on-ink;
            width: 16px;
            image-fit: contain;
            accessible-role: none;
        }

        label := Text {
            text: root.text;
            color: Theme.on-ink;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    // Offset ring so it stays visible against the ink plate.
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: 9px;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}
