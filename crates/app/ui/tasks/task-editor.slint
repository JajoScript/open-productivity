import { Palette } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { InkCheck } from "../ink-check.slint";
import { InkField } from "../ink-field.slint";
import { InkTextArea } from "../ink-text-area.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Strings } from "../strings.slint";
import { Theme } from "../theme.slint";

// Rebuilt on every show(), so the fields and the confirmation always start fresh.
component EditorBody inherits FocusScope {
    in property <string> title;
    in property <string> note;
    // Rebuilt on every show, so these start from the task and the checks only change them here.
    in-out property <bool> urgent;
    in-out property <bool> important;
    callback save(string, string, bool, bool) -> bool;
    callback delete;
    callback cancel;

    property <bool> confirming;
    property <bool> title-empty;

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        if !root.confirming: VerticalLayout {
            spacing: 12px;
            Text {
                text: @tr("Edit task");
                font-size: 14px;
                font-weight: 700;
            }

            title-field := InkField {
                text: root.title;
                placeholder-text: @tr("Task title");
                init => {
                    self.focus();
                }
                accepted(text) => {
                    title-empty = !root.save(text, note-field.text, root.urgent, root.important);
                }
            }

            if root.title-empty: Text {
                text: Strings.title-empty;
                color: Theme.critical;
            }

            note-field := InkTextArea {
                text: root.note;
                placeholder-text: @tr("Note");
                submitted => {
                    title-empty = !root.save(title-field.text, self.text, root.urgent, root.important);
                }
            }

            // Eisenhower marks.
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                InkCheck {
                    checked: root.urgent;
                    label: @tr("Urgent");
                    toggled(v) => {
                        root.urgent = v;
                    }
                }

                Text {
                    text: @tr("Urgent");
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Rectangle {
                    width: 12px;
                }

                InkCheck {
                    checked: root.important;
                    label: @tr("Important");
                    toggled(v) => {
                        root.important = v;
                    }
                }

                Text {
                    text: @tr("Important");
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                SubtleButton {
                    icon: @image-url("../icons/trash-2.svg");
                    text: @tr("Delete task");
                    color: Theme.critical;
                    clicked => {
                        root.confirming = true;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                SubtleButton {
                    text: @tr("Cancel");
                    color: Palette.foreground;
                    clicked => {
                        root.cancel();
                    }
                }

                InkButton {
                    text: @tr("Save");
                    clicked => {
                        title-empty = !root.save(title-field.text, note-field.text, root.urgent, root.important);
                    }
                }
            }
        }

        if root.confirming: VerticalLayout {
            spacing: 12px;
            Text {
                text: @tr("Delete \"{}\"? This can't be undone.", root.title);
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                SubtleButton {
                    text: @tr("Cancel");
                    color: Palette.foreground;
                    init => {
                        self.focus();
                    }
                    clicked => {
                        root.cancel();
                    }
                }

                SubtleButton {
                    icon: @image-url("../icons/trash-2.svg");
                    text: @tr("Delete");
                    color: Theme.critical;
                    clicked => {
                        root.delete();
                    }
                }
            }
        }
    }
}

// Edits one task. Closing by clicking outside discards the changes.
export component TaskEditor inherits PopupWindow {
    in property <int> task-id;
    in property <string> title;
    in property <string> note;
    in property <bool> urgent;
    in property <bool> important;
    // Returns false when the task was not saved; the editor then stays open.
    callback saved(int, string, string, bool, bool) -> bool;
    callback deleted(int);

    close-policy: close-on-click-outside;
    width: 440px;

    Rectangle {
        background: Palette.background;
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.14);
        border-radius: 6px;
        EditorBody {
            title: root.title;
            note: root.note;
            urgent: root.urgent;
            important: root.important;
            save(title, note, urgent, important) => {
                if root.saved(root.task-id, title, note, urgent, important) {
                    root.close();
                    return true;
                }
                false
            }
            delete => {
                root.close();
                root.deleted(root.task-id);
            }
            cancel => {
                root.close();
            }
        }
    }
}
