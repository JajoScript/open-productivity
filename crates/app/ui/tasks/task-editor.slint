import { Palette } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { InkCheck } from "../ink-check.slint";
import { InkField } from "../ink-field.slint";
import { InkTextArea } from "../ink-text-area.slint";
import { PopupSurface } from "../popup-surface.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Strings } from "../strings.slint";
import { Theme } from "../theme.slint";

// Rebuilt on every show(), so the fields and the confirmation always start fresh.
component EditorBody inherits FocusScope {
    in property <string> title;
    in property <string> note;
    // Rebuilt on every show, so these start from the task and the checks only change them here.
    in-out property <bool> urgent;
    in-out property <bool> important;
    in property <string> start-text;
    in property <string> end-text;
    // Times need a due date.
    in property <bool> has-date;
    // Returns the message to show, or an empty string when the task was saved.
    callback save(string, string, bool, bool, string, string) -> string;
    callback delete;
    callback cancel;

    property <bool> confirming;
    property <string> error;

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        if !root.confirming: VerticalLayout {
            spacing: 12px;
            Text {
                text: @tr("Edit task");
                font-size: 14px;
                font-weight: 700;
            }

            title-field := InkField {
                text: root.title;
                placeholder-text: @tr("Task title");
                init => {
                    self.focus();
                }
                accepted(text) => {
                    error = root.save(text, note-field.text, root.urgent, root.important, start-field.text, end-field.text);
                }
            }

            if root.error != "": Text {
                text: root.error;
                color: Theme.critical;
                wrap: word-wrap;
            }

            note-field := InkTextArea {
                text: root.note;
                placeholder-text: @tr("Note");
                submitted => {
                    error = root.save(title-field.text, self.text, root.urgent, root.important, start-field.text, end-field.text);
                }
            }

            // Optional local times of the due day.
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Start");
                    vertical-alignment: center;
                    accessible-role: none;
                }

                start-field := InkField {
                    text: root.start-text;
                    placeholder-text: @tr("HH:MM");
                    enabled: root.has-date;
                    accepted(text) => {
                        error = root.save(title-field.text, note-field.text, root.urgent, root.important, text, end-field.text);
                    }
                }

                Text {
                    text: @tr("End");
                    vertical-alignment: center;
                    accessible-role: none;
                }

                end-field := InkField {
                    text: root.end-text;
                    placeholder-text: @tr("HH:MM");
                    enabled: root.has-date;
                    accepted(text) => {
                        error = root.save(title-field.text, note-field.text, root.urgent, root.important, start-field.text, text);
                    }
                }
            }

            if !root.has-date: Text {
                text: @tr("Give the task a due date to set a time.");
                color: Theme.muted;
                font-size: 12px;
            }

            // Eisenhower marks.
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                InkCheck {
                    checked: root.urgent;
                    label: @tr("Urgent");
                    toggled(v) => {
                        root.urgent = v;
                    }
                }

                Text {
                    text: @tr("Urgent");
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Rectangle {
                    width: 12px;
                }

                InkCheck {
                    checked: root.important;
                    label: @tr("Important");
                    toggled(v) => {
                        root.important = v;
                    }
                }

                Text {
                    text: @tr("Important");
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                SubtleButton {
                    icon: @image-url("../icons/trash-2.svg");
                    text: @tr("Delete task");
                    color: Theme.critical;
                    clicked => {
                        root.confirming = true;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                SubtleButton {
                    text: @tr("Cancel");
                    color: Palette.foreground;
                    clicked => {
                        root.cancel();
                    }
                }

                InkButton {
                    text: @tr("Save");
                    clicked => {
                        error = root.save(title-field.text, note-field.text, root.urgent, root.important, start-field.text, end-field.text);
                    }
                }
            }
        }

        if root.confirming: VerticalLayout {
            spacing: 12px;
            Text {
                text: @tr("Delete \"{}\"? This can't be undone.", root.title);
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                SubtleButton {
                    text: @tr("Cancel");
                    color: Palette.foreground;
                    init => {
                        self.focus();
                    }
                    clicked => {
                        root.cancel();
                    }
                }

                InkButton {
                    text: @tr("Delete");
                    clicked => {
                        root.delete();
                    }
                }
            }
        }
    }
}

// Edits one task. Closing by clicking outside discards the changes.
export component TaskEditor inherits PopupWindow {
    in property <int> task-id;
    in property <string> title;
    in property <string> note;
    in property <bool> urgent;
    in property <bool> important;
    in property <string> start-text;
    in property <string> end-text;
    in property <bool> has-date;
    // Returns the error to show, empty when saved; the editor then stays open.
    callback saved(int, string, string, bool, bool, string, string) -> string;
    callback deleted(int);

    close-policy: close-on-click-outside;
    width: 440px;

    PopupSurface {
        EditorBody {
            title: root.title;
            note: root.note;
            urgent: root.urgent;
            important: root.important;
            start-text: root.start-text;
            end-text: root.end-text;
            has-date: root.has-date;
            save(title, note, urgent, important, start-t, end-t) => {
                let error = root.saved(root.task-id, title, note, urgent, important, start-t, end-t);
                if error == "" {
                    root.close();
                }
                error
            }
            delete => {
                root.close();
                root.deleted(root.task-id);
            }
            cancel => {
                root.close();
            }
        }
    }
}
