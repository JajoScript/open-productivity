import { Date, Palette } from "std-widgets.slint";
import { InkDatePopup } from "../ink-date-popup.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";

export enum DueKind { none, overdue, today, tomorrow, date }

// The date parts are the stored due date and only matter when kind != none.
export component DueButton inherits HorizontalLayout {
    in property <DueKind> kind;
    in property <int> day;
    in property <int> month;
    in property <int> year;
    callback picked(Date);
    callback cleared;

    spacing: 0px;
    // Fixed column (132px label + 28px "x" slot), so dates and the "x" line up across rows.
    width: 160px;
    alignment: start;

    // Right-aligned under the button: rows put it near the window's right edge.
    picker := InkDatePopup {
        x: root.width - self.width;
        y: root.height + 2px;
        day: root.kind == DueKind.none ? 0 : root.day;
        month: root.month;
        year: root.year;
        picked(date) => {
            root.picked(date);
        }
    }

    SubtleButton {
        width: 132px;
        text: root.kind == DueKind.none ? @tr("Add date") : root.kind == DueKind.overdue ? @tr("Overdue") : root.kind == DueKind.today ? @tr("Today") : root.kind == DueKind.tomorrow ? @tr("Tomorrow") : Strings.date(root.day, root.month, root.year);
        icon: @image-url("../icons/calendar.svg");
        color: root.kind == DueKind.overdue ? Theme.critical : root.kind == DueKind.today ? Palette.foreground : Theme.muted;
        clicked => {
            picker.show();
        }
    }

    // The slot stays reserved without a date.
    Rectangle {
        width: 28px;
        if root.kind != DueKind.none: SubtleButton {
            icon: @image-url("../icons/x.svg");
            label: @tr("Remove date");
            clicked => {
                root.cleared();
            }
        }
    }
}
