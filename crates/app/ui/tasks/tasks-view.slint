import { Date, Palette } from "std-widgets.slint";
import { ListEntry } from "../list-entry.slint";
import { Theme } from "../theme.slint";
import { ListsPanel, ViewCounts } from "lists-panel.slint";
import { DueKind, TaskColumn, TaskRow, TaskView } from "task-column.slint";
export { DueKind, TaskRow, TaskView, ViewCounts }

// One per built tab; Week, Kanban and Eisenhower join when their slices ship.
export enum TasksTab { today, lists }

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 40px;
    forward-focus: focus;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-weight: root.selected ? 600 : 400;
            color: root.selected || touch.has-hover ? Palette.foreground : Theme.muted;
            accessible-role: none;
        }
    }

    // Ink underline marks the open tab.
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.selected ? Theme.ink : transparent;
        animate background { duration: Theme.fast; easing: Theme.ease-out; }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: 4px;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}

// The Tasks module: tabs on top; the Lists tab adds the lists panel beside the tasks.
export component TasksView inherits VerticalLayout {
    // Kept by the window, so it survives a trip to Settings.
    in-out property <TasksTab> tab;
    in property <string> instance-name;
    in property <TaskView> view;
    in property <bool> can-create;
    in property <[TaskRow]> tasks;
    in property <string> error;
    in property <int> list-id;
    in property <string> list-name;
    in property <[ListEntry]> lists;
    in property <ViewCounts> counts;
    callback select-view(TaskView);
    callback select-list(int);
    callback new-list;
    callback create-task(string);
    callback set-done(int, bool);
    callback set-due(int, Date);
    callback clear-due(int);
    callback set-list(int, int);
    callback delete-list(int);
    callback update-task(int, string, string) -> bool;
    callback delete-task(int);

    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 8px;
        HorizontalLayout {
            spacing: 16px;
            // The open instance, so the user always knows which data they are looking at.
            Text {
                text: root.instance-name;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Tab {
                text: @tr("Today");
                selected: root.tab == TasksTab.today;
                clicked => {
                    root.tab = TasksTab.today;
                    root.select-view(TaskView.today);
                }
            }

            Tab {
                text: @tr("Lists");
                selected: root.tab == TasksTab.lists;
                clicked => {
                    root.tab = TasksTab.lists;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        if root.tab == TasksTab.lists: ListsPanel {
            width: 264px;
            padding-left: 24px;
            padding-top: 20px;
            padding-bottom: 24px;
            view: root.view;
            list-id: root.list-id;
            counts: root.counts;
            lists: root.lists;
            select-view(v) => {
                root.select-view(v);
            }
            select-list(id) => {
                root.select-list(id);
            }
            new-list => {
                root.new-list();
            }
        }

        TaskColumn {
            view: root.view;
            can-create: root.can-create;
            tasks: root.tasks;
            error: root.error;
            list-id: root.list-id;
            list-name: root.list-name;
            lists: root.lists;
            create-task(title) => {
                root.create-task(title);
            }
            set-done(id, done) => {
                root.set-done(id, done);
            }
            set-due(id, date) => {
                root.set-due(id, date);
            }
            clear-due(id) => {
                root.clear-due(id);
            }
            set-list(id, list-id) => {
                root.set-list(id, list-id);
            }
            delete-list(id) => {
                root.delete-list(id);
            }
            update-task(id, title, note) => {
                return root.update-task(id, title, note);
            }
            delete-task(id) => {
                root.delete-task(id);
            }
        }
    }
}
