import { Date, Palette } from "std-widgets.slint";
import { ListEntry } from "../list-entry.slint";
import { Strings } from "../strings.slint";
import { Theme } from "../theme.slint";
import { ListsPanel, ViewCounts } from "lists-panel.slint";
import { DueKind, TaskColumn, TaskRow, TaskView } from "task-column.slint";
import { WeekDay, WeekView } from "week-view.slint";
import { KanbanColumn, KanbanView, Stage } from "kanban-view.slint";
import { MatrixView, Quadrant } from "matrix-view.slint";
export { DueKind, KanbanColumn, Quadrant, Stage, TaskRow, TaskView, ViewCounts, WeekDay }

// One per tab of the Tasks module.
export enum TasksTab { today, week, lists, kanban, eisenhower }

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 40px;
    forward-focus: focus;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-weight: root.selected ? 600 : 400;
            color: root.selected || touch.has-hover ? Palette.foreground : Theme.muted;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: 6px;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}

// The Tasks module: tabs on top; the Lists tab adds the lists panel beside the tasks.
export component TasksView inherits VerticalLayout {
    // Kept by the window, so it survives a trip to Settings.
    in-out property <TasksTab> tab;
    in property <string> instance-name;
    in property <TaskView> view;
    in property <bool> can-create;
    in property <int> pending-count;
    in property <int> done-count;
    in property <Date> today;
    // 0 is Monday.
    in property <int> today-weekday;
    in property <[TaskRow]> tasks;
    in property <string> error;
    in property <int> list-id;
    in property <string> list-name;
    in property <[ListEntry]> lists;
    in property <ViewCounts> counts;
    callback select-view(TaskView);
    callback select-list(int);
    callback new-list;
    callback create-task(string);
    callback set-done(int, bool);
    callback set-due(int, Date);
    callback clear-due(int);
    callback set-list(int, int);
    callback delete-list(int);
    callback update-task(int, string, string, bool, bool) -> bool;
    callback delete-task(int);
    // Tells the app which tab is open, so it loads only what that tab shows.
    callback select-tab(TasksTab);
    in property <[WeekDay]> week-days;
    callback week-shift(int);
    in property <[KanbanColumn]> kanban-columns;
    in property <[Quadrant]> quadrants;
    callback set-priority(int, bool, bool);
    callback move-task(int, Stage);
    pure callback task-payload(int) -> data-transfer;
    pure callback payload-task(data-transfer) -> int;

    function pick(t: TasksTab) {
        root.tab = t;
        root.select-tab(t);
    }

    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 8px;
        // One ink underline that slides to the open tab, so the eye follows the switch.
        Rectangle {
            height: 40px;
            HorizontalLayout {
                spacing: 16px;
                Text {
                    text: Strings.long-date(root.today.day, root.today.month, root.today-weekday);
                    font-weight: 700;
                    vertical-alignment: center;
                }

                // The open instance, so the user always knows which data they are looking at.
                Text {
                    text: root.instance-name;
                    color: Theme.muted;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                today-tab := Tab {
                    text: @tr("Today");
                    selected: root.tab == TasksTab.today;
                    clicked => {
                        root.pick(TasksTab.today);
                    }
                }

                week-tab := Tab {
                    text: @tr("Week");
                    selected: root.tab == TasksTab.week;
                    clicked => {
                        root.pick(TasksTab.week);
                    }
                }

                lists-tab := Tab {
                    text: @tr("Lists");
                    selected: root.tab == TasksTab.lists;
                    clicked => {
                        root.pick(TasksTab.lists);
                    }
                }

                kanban-tab := Tab {
                    text: @tr("Kanban");
                    selected: root.tab == TasksTab.kanban;
                    clicked => {
                        root.pick(TasksTab.kanban);
                    }
                }
                eisenhower-tab := Tab {
                    text: @tr("Eisenhower");
                    selected: root.tab == TasksTab.eisenhower;
                    clicked => {
                        root.pick(TasksTab.eisenhower);
                    }
                }
            }

            Rectangle {
                x: root.tab == TasksTab.today ? today-tab.x : root.tab == TasksTab.week ? week-tab.x : root.tab == TasksTab.lists ? lists-tab.x : root.tab == TasksTab.kanban ? kanban-tab.x : eisenhower-tab.x;
                width: root.tab == TasksTab.today ? today-tab.width : root.tab == TasksTab.week ? week-tab.width : root.tab == TasksTab.lists ? lists-tab.width : root.tab == TasksTab.kanban ? kanban-tab.width : eisenhower-tab.width;
                y: parent.height - 2px;
                height: 2px;
                background: Theme.ink;
                animate x, width { duration: Theme.enter; easing: Theme.ease-out; }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }
    }

    if root.tab == TasksTab.week: WeekView {
        vertical-stretch: 1;
        days: root.week-days;
        shift(n) => {
            root.week-shift(n);
        }
        set-done(id, done) => {
            root.set-done(id, done);
        }
        update-task(id, title, note, urgent, important) => {
            return root.update-task(id, title, note, urgent, important);
        }
        delete-task(id) => {
            root.delete-task(id);
        }
    }

    if root.tab == TasksTab.kanban: KanbanView {
        vertical-stretch: 1;
        columns: root.kanban-columns;
        set-done(id, done) => {
            root.set-done(id, done);
        }
        move-task(id, s) => {
            root.move-task(id, s);
        }
        task-payload(id) => {
            return root.task-payload(id);
        }
        payload-task(data) => {
            return root.payload-task(data);
        }
        update-task(id, title, note, urgent, important) => {
            return root.update-task(id, title, note, urgent, important);
        }
        delete-task(id) => {
            root.delete-task(id);
        }
    }

    if root.tab == TasksTab.eisenhower: MatrixView {
        vertical-stretch: 1;
        quadrants: root.quadrants;
        set-done(id, done) => {
            root.set-done(id, done);
        }
        set-priority(id, urgent, important) => {
            root.set-priority(id, urgent, important);
        }
        update-task(id, title, note, urgent, important) => {
            return root.update-task(id, title, note, urgent, important);
        }
        delete-task(id) => {
            root.delete-task(id);
        }
        task-payload(id) => {
            return root.task-payload(id);
        }
        payload-task(data) => {
            return root.payload-task(data);
        }
    }
    if root.tab == TasksTab.today || root.tab == TasksTab.lists: HorizontalLayout {
        vertical-stretch: 1;
        if root.tab == TasksTab.lists: ListsPanel {
            width: 264px;
            padding-left: 24px;
            padding-top: 20px;
            padding-bottom: 24px;
            view: root.view;
            list-id: root.list-id;
            counts: root.counts;
            lists: root.lists;
            select-view(v) => {
                root.select-view(v);
            }
            select-list(id) => {
                root.select-list(id);
            }
            new-list => {
                root.new-list();
            }
        }

        TaskColumn {
            view: root.view;
            can-create: root.can-create;
            pending-count: root.pending-count;
            done-count: root.done-count;
            tasks: root.tasks;
            error: root.error;
            list-id: root.list-id;
            list-name: root.list-name;
            lists: root.lists;
            create-task(title) => {
                root.create-task(title);
            }
            set-done(id, done) => {
                root.set-done(id, done);
            }
            set-due(id, date) => {
                root.set-due(id, date);
            }
            clear-due(id) => {
                root.clear-due(id);
            }
            set-list(id, list-id) => {
                root.set-list(id, list-id);
            }
            delete-list(id) => {
                root.delete-list(id);
            }
            update-task(id, title, note, urgent, important) => {
                return root.update-task(id, title, note, urgent, important);
            }
            delete-task(id) => {
                root.delete-task(id);
            }
        }
    }
}
