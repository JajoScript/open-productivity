import { ListView } from "std-widgets.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { DragBoard, TaskCard } from "drag-board.slint";
import { TaskRow } from "task-column.slint";
import { TaskEditor } from "task-editor.slint";

export enum Stage { icebox, in-progress, done }

export struct KanbanColumn {
    stage: Stage,
    tasks: [TaskRow],
}

// Icebox, In progress and Completed (last 7 days), side by side. Cards are dragged between
// columns; their arrows do the same from the keyboard.
export component KanbanView inherits DragBoard {
    in property <[KanbanColumn]> columns;
    callback set-done(int, bool);
    callback move-task(int, Stage);
    callback update-task(int, string, string, bool, bool) -> bool;
    callback delete-task(int);

    property <TaskRow> editing;

    editor := TaskEditor {
        x: (root.width - self.width) / 2;
        y: 72px;
        task-id: root.editing.id;
        title: root.editing.title;
        note: root.editing.note;
        urgent: root.editing.urgent;
        important: root.editing.important;
        saved(id, title, note, urgent, important) => {
            return root.update-task(id, title, note, urgent, important);
        }
        deleted(id) => {
            root.delete-task(id);
        }
    }

    HorizontalLayout {
        padding: 24px;
        padding-top: 20px;
        spacing: 12px;

        for col in root.columns: Rectangle {
            // Equal columns whatever their content.
            preferred-width: 0px;
            horizontal-stretch: 1;
            border-radius: 6px;
            // Lit while a task is dragged over it.
            background: drop.has-drag ? Theme.selected : Theme.field;
            animate background { duration: Theme.fast; easing: Theme.ease-out; }

            drop := DropArea {
                // Only our own task cards; text dragged from other apps is refused.
                can-drop(event) => {
                    root.follow(self.absolute-position, event.position, event.data) ? DragAction.move : DragAction.none
                }
                dropped(event) => {
                    root.move-task(root.land(event.data), col.stage);
                    return event.proposed-action;
                }

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 8px;
                        height: 28px;
                        Text {
                            text: col.stage == Stage.icebox ? @tr("Icebox") : col.stage == Stage.in-progress ? @tr("In progress") : @tr("Completed");
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: col.tasks.length;
                            color: Theme.muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    ListView {
                        for t in col.tasks: VerticalLayout {
                            padding-bottom: 6px;
                            TaskCard {
                                task: t;
                                payload: root.task-payload(t.id);
                                changed dragging => {
                                    root.card-dragging(self.dragging, t, self.absolute-position, self.width, { x: self.grab-x, y: self.grab-y });
                                }
                                toggled(done) => {
                                    root.set-done(t.id, done);
                                }
                                opened => {
                                    root.editing = t;
                                    editor.show();
                                }

                                if col.stage != Stage.icebox: SubtleButton {
                                    icon: @image-url("../icons/chevron-left.svg");
                                    label: col.stage == Stage.done ? @tr("Move to In progress") : @tr("Move to Icebox");
                                    clicked => {
                                        root.move-task(t.id, col.stage == Stage.done ? Stage.in-progress : Stage.icebox);
                                    }
                                }

                                if col.stage != Stage.done: SubtleButton {
                                    icon: @image-url("../icons/chevron-right.svg");
                                    label: col.stage == Stage.icebox ? @tr("Move to In progress") : @tr("Move to Completed");
                                    clicked => {
                                        root.move-task(t.id, col.stage == Stage.icebox ? Stage.in-progress : Stage.done);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
