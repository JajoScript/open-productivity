import { ListView, Palette } from "std-widgets.slint";
import { InkCheck } from "../ink-check.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { DueKind, TaskRow } from "task-column.slint";
import { TaskEditor } from "task-editor.slint";

export enum Stage { icebox, in-progress, done }

export struct KanbanColumn {
    stage: Stage,
    tasks: [TaskRow],
}

// A task card: checkbox, title (opens the editor) and arrows to the neighbouring columns.
// It can also be dragged onto another column; the arrows stay for keyboard users.
component Card inherits Rectangle {
    in property <TaskRow> task;
    in property <Stage> stage;
    // What a drop receives; built by the app so foreign drags can be told apart.
    in property <data-transfer> payload;
    callback toggled(bool);
    callback opened;
    callback moved(Stage);
    // For the board's floating copy: whether this card is in flight and where it was grabbed.
    out property <bool> dragging: drag.dragging;
    out property <length> grab-x: touch.pressed-x;
    out property <length> grab-y: touch.pressed-y;

    height: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.hairline;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Palette.background;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }
    // The card stays put and fades while it is being dragged.
    opacity: drag.dragging ? 0.4 : 1;

    // A click still reaches the children; only a press-and-move starts a drag.
    drag := DragArea {
        allow-move: true;
        data: root.payload;

        touch := TouchArea {
            clicked => {
                root.opened();
            }
        }

        HorizontalLayout {
            padding-right: 4px;
            InkCheck {
                checked: root.task.done;
                label: root.task.title;
                toggled(done) => {
                    root.toggled(done);
                }
            }

            Text {
                text: root.task.title;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                color: root.task.done ? Palette.foreground.with-alpha(0.45) : root.task.due-kind == DueKind.overdue ? Theme.critical : Palette.foreground;
                accessible-role: none;
            }

            if root.stage != Stage.icebox: SubtleButton {
                icon: @image-url("../icons/chevron-left.svg");
                label: root.stage == Stage.done ? @tr("Move to In progress") : @tr("Move to Icebox");
                clicked => {
                    root.moved(root.stage == Stage.done ? Stage.in-progress : Stage.icebox);
                }
            }

            if root.stage != Stage.done: SubtleButton {
                icon: @image-url("../icons/chevron-right.svg");
                label: root.stage == Stage.icebox ? @tr("Move to In progress") : @tr("Move to Completed");
                clicked => {
                    root.moved(root.stage == Stage.icebox ? Stage.in-progress : Stage.done);
                }
            }
        }
    }
}


// Icebox, In progress and Completed (last 7 days), side by side.
// While a card is dragged, a floating copy of it follows the cursor over the board.
export component KanbanView inherits Rectangle {
    in property <[KanbanColumn]> columns;
    callback set-done(int, bool);
    callback move-task(int, Stage);
    callback update-task(int, string, string) -> bool;
    callback delete-task(int);
    // Drag payload of a task, and the task id a payload carries (0 when it is not ours).
    pure callback task-payload(int) -> data-transfer;
    pure callback payload-task(data-transfer) -> int;

    property <TaskRow> editing;

    // The floating copy: which task, its size, and where its top-left corner is on the board.
    property <bool> ghosting;
    property <TaskRow> ghost-task;
    property <length> ghost-width;
    property <length> ghost-x;
    property <length> ghost-y;
    // Where the card was grabbed, so the copy keeps that point under the cursor.
    property <length> grab-x;
    property <length> grab-y;

    // Follows the cursor; `area` is the DropArea reporting `pos` in its own coordinates.
    function follow(area-x: length, area-y: length, pos: Point) {
        root.ghost-x = area-x - root.absolute-position.x + pos.x - root.grab-x;
        root.ghost-y = area-y - root.absolute-position.y + pos.y - root.grab-y;
    }

    editor := TaskEditor {
        x: (root.width - self.width) / 2;
        y: 72px;
        task-id: root.editing.id;
        title: root.editing.title;
        note: root.editing.note;
        saved(id, title, note) => {
            return root.update-task(id, title, note);
        }
        deleted(id) => {
            root.delete-task(id);
        }
    }

    HorizontalLayout {
        padding: 24px;
        padding-top: 20px;
        spacing: 12px;

        for col in root.columns: Rectangle {
            // Equal columns whatever their content.
            preferred-width: 0px;
            horizontal-stretch: 1;
            border-radius: 6px;
            // Lit while a task is dragged over it.
            background: drop.has-drag ? Theme.selected : Theme.field;
            animate background { duration: Theme.fast; easing: Theme.ease-out; }

            drop := DropArea {
                // Only our own task cards; text dragged from other apps is refused.
                can-drop(event) => {
                    root.follow(self.absolute-position.x, self.absolute-position.y, event.position);
                    root.payload-task(event.data) > 0 ? DragAction.move : DragAction.none
                }
                dropped(event) => {
                    root.ghosting = false;
                    root.move-task(root.payload-task(event.data), col.stage);
                    return event.proposed-action;
                }

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 8px;
                        height: 28px;
                        Text {
                            text: col.stage == Stage.icebox ? @tr("Icebox") : col.stage == Stage.in-progress ? @tr("In progress") : @tr("Completed");
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: col.tasks.length;
                            color: Theme.muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    ListView {
                        for t in col.tasks: VerticalLayout {
                            padding-bottom: 6px;
                            Card {
                                task: t;
                                stage: col.stage;
                                payload: root.task-payload(t.id);
                                changed dragging => {
                                    if self.dragging {
                                        root.ghost-task = t;
                                        root.ghost-width = self.width;
                                        root.grab-x = self.grab-x;
                                        root.grab-y = self.grab-y;
                                        root.ghost-x = self.absolute-position.x - root.absolute-position.x;
                                        root.ghost-y = self.absolute-position.y - root.absolute-position.y;
                                    }
                                    root.ghosting = self.dragging;
                                }
                                toggled(done) => {
                                    root.set-done(t.id, done);
                                }
                                opened => {
                                    root.editing = t;
                                    editor.show();
                                }
                                moved(s) => {
                                    root.move-task(t.id, s);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // The floating copy: the card's silhouette, above the columns. It handles no input,
    // so the drop still reaches the column under the cursor.
    if root.ghosting: ghost := Rectangle {
        x: root.ghost-x;
        y: root.ghost-y;
        width: root.ghost-width;
        height: 40px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.25);
        background: Palette.background;
        opacity: 0.92;
        accessible-role: none;

        HorizontalLayout {
            padding-left: 7px;
            padding-right: 10px;
            spacing: 14px;
            alignment: start;
            Rectangle {
                width: 18px;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 5px;
                    border-width: 1.5px;
                    border-color: Theme.muted;
                }
            }

            Text {
                text: root.ghost-task.title;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
        }
    }
}