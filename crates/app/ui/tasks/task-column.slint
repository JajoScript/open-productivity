import { Button, Date, ListView, Palette } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { InkCheck } from "../ink-check.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { ListEntry } from "../list-entry.slint";
import { DueButton, DueKind } from "due-button.slint";
import { ListButton } from "list-button.slint";
import { TaskEditor } from "task-editor.slint";
export { DueKind }

export enum TaskView { today, scheduled, inbox, overdue, all, list }

export struct TaskRow {
    id: int,
    title: string,
    note: string,
    done: bool,
    due-kind: DueKind,
    due-day: int,
    due-month: int,
    due-year: int,
    list-name: string,
    urgent: bool,
    important: bool,
    // From core (`first_done`): this row opens the "Completed" section.
    first-done: bool,
}

// Row-shaped field for a new task: an empty box where the checkbox goes, no frame.
component AddRow inherits Rectangle {
    callback accepted(string);

    height: 40px;
    border-radius: 6px;
    background: input.has-focus ? transparent : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 10px;
        spacing: 4px;
        Rectangle {
            width: 32px;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 5px;
                border-width: 1.5px;
                border-color: Theme.hairline;
            }
        }

        Rectangle {
            if input.text == "": Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                text: @tr("Add task…");
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }

            input := TextInput {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Palette.foreground;
                selection-background-color: Theme.selection;
                selection-foreground-color: Palette.foreground;
                accessible-label: @tr("Add task…");
                accepted => {
                    root.accepted(self.text);
                    self.text = "";
                }
            }
        }
    }
}

// One task: checkbox, title (opens the editor), note mark, list and due date.
component TaskLine inherits Rectangle {
    in property <TaskRow> task;
    in property <[ListEntry]> lists;
    callback toggled(bool);
    callback opened;
    callback list-picked(int);
    callback due-picked(Date);
    callback due-cleared;

    height: 40px;
    border-radius: 6px;
    background: row-touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }

    // Under the controls, so it only tracks hover for the row highlight.
    row-touch := TouchArea { }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 4px;
        InkCheck {
            checked: root.task.done;
            label: root.task.title;
            toggled(done) => {
                root.toggled(done);
            }
        }

        // Plain text with a wash on hover; opens the editor.
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: title-touch.pressed ? Theme.pressed : title-touch.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.fast; easing: Theme.ease-out; }
            forward-focus: title-focus;
            accessible-role: button;
            accessible-label: root.task.title;
            accessible-action-default => {
                root.opened();
            }

            Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                text: root.task.title;
                vertical-alignment: center;
                overflow: elide;
                color: root.task.done ? Palette.foreground.with-alpha(0.45) : Palette.foreground;
                animate color { duration: Theme.fast; easing: Theme.ease-out; }
                accessible-role: none;
            }

            title-touch := TouchArea {
                clicked => {
                    root.opened();
                }
            }

            title-focus := FocusScope {
                width: 0px; // keyboard only; clicks go to the TouchArea
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        root.opened();
                        return accept;
                    }
                    reject
                }
            }

            if title-focus.has-focus: Rectangle {
                border-radius: 5px;
                border-width: 2px;
                border-color: Palette.foreground;
            }
        }

        // The slot stays reserved so the list column lines up across rows.
        Rectangle {
            width: 16px;
            if root.task.note != "": Image {
                source: @image-url("../icons/notebook-text.svg");
                colorize: Theme.muted;
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                accessible-role: image;
                accessible-label: @tr("Has a note");
            }
        }

        ListButton {
            name: root.task.list-name;
            lists: root.lists;
            picked(list-id) => {
                root.list-picked(list-id);
            }
        }

        DueButton {
            kind: root.task.due-kind;
            day: root.task.due-day;
            month: root.task.due-month;
            year: root.task.due-year;
            picked(date) => {
                root.due-picked(date);
            }
            cleared => {
                root.due-cleared();
            }
        }
    }
}
// The tasks of one view: title, new task field and the rows.
export component TaskColumn inherits VerticalLayout {
    in property <TaskView> view;
    // From core (`View::can_create`): whether the view takes new tasks.
    in property <bool> can-create;
    in property <int> pending-count;
    in property <int> done-count;
    in property <[TaskRow]> tasks;
    in property <string> error;
    in property <int> list-id;
    in property <string> list-name;
    in property <[ListEntry]> lists;
    callback create-task(string);
    callback set-done(int, bool);
    callback set-due(int, Date);
    callback clear-due(int);
    callback set-list(int, int);
    callback delete-list(int);
    callback update-task(int, string, string, bool, bool) -> bool;
    callback delete-task(int);

    // The task the editor shows; set before it opens.
    property <TaskRow> editing;

    function open-editor(row: TaskRow) {
        root.editing = row;
        editor.show();
    }

    padding: 24px;
    padding-top: 20px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.view == TaskView.today ? @tr("Today") : root.view == TaskView.scheduled ? @tr("Scheduled") : root.view == TaskView.inbox ? @tr("Inbox") : root.view == TaskView.overdue ? @tr("smart list" => "Overdue") : root.view == TaskView.all ? @tr("All") : root.list-name;
            font-size: 24px;
            font-weight: 700;
            overflow: elide;
        }

        Text {
            text: @tr("{n} pending" | "{n} pending" % root.pending-count);
            color: Theme.muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.view == TaskView.list: SubtleButton {
            icon: @image-url("../icons/trash-2.svg");
            label: @tr("Delete list");
            clicked => {
                confirm.show();
            }
        }
    }

    confirm := PopupWindow {
        x: root.width - 380px;
        y: 56px;
        width: 360px;
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.foreground.with-alpha(0.14);
            border-radius: 6px;
            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    text: @tr("Delete the list \"{}\"? Its tasks will be kept without a list.", root.list-name);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: @tr("Cancel");
                        clicked => {
                            confirm.close();
                        }
                    }

                    InkButton {
                        text: @tr("Delete");
                        clicked => {
                            confirm.close();
                            root.delete-list(root.list-id);
                        }
                    }
                }
            }
        }
    }

    if root.can-create: AddRow {
        accepted(text) => {
            root.create-task(text);
        }
    }

    editor := TaskEditor {
        // Fixed spot under the input row, so it never runs off the bottom for low rows.
        x: (root.width - self.width) / 2;
        y: 72px;
        task-id: root.editing.id;
        title: root.editing.title;
        note: root.editing.note;
        urgent: root.editing.urgent;
        important: root.editing.important;
        saved(id, title, note, urgent, important) => {
            return root.update-task(id, title, note, urgent, important);
        }
        deleted(id) => {
            root.delete-task(id);
        }
    }

    if root.error != "": Text {
        text: root.error;
        color: Theme.critical;
        wrap: word-wrap;
    }

    if root.tasks.length == 0: Text {
        text: root.view == TaskView.today ? @tr("Nothing due today.") : root.view == TaskView.scheduled ? @tr("Nothing scheduled.") : root.view == TaskView.inbox ? @tr("The inbox is empty.") : root.view == TaskView.overdue ? @tr("Nothing overdue.") : root.view == TaskView.all ? @tr("No tasks yet. Add your first one above.") : @tr("This list is empty.");
        color: Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }

    if root.tasks.length > 0: ListView {
        for row in root.tasks: VerticalLayout {
            if row.first-done: Text {
                text: @tr("COMPLETED · {}", root.done-count);
                font-size: 12px;
                font-weight: 600;
                color: Theme.muted;
                height: 36px;
                vertical-alignment: bottom;
            }

            TaskLine {
                task: row;
                lists: root.lists;
                toggled(done) => {
                    root.set-done(row.id, done);
                }
                opened => {
                    root.open-editor(row);
                }
                list-picked(list-id) => {
                    root.set-list(row.id, list-id);
                }
                due-picked(date) => {
                    root.set-due(row.id, date);
                }
                due-cleared => {
                    root.clear-due(row.id);
                }
            }
        }
    }
}