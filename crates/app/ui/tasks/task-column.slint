import { Date, ListView, Palette } from "std-widgets.slint";
import { TaskCreator } from "task-creator.slint";
import { TaskPreview } from "task-preview.slint";
import { EmptyState } from "../empty-state.slint";
import { InkButton } from "../ink-button.slint";
import { InkCheck } from "../ink-check.slint";
import { PopupSurface } from "../popup-surface.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Strings } from "../strings.slint";
import { Theme } from "../theme.slint";
import { ListEntry } from "../list-entry.slint";
import { DueKind } from "due-button.slint";
import { TaskLine, TaskRow, TaskView } from "task-line.slint";
import { Repeat, TaskEditor } from "task-editor.slint";
export { DueKind, TaskRow, TaskView }

// A habit that applies today.
export struct DayHabit {
    id: int,
    name: string,
    done: bool,
}

// The tasks of one view: title, the button that opens the creator, and the rows.
export component TaskColumn inherits VerticalLayout {
    in property <TaskView> view;
    in property <Date> today;
    // 0 is Monday.
    in property <int> today-weekday;
    // From core (`View::can_create`): whether the view takes new tasks.
    in property <bool> can-create;
    in property <int> pending-count;
    in property <int> done-count;
    in property <[TaskRow]> tasks;
    in property <string> error;
    in property <int> list-id;
    in property <string> list-name;
    in property <[ListEntry]> lists;
    callback create-task(string) -> string;
    callback set-done(int, bool);
    callback set-due(int, Date);
    callback clear-due(int);
    callback set-list(int, int);
    callback delete-list(int);
    callback update-task(int, string, string, bool, bool, string, string, Repeat, string) -> string;
    callback delete-task(int);
    // Today's habits; only the Today tab passes any.
    in property <[DayHabit]> day-habits;
    in property <int> habits-done;
    callback set-habit-done(int, bool);

    // The task the editor shows; set before it opens.
    property <TaskRow> editing;

    function open-editor(row: TaskRow) {
        root.editing = row;
        editor.show();
    }

    padding: 24px;
    padding-top: 20px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.view == TaskView.today ? @tr("Today") : root.view == TaskView.scheduled ? @tr("Scheduled") : root.view == TaskView.inbox ? @tr("Inbox") : root.view == TaskView.overdue ? @tr("smart list" => "Overdue") : root.view == TaskView.all ? @tr("All") : root.list-name;
            font-size: 24px;
            font-weight: 700;
            overflow: elide;
        }

        if root.view == TaskView.today: Text {
            text: Strings.long-date(root.today.day, root.today.month, root.today-weekday);
            color: Theme.muted;
            vertical-alignment: center;
        }

        // Beside the habits, the section labels already carry the count.
        if root.day-habits.length == 0: Text {
            text: @tr("{n} pending" | "{n} pending" % root.pending-count);
            color: Theme.muted;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.view == TaskView.list: SubtleButton {
            icon: @image-url("../icons/trash-2.svg");
            label: @tr("Delete list");
            clicked => {
                confirm.show();
            }
        }

        // With no tasks, the empty state carries this button.
        if root.can-create && root.tasks.length > 0: InkButton {
            text: @tr("Add task");
            clicked => {
                creator.show();
            }
        }
    }

    creator := TaskCreator {
        x: (root.width - self.width) / 2;
        y: 72px;
        create(title) => {
            return root.create-task(title);
        }
    }

    confirm := PopupWindow {
        x: root.width - 380px;
        y: 56px;
        width: 360px;
        PopupSurface {
            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    text: @tr("Delete the list \"{}\"? Its tasks will be kept without a list.", root.list-name);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    SubtleButton {
                        text: @tr("Cancel");
                        color: Palette.foreground;
                        clicked => {
                            confirm.close();
                        }
                    }

                    InkButton {
                        text: @tr("Delete");
                        clicked => {
                            confirm.close();
                            root.delete-list(root.list-id);
                        }
                    }
                }
            }
        }
    }

    if root.day-habits.length > 0: VerticalLayout {
        spacing: 2px;
        Text {
            text: Strings.habits-today(root.habits-done, root.day-habits.length);
            font-size: 12px;
            font-weight: 600;
            color: Theme.muted;
        }

        for habit in root.day-habits: Rectangle {
            height: 40px;
            border-radius: 6px;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                InkCheck {
                    checked: habit.done;
                    label: habit.name;
                    toggled(done) => {
                        root.set-habit-done(habit.id, done);
                    }
                }

                // Same 6px inset as a task title, so both columns of text line up.
                Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: habit.name;
                        vertical-alignment: center;
                        overflow: elide;
                        color: habit.done ? Theme.done : Palette.foreground;
                        animate color { duration: Theme.fast; easing: Theme.ease-out; }
                        accessible-role: none;
                    }
                }
            }
        }
    }

    editor := TaskEditor {
        // Fixed spot under the title, so it never runs off the bottom for low rows.
        x: (root.width - self.width) / 2;
        y: 72px;
        task-id: root.editing.id;
        title: root.editing.title;
        note: root.editing.note;
        urgent: root.editing.urgent;
        important: root.editing.important;
        start-text: root.editing.start;
        end-text: root.editing.end;
        repeat: root.editing.repeat;
        every-text: root.editing.every;
        has-date: root.editing.due-kind != DueKind.none;
        saved(id, title, note, urgent, important, start, end, repeat, every) => {
            return root.update-task(id, title, note, urgent, important, start, end, repeat, every);
        }
        deleted(id) => {
            root.delete-task(id);
        }
    }

    if root.error != "": Text {
        text: root.error;
        color: Theme.critical;
        wrap: word-wrap;
    }

    // Only beside the habits: alone under the view's title it would say the same thing twice.
    if root.day-habits.length > 0: Text {
        text: Strings.tasks-today(root.done-count, root.tasks.length);
        font-size: 12px;
        font-weight: 600;
        color: Theme.muted;
    }

    if root.tasks.length == 0: EmptyState {
        title: root.view == TaskView.today ? @tr("Nothing due today.") : root.view == TaskView.scheduled ? @tr("Nothing scheduled.") : root.view == TaskView.inbox ? @tr("The inbox is empty.") : root.view == TaskView.overdue ? @tr("Nothing overdue.") : root.view == TaskView.all ? @tr("No tasks yet.") : @tr("This list is empty.");
        action: root.can-create ? @tr("Add task") : "";
        clicked => {
            creator.show();
        }
        description: root.view == TaskView.today ? @tr("Tasks due today gather here, whichever list they belong to. Anything you add from this view is dated today.") : root.view == TaskView.scheduled ? @tr("Tasks with a future date wait here, soonest first, so you can see what is coming. A task added here starts out due tomorrow.") : root.view == TaskView.inbox ? @tr("Jot things down here before deciding when or where they go. A task leaves the inbox once you give it a date or a list.") : root.view == TaskView.overdue ? @tr("Tasks whose date has passed show up here until you complete them or give them a new date. You are up to date.") : root.view == TaskView.all ? @tr("Every task you create shows up here, with or without a date or a list.") : @tr("Group related tasks here, like a project or an area of your life. Tasks you add from this view go straight into this list.");

        TaskPreview {
            show-list: root.view == TaskView.today || root.view == TaskView.all || root.view == TaskView.list;
            show-date: root.view != TaskView.inbox && root.view != TaskView.list;
            late: root.view == TaskView.overdue;
            ticks: root.view != TaskView.overdue;
        }
    }

    if root.tasks.length > 0: ListView {
        for row in root.tasks: VerticalLayout {
            if row.first-done: Text {
                text: @tr("COMPLETED · {}", root.done-count);
                font-size: 12px;
                font-weight: 600;
                color: Theme.muted;
                height: 36px;
                vertical-alignment: bottom;
            }

            TaskLine {
                task: row;
                view: root.view;
                lists: root.lists;
                toggled(done) => {
                    root.set-done(row.id, done);
                }
                opened => {
                    root.open-editor(row);
                }
                list-picked(list-id) => {
                    root.set-list(row.id, list-id);
                }
                due-picked(date) => {
                    root.set-due(row.id, date);
                }
                due-cleared => {
                    root.clear-due(row.id);
                }
            }
        }
    }
}