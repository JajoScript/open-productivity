import { Date, Palette } from "std-widgets.slint";
import { InkCheck } from "../ink-check.slint";
import { Theme } from "../theme.slint";
import { ListEntry } from "../list-entry.slint";
import { DueButton, DueKind } from "due-button.slint";
import { ListButton } from "list-button.slint";
import { Repeat } from "task-editor.slint";

export enum TaskView { today, scheduled, inbox, overdue, all, list }

export struct TaskRow {
    id: int,
    title: string,
    note: string,
    done: bool,
    due-kind: DueKind,
    due-day: int,
    due-month: int,
    due-year: int,
    list-name: string,
    urgent: bool,
    important: bool,
    // From core (`Task::time_label`): "09:00" or "09:00-10:30"; empty without a time.
    time: string,
    // The start and end times alone, as the editor shows them.
    start: string,
    end: string,
    // From core: how the task repeats and the "every N" count as text ("1" when not set).
    repeat: Repeat,
    every: string,
    // From core (`first_done`): this row opens the "Completed" section.
    first-done: bool,
}

// One task: checkbox, title (opens the editor), note mark, list and due date.
export component TaskLine inherits Rectangle {
    in property <TaskRow> task;
    in property <TaskView> view;
    in property <[ListEntry]> lists;
    callback toggled(bool);
    callback opened;
    callback list-picked(int);
    callback due-picked(Date);
    callback due-cleared;

    height: 40px;
    border-radius: 6px;
    background: row-touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }

    // Wraps the controls, so the row keeps its hover while the pointer is over them.
    row-touch := TouchArea {
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 4px;
            InkCheck {
                checked: root.task.done;
                label: root.task.title;
                toggled(done) => {
                    root.toggled(done);
                }
            }

            // Plain text with a wash on hover; opens the editor.
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: title-touch.pressed ? Theme.pressed : title-touch.has-hover ? Theme.hover : transparent;
                animate background { duration: Theme.fast; easing: Theme.ease-out; }
                forward-focus: title-focus;
                accessible-role: button;
                accessible-label: root.task.title;
                accessible-action-default => {
                    root.opened();
                }

                Text {
                    x: 6px;
                    width: parent.width - 12px;
                    height: parent.height;
                    text: root.task.title;
                    vertical-alignment: center;
                    overflow: elide;
                    color: root.task.done ? Theme.done : Palette.foreground;
                    animate color { duration: Theme.fast; easing: Theme.ease-out; }
                    accessible-role: none;
                }

                title-touch := TouchArea {
                    clicked => {
                        root.opened();
                    }
                }

                title-focus := FocusScope {
                    width: 0px; // keyboard only; clicks go to the TouchArea
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return {
                            root.opened();
                            return accept;
                        }
                        reject
                    }
                }

                if title-focus.has-focus: Rectangle {
                    border-radius: 5px;
                    border-width: 2px;
                    border-color: Palette.foreground;
                }
            }

            // Beside the title, which gives up the room, so the columns after it stay aligned.
            if root.task.time != "": Text {
                text: root.task.time;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
            }

            // The slot stays reserved so the list column lines up across rows.
            Rectangle {
                width: 16px;
                if root.task.note != "": Image {
                    source: @image-url("../icons/notebook-text.svg");
                    colorize: Theme.muted;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    accessible-role: image;
                    accessible-label: @tr("Has a note");
                }
            }

            Rectangle {
                width: 16px;
                if root.task.repeat != Repeat.never: Image {
                    source: @image-url("../icons/repeat.svg");
                    colorize: Theme.muted;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    accessible-role: image;
                    accessible-label: @tr("Repeats");
                }
            }

            ListButton {
                name: root.task.list-name;
                lists: root.lists;
                dimmed: root.task.done;
                picked(list-id) => {
                    root.list-picked(list-id);
                }
            }

            DueButton {
                kind: root.task.due-kind;
                day: root.task.due-day;
                month: root.task.due-month;
                year: root.task.due-year;
                reveal: row-touch.has-hover;
                implied: root.view == TaskView.today && root.task.due-kind == DueKind.today;
                dimmed: root.task.done;
                picked(date) => {
                    root.due-picked(date);
                }
                cleared => {
                    root.due-cleared();
                }
            }
        }
    }
}
