import { Date, Palette } from "std-widgets.slint";
import { Strings } from "strings.slint";
import { NavEntry } from "nav-entry.slint";
import { DueKind, TaskRow, TaskView, TasksView } from "tasks/tasks-view.slint";
export { Date, DueKind, Strings, TaskRow, TaskView }

export component AppWindow inherits Window {
    in property <string> instance-name;
    in property <[TaskRow]> tasks;
    in property <string> tasks-error;
    in property <TaskView> current-view;
    callback select-view(TaskView);
    callback create-task(string);
    callback set-done(int, bool);
    callback set-due(int, Date);
    callback clear-due(int);

    title: "Open Productivity — " + instance-name;
    preferred-width: 960px;
    preferred-height: 640px;

    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 8px;
                alignment: start;
                NavEntry {
                    icon: @image-url("icons/sun.svg");
                    text: @tr("Today");
                    selected: root.current-view == TaskView.today;
                    clicked => {
                        root.select-view(TaskView.today);
                    }
                }

                NavEntry {
                    icon: @image-url("icons/list-todo.svg");
                    text: @tr("Tasks");
                    selected: root.current-view == TaskView.all;
                    clicked => {
                        root.select-view(TaskView.all);
                    }
                }
            }
        }

        TasksView {
            view: root.current-view;
            tasks: root.tasks;
            error: root.tasks-error;
            create-task(title) => {
                root.create-task(title);
            }
            set-done(id, done) => {
                root.set-done(id, done);
            }
            set-due(id, date) => {
                root.set-due(id, date);
            }
            clear-due(id) => {
                root.clear-due(id);
            }
        }
    }
}
