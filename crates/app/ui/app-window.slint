import { Date, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Calendar, MonthView } from "ink-date-popup.slint";
import { ListEntry } from "list-entry.slint";
import { Sidebar } from "sidebar.slint";
import { Language, SettingsView } from "settings/settings-view.slint";
import { DueKind, TaskRow, TaskView, TasksView } from "tasks/tasks-view.slint";
export { Calendar, Date, DueKind, Language, ListEntry, MonthView, Strings, TaskRow, TaskView }

export component AppWindow inherits Window {
    icon: @image-url("app-icons/icon_256x256.png");
    in property <string> instance-name;
    in property <[TaskRow]> tasks;
    in property <string> tasks-error;
    in property <TaskView> current-view;
    in property <int> current-list-id;
    in property <string> current-list-name;
    in property <int> today-count;
    in property <int> all-count;
    in property <[ListEntry]> lists;
    in property <Language> current-language;
    in property <string> settings-error;
    in property <string> version;
    in property <string> license-text;
    in-out property <string> export-status;
    in property <bool> export-failed;
    callback set-language(Language);
    callback open-source;
    callback export-copy;
    callback select-view(TaskView);
    callback create-task(string);
    callback set-done(int, bool);
    callback set-due(int, Date);
    callback clear-due(int);
    callback select-list(int);
    callback create-list(string);
    callback delete-list(int);
    callback set-list(int, int);
    callback update-task(int, string, string) -> bool;
    callback delete-task(int);

    title: "Open Productivity — " + instance-name;
    preferred-width: 960px;
    preferred-height: 640px;

    // Signature motion: on every view change the content is hidden for one frame,
    // then fades in and rises into place.
    property <bool> entering;
    // Settings is a page of its own, not a task view; any task navigation leaves it.
    property <bool> settings-open;
    changed settings-open => {
        root.export-status = "";
        root.entering = true;
    }
    changed current-view => {
        root.entering = true;
    }
    changed current-list-id => {
        root.entering = true;
    }
    Timer {
        interval: 16ms;
        running: root.entering;
        triggered => {
            root.entering = false;
        }
    }

    HorizontalLayout {
        Sidebar {
            width: 220px;
            instance-name: root.instance-name;
            current-view: root.current-view;
            current-list-id: root.current-list-id;
            today-count: root.today-count;
            all-count: root.all-count;
            lists: root.lists;
            settings-open: root.settings-open;
            open-settings => {
                root.settings-open = true;
            }
            select-view(v) => {
                root.settings-open = false;
                root.select-view(v);
            }
            select-list(id) => {
                root.settings-open = false;
                root.select-list(id);
            }
            create-list(name) => {
                root.create-list(name);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Palette.background;

            // One tiled 128px texture, alpha baked into the colorize brush: no offscreen layer.
            if Theme.grain > 0: Image {
                width: parent.width;
                height: parent.height;
                source: @image-url("textures/grain.png");
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
                colorize: Palette.foreground.with-alpha(Theme.grain);
                accessible-role: none;
            }

            stage := Rectangle {
                width: parent.width;
                height: parent.height;
                states [
                    hidden when root.entering: {
                        opacity: 0;
                        y: 6px;
                        out {
                            animate opacity, y { duration: Theme.enter; easing: Theme.ease-out; }
                        }
                    }
                ]

                if root.settings-open: SettingsView {
                    width: parent.width;
                    height: parent.height;
                    language: root.current-language;
                    error: root.settings-error;
                    version: root.version;
                    license-text: root.license-text;
                    export-status: root.export-status;
                    export-failed: root.export-failed;
                    export-copy => {
                        root.export-copy();
                    }
                    open-source => {
                        root.open-source();
                    }
                    set-language(l) => {
                        root.set-language(l);
                    }
                }

                if !root.settings-open: TasksView {
                    width: parent.width;
                    height: parent.height;
                    view: root.current-view;
                    tasks: root.tasks;
                    error: root.tasks-error;
                    list-id: root.current-list-id;
                    list-name: root.current-list-name;
                    lists: root.lists;
                    create-task(title) => {
                        root.create-task(title);
                    }
                    set-done(id, done) => {
                        root.set-done(id, done);
                    }
                    set-due(id, date) => {
                        root.set-due(id, date);
                    }
                    clear-due(id) => {
                        root.clear-due(id);
                    }
                    set-list(id, list-id) => {
                        root.set-list(id, list-id);
                    }
                    delete-list(id) => {
                        root.delete-list(id);
                    }
                    update-task(id, title, note) => {
                        return root.update-task(id, title, note);
                    }
                    delete-task(id) => {
                        root.delete-task(id);
                    }
                }
            }
        }
    }
}
