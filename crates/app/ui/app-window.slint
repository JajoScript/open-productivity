import { Date, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Calendar, MonthView } from "ink-date-popup.slint";
import { ListEntry } from "list-entry.slint";
import { ListCreator } from "tasks/list-creator.slint";
import { HabitCreator } from "habits/habit-creator.slint";
import { ArchivedHabits } from "habits/archived-habits.slint";
import { ArchivedRow, DayState, HabitRow, HabitsView, HeatCell, HeatLevel, WeekTotal } from "habits/habits-view.slint";
import { CalendarDay, CalendarHabit, CalendarMode, CalendarTask, CalendarView, WeekBlock, WeekColumn } from "calendar/calendar-view.slint";
import { Module, Rail } from "rail.slint";
import { QuickCreate } from "quick-create.slint";
import { TaskCreator } from "tasks/task-creator.slint";
import { ColorMode, Language, SettingsView } from "settings/settings-view.slint";
import { InstanceRow } from "settings/data-section.slint";
import { DayHabit, DueKind, KanbanColumn, Quadrant, Repeat, Stage, TaskRow, TasksTab, TaskView, TasksView, ViewCounts, WeekDay } from "tasks/tasks-view.slint";
export { ArchivedRow, Calendar, Repeat, CalendarDay, CalendarHabit, CalendarMode, CalendarTask, WeekBlock, WeekColumn, DayHabit, Date, DayState, DueKind, HabitRow, HeatCell, HeatLevel, InstanceRow, KanbanColumn, Quadrant, Stage, ColorMode, Language, ListEntry, MonthView, Strings, TaskRow, TasksTab, TaskView, ViewCounts, WeekDay, WeekTotal }

export component AppWindow inherits Window {
    icon: @image-url("app-icons/icon_256x256.png");
    in property <string> instance-name;
    in property <[TaskRow]> tasks;
    in property <string> tasks-error;
    in property <TaskView> current-view;
    in property <int> current-list-id;
    in property <string> current-list-name;
    in property <bool> can-create;
    in property <int> pending-count;
    in property <int> done-count;
    in property <Date> today;
    // 0 is Monday.
    in property <int> today-weekday;
    in property <ViewCounts> counts;
    in property <[ListEntry]> lists;
    in property <Language> current-language;
    in property <ColorMode> current-color-mode;
    in property <string> settings-error;
    in property <string> version;
    in property <string> license-text;
    in-out property <string> export-status;
    in property <bool> export-failed;
    in property <[InstanceRow]> instances;
    in-out property <string> instances-status;
    callback instances-opened;
    // Habits changed in another view: the calendar reloads.
    callback refresh-calendar();
    callback open-instance(string);
    callback remove-instance(string);
    callback new-instance;
    callback open-folder;
    callback set-language(Language);
    callback set-color-mode(ColorMode);
    callback open-source;
    callback export-copy;
    callback select-view(TaskView);
    callback select-tab(TasksTab);
    in property <[[CalendarDay]]> calendar-weeks;
    in property <Date> calendar-month;
    in property <string> calendar-error;
    in property <[CalendarTask]> calendar-overdue;
    in property <[CalendarTask]> calendar-undated;
    callback calendar-shift(int);
    in property <CalendarMode> calendar-mode;
    in property <[WeekColumn]> calendar-week;
    in property <int> calendar-now;
    callback calendar-set-mode(CalendarMode);
    // Dragged onto the week grid (minutes since midnight) or a day's "No time" strip.
    callback reschedule-task-at(int, Date, int);
    callback reschedule-task-untimed(int, Date);
    pure callback calendar-slot(int) -> int;
    // Dragged onto a day of the calendar: the task is due that day.
    callback reschedule-task(int, Date);
    in property <[WeekDay]> week-days;
    callback week-shift(int);
    in property <[KanbanColumn]> kanban-columns;
    callback move-task(int, Stage);
    pure callback task-payload(int) -> data-transfer;
    pure callback payload-task(data-transfer) -> int;
    in property <[Quadrant]> quadrants;
    callback set-priority(int, bool, bool);
    callback create-task(string) -> string;
    // From the floating button: always files into the Inbox, whatever view is open.
    callback quick-create-task(string) -> string;
    // From a day of the calendar: the task is due that day.
    callback create-task-on(string, Date) -> string;
    callback set-done(int, bool);
    callback set-due(int, Date);
    callback clear-due(int);
    callback select-list(int);
    callback create-list(string) -> string;
    callback delete-list(int);
    callback set-list(int, int);
    callback update-task(int, string, string, bool, bool, string, string, Repeat, string) -> string;
    callback delete-task(int);
    in property <[HabitRow]> habits;
    in property <[[int]]> habit-day-numbers;
    in property <[WeekTotal]> habit-week-totals;
    in property <WeekTotal> habit-month-total;
    in property <[[HeatCell]]> habit-heat;
    in property <string> habits-error;
    in property <Date> habits-month;
    in property <int> habits-today-day;
    in property <bool> habits-can-next;
    callback habits-shift(int);
    callback create-habit(string, [bool], Date) -> string;
    callback update-habit(int, string, [bool], Date) -> string;
    callback archive-habit(int);
    in property <[ArchivedRow]> archived-habits;
    callback restore-habit(int);
    callback set-habit-done(int, int, bool);
    in property <[DayHabit]> day-habits;
    in property <int> habits-done;
    callback set-day-habit-done(int, bool);

    title: "Open Productivity — " + instance-name;
    preferred-width: 1280px;
    preferred-height: 720px;

    // Signature motion: on every view change the content is hidden for one frame,
    // then fades in and rises into place.
    property <bool> entering;
    property <Module> module;
    property <Date> creating-on;
    property <TasksTab> tasks-tab;
    // What the habit modal opens with: a new habit, or the one being edited.
    property <bool> habit-editing;
    property <int> habit-edit-id;
    property <string> habit-edit-name;
    property <[bool]> habit-edit-days;
    property <Date> habit-edit-start;
    // The only place that forces Palette; `unknown` hands it back to the system.
    function open-new-habit() {
        root.habit-editing = false;
        root.habit-edit-name = "";
        root.habit-edit-days = [false, false, false, false, false, false, false];
        root.habit-edit-start = Calendar.today();
        habit-creator.show();
    }

    function apply-color-mode() {
        Palette.color-scheme = root.current-color-mode == ColorMode.light ? ColorScheme.light : root.current-color-mode == ColorMode.dark ? ColorScheme.dark : ColorScheme.unknown;
    }
    init => {
        root.apply-color-mode();
    }
    changed current-color-mode => {
        root.apply-color-mode();
    }
    changed module => {
        root.export-status = "";
        root.instances-status = "";
        if root.module == Module.settings {
            root.instances-opened();
        }
        root.entering = true;
    }
    changed current-view => {
        root.entering = true;
    }
    changed current-list-id => {
        root.entering = true;
    }
    Timer {
        interval: 16ms;
        running: root.entering;
        triggered => {
            root.entering = false;
        }
    }

    HorizontalLayout {
        // The collapsed rail's slot; the rail itself is drawn last, so it opens over the content.
        Rectangle {
            width: 56px;
        }

        habit-creator := HabitCreator {
            editing: root.habit-editing;
            habit-id: root.habit-edit-id;
            habit-name: root.habit-edit-name;
            days: root.habit-edit-days;
            start-date: root.habit-edit-start;
            x: (root.width - self.width) / 2;
            y: 120px;
            create(name, days, start) => {
                return root.create-habit(name, days, start);
            }
            update(id, name, days, start) => {
                return root.update-habit(id, name, days, start);
            }
            archive(id) => {
                root.archive-habit(id);
            }
        }

        archived-popup := ArchivedHabits {
            habits: root.archived-habits;
            x: (root.width - self.width) / 2;
            y: 120px;
            restore(id) => {
                root.restore-habit(id);
            }
        }

        list-creator := ListCreator {
            x: (root.width - self.width) / 2;
            y: 120px;
            create(name) => {
                return root.create-list(name);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Palette.background;

            // One tiled 128px texture, alpha baked into the colorize brush: no offscreen layer.
            if Theme.grain > 0: Image {
                width: parent.width;
                height: parent.height;
                source: @image-url("textures/grain.png");
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
                colorize: Palette.foreground.with-alpha(Theme.grain);
                accessible-role: none;
            }

            stage := Rectangle {
                width: parent.width;
                height: parent.height;
                states [
                    hidden when root.entering: {
                        opacity: 0;
                        y: 6px;
                        out {
                            animate opacity, y { duration: Theme.enter; easing: Theme.ease-out; }
                        }
                    }
                ]

                if root.module == Module.settings: SettingsView {
                    width: parent.width;
                    height: parent.height;
                    language: root.current-language;
                    color-mode: root.current-color-mode;
                    error: root.settings-error;
                    version: root.version;
                    license-text: root.license-text;
                    export-status: root.export-status;
                    export-failed: root.export-failed;
                    instances: root.instances;
                    instances-status: root.instances-status;
                    open-instance(p) => {
                        root.open-instance(p);
                    }
                    remove-instance(p) => {
                        root.remove-instance(p);
                    }
                    new-instance => {
                        root.new-instance();
                    }
                    open-folder => {
                        root.open-folder();
                    }
                    export-copy => {
                        root.export-copy();
                    }
                    open-source => {
                        root.open-source();
                    }
                    set-language(l) => {
                        root.set-language(l);
                    }
                    set-color-mode(m) => {
                        root.set-color-mode(m);
                    }
                }

                if root.module == Module.calendar: CalendarView {
                    width: parent.width;
                    height: parent.height;
                    weeks: root.calendar-weeks;
                    month: root.calendar-month;
                    error: root.calendar-error;
                    overdue: root.calendar-overdue;
                    undated: root.calendar-undated;
                    mode: root.calendar-mode;
                    week: root.calendar-week;
                    now: root.calendar-now;
                    shift(n) => {
                        root.calendar-shift(n);
                    }
                    set-mode(m) => {
                        root.calendar-set-mode(m);
                    }
                    reschedule-at(id, date, minutes) => {
                        root.reschedule-task-at(id, date, minutes);
                    }
                    reschedule-untimed(id, date) => {
                        root.reschedule-task-untimed(id, date);
                    }
                    slot(m) => {
                        return root.calendar-slot(m);
                    }
                    reschedule(id, date) => {
                        root.reschedule-task(id, date);
                    }
                    task-payload(id) => {
                        return root.task-payload(id);
                    }
                    payload-task(data) => {
                        return root.payload-task(data);
                    }
                    day-chosen(date) => {
                        root.creating-on = date;
                        day-task-creator.show();
                    }
                }

                if root.module == Module.habits: HabitsView {
                    width: parent.width;
                    height: parent.height;
                    habits: root.habits;
                    day-numbers: root.habit-day-numbers;
                    week-totals: root.habit-week-totals;
                    month-total: root.habit-month-total;
                    heat: root.habit-heat;
                    error: root.habits-error;
                    month: root.habits-month;
                    today-day: root.habits-today-day;
                    can-next: root.habits-can-next;
                    archived-count: root.archived-habits.length;
                    open-archived => {
                        archived-popup.show();
                    }
                    new-habit => {
                        root.open-new-habit();
                    }
                    edit-habit(habit) => {
                        root.habit-editing = true;
                        root.habit-edit-id = habit.id;
                        root.habit-edit-name = habit.name;
                        root.habit-edit-days = habit.weekdays;
                        root.habit-edit-start = habit.start;
                        habit-creator.show();
                    }
                    shift(n) => {
                        root.habits-shift(n);
                    }
                    set-habit-done(id, day, done) => {
                        root.set-habit-done(id, day, done);
                    }
                }

                if root.module == Module.tasks: TasksView {
                    width: parent.width;
                    height: parent.height;
                    tab <=> root.tasks-tab;
                    view: root.current-view;
                    can-create: root.can-create;
                    pending-count: root.pending-count;
                    done-count: root.done-count;
                    today: root.today;
                    today-weekday: root.today-weekday;
                    counts: root.counts;
                    select-view(v) => {
                        root.select-view(v);
                    }
                    select-tab(t) => {
                        root.select-tab(t);
                    }
                    day-habits: root.day-habits;
                    habits-done: root.habits-done;
                    set-habit-done(id, done) => {
                        root.set-day-habit-done(id, done);
                    }
                    week-days: root.week-days;
                    week-shift(n) => {
                        root.week-shift(n);
                    }
                    kanban-columns: root.kanban-columns;
                    quadrants: root.quadrants;
                    set-priority(id, urgent, important) => {
                        root.set-priority(id, urgent, important);
                    }
                    move-task(id, s) => {
                        root.move-task(id, s);
                    }
                    task-payload(id) => {
                        return root.task-payload(id);
                    }
                    payload-task(data) => {
                        return root.payload-task(data);
                    }
                    select-list(id) => {
                        root.select-list(id);
                    }
                    new-list => {
                        list-creator.show();
                    }
                    tasks: root.tasks;
                    error: root.tasks-error;
                    list-id: root.current-list-id;
                    list-name: root.current-list-name;
                    lists: root.lists;
                    create-task(title) => {
                        return root.create-task(title);
                    }
                    set-done(id, done) => {
                        root.set-done(id, done);
                    }
                    set-due(id, date) => {
                        root.set-due(id, date);
                    }
                    clear-due(id) => {
                        root.clear-due(id);
                    }
                    set-list(id, list-id) => {
                        root.set-list(id, list-id);
                    }
                    delete-list(id) => {
                        root.delete-list(id);
                    }
                    update-task(id, title, note, urgent, important, start, end, repeat, every) => {
                        return root.update-task(id, title, note, urgent, important, start, end, repeat, every);
                    }
                    delete-task(id) => {
                        root.delete-task(id);
                    }
                }
            }
        }
    }

    Rail {
        x: 0px;
        y: 0px;
        height: root.height;
        module <=> root.module;
        instance-name: root.instance-name;
    }

    quick-task-creator := TaskCreator {
        x: (root.width - self.width) / 2;
        y: 120px;
        create(title) => {
            let error = root.quick-create-task(title);
            if error == "" {
                quick.notify();
            }
            return error;
        }
    }

    day-task-creator := TaskCreator {
        subtitle: Strings.date(root.creating-on.day, root.creating-on.month, root.creating-on.year);
        x: (root.width - self.width) / 2;
        y: 120px;
        create(title) => {
            return root.create-task-on(title, root.creating-on);
        }
    }

    quick := QuickCreate {
        visible: root.module != Module.settings;
        x: root.width - self.width - 24px;
        y: root.height - self.height - 24px;
        new-task => {
            quick-task-creator.show();
        }
        new-habit => {
            root.open-new-habit();
        }
    }
}
