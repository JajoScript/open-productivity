import { Palette } from "std-widgets.slint";
import { PopupSurface } from "popup-surface.slint";
import { Theme } from "theme.slint";

// One row of the create menu. Adding an option is one more MenuRow in the menu below.
component MenuRow inherits Rectangle {
    in property <string> text;
    // A disabled row is dimmed and does nothing; `hint` says why.
    in property <bool> enabled: true;
    in property <string> hint;
    callback activated;

    height: 36px;
    border-radius: 4px;
    opacity: root.enabled ? 1 : 0.45;
    background: !root.enabled ? transparent : touch.pressed ? Theme.pressed : touch.has-hover || focus.has-focus ? Theme.hover : transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.enabled ? "" : root.hint;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.activated();
        }
    }

    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        clicked => {
            if root.enabled {
                root.activated();
            }
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Space || event.text == Key.Return) {
                root.activated();
                return accept;
            }
            reject
        }
    }
}

// Floating "+" in the corner: an ink plate that opens a menu upwards. Place it where it belongs.
export component QuickCreate inherits Rectangle {
    callback new-task;
    callback new-habit;
    callback new-movement;
    callback new-scheduled;
    // The menu is about to open: the host refreshes what `finance-ready` depends on.
    callback opening;
    // Whether the Finances options can be used (an account and a main currency exist).
    in property <bool> finance-ready;
    // Shows the brief confirmation next to the button.
    public function notify(text: string) {
        root.notice-text = text;
        root.notice = true;
    }

    property <bool> notice;
    property <string> notice-text;
    function open-menu() {
        root.opening();
        menu.show();
    }

    width: 48px;
    height: 48px;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: @tr("Create");
    accessible-action-default => {
        root.open-menu();
    }

    Rectangle {
        border-radius: 24px;
        background: Theme.ink;
        opacity: touch.pressed ? 0.78 : touch.has-hover ? 0.88 : 1;
        animate opacity { duration: Theme.fast; easing: Theme.ease-out; }
    }

    Image {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("icons/plus.svg");
        colorize: Theme.on-ink;
        accessible-role: none;
    }

    touch := TouchArea {
        clicked => {
            root.open-menu();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.open-menu();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: 27px;
        border-width: 2px;
        border-color: Palette.foreground;
    }

    // Draws no input, so it never blocks what lies beneath.
    if root.notice: Rectangle {
        x: -self.width - 12px;
        y: (root.height - self.height) / 2;
        width: message.preferred-width + 24px;
        height: 32px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.hairline;
        background: Palette.background;
        accessible-role: text;
        accessible-label: message.text;

        message := Text {
            text: root.notice-text;
            vertical-alignment: center;
            horizontal-alignment: center;
            accessible-role: none;
        }

        Timer {
            interval: 2500ms;
            running: true;
            triggered => {
                root.notice = false;
            }
        }
    }

    menu := PopupWindow {
        // Opens upwards, right edges aligned.
        x: root.width - self.width;
        y: -self.height - 8px;
        width: 204px;
        height: rows.preferred-height;
        close-policy: close-on-click-outside;

        PopupSurface {
            FocusScope {
                capture-key-pressed(event) => {
                    if event.text == Key.Escape {
                        menu.close();
                        return accept;
                    }
                    reject
                }

                rows := VerticalLayout {
                    padding: 8px;
                    MenuRow {
                        text: @tr("Task");
                        init => {
                            self.focus();
                        }
                        activated => {
                            menu.close();
                            root.new-task();
                        }
                    }
                    MenuRow {
                        text: @tr("Habit");
                        activated => {
                            menu.close();
                            root.new-habit();
                        }
                    }
                    Rectangle {
                        height: 9px;
                        Rectangle {
                            y: 4px;
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                    MenuRow {
                        text: @tr("Movement");
                        enabled: root.finance-ready;
                        hint: @tr("Create an account in Finances first");
                        activated => {
                            menu.close();
                            root.new-movement();
                        }
                    }
                    MenuRow {
                        text: @tr("Scheduled payment");
                        enabled: root.finance-ready;
                        hint: @tr("Create an account in Finances first");
                        activated => {
                            menu.close();
                            root.new-scheduled();
                        }
                    }
                }
            }
        }
    }
}
