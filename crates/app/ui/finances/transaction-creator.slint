import { Date, Palette, ScrollView } from "std-widgets.slint";
import { InkCheck } from "../ink-check.slint";
import { InkButton } from "../ink-button.slint";
import { InkDatePopup } from "../ink-date-popup.slint";
import { InkField } from "../ink-field.slint";
import { PopupSurface } from "../popup-surface.slint";
import { SettingsTab } from "../settings/settings-tab.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { ChoiceRow } from "../study/session-logger.slint";
import { Theme } from "../theme.slint";
import { FinanceStore } from "finance-store.slint";
import { TxKind } from "transaction-row.slint";

// Rebuilt on every show(), so the fields and the error always start fresh.
component CreatorBody inherits FocusScope {
    in property <bool> editing;
    // What the delete confirmation asks about: the movement's amount as the list shows it.
    in property <string> amount-label;
    // The modal gives the initial values and the user edits them here.
    in-out property <TxKind> kind;
    // A transfer has no kind nor category: it moves money from `account-id` to `to-account-id`.
    in-out property <bool> transfer;
    in-out property <int> to-account-id;
    // The accounts the movement already had, which stay pickable even if archived.
    in property <int> orig-account-id;
    in property <int> orig-to-id;
    in-out property <int> account-id;
    in-out property <bool> has-category;
    in-out property <int> category-id;
    // The kind of the chosen category, to drop it when the movement changes kind.
    in-out property <TxKind> category-kind;
    in-out property <string> amount;
    // The currency codes of the chosen accounts; a transfer between different ones asks for the
    // amount that arrives.
    in-out property <string> from-currency;
    in-out property <string> to-currency;
    in-out property <string> to-amount;
    in-out property <Date> date;
    in-out property <string> description;
    // The movement came from a scheduled payment that deleting it can return to the schedule;
    // `number` and `total` tell the installment, 0 for a one-time payment.
    in property <bool> restorable;
    in property <int> installment-number;
    in property <int> installment-total;
    callback save(bool, TxKind, int, int, bool, int, string, string, Date, string) -> string;
    callback delete(bool) -> string;
    callback cancel;

    property <string> error;
    property <bool> restore;

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    function submit() {
        root.error = root.save(root.transfer, root.kind, root.account-id, root.to-account-id, root.has-category, root.category-id, root.amount, root.to-amount, root.date, root.description);
    }

    function set-kind(kind: TxKind) {
        if root.has-category && root.category-kind != kind {
            root.has-category = false;
        }
        root.transfer = false;
        root.kind = kind;
    }

    // Arrow keys move the choice, like the tabs they are drawn as.
    function step(delta: int) {
        if delta > 0 {
            if root.transfer {
                return;
            }
            if root.kind == TxKind.income {
                root.transfer = true;
            } else {
                root.set-kind(TxKind.income);
            }
        } else if root.transfer {
            root.set-kind(TxKind.income);
        } else {
            root.set-kind(TxKind.expense);
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: root.editing ? @tr("Edit movement") : @tr("New movement");
            font-size: 14px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 0px;
            alignment: start;
            accessible-role: tab-list;
            SettingsTab {
                text: Strings.tx-kind(TxKind.expense);
                selected: !root.transfer && root.kind == TxKind.expense;
                chosen => {
                    root.set-kind(TxKind.expense);
                }
                step(d) => {
                    root.step(d);
                }
            }

            SettingsTab {
                text: Strings.tx-kind(TxKind.income);
                selected: !root.transfer && root.kind == TxKind.income;
                chosen => {
                    root.set-kind(TxKind.income);
                }
                step(d) => {
                    root.step(d);
                }
            }

            SettingsTab {
                text: Strings.transfer;
                selected: root.transfer;
                chosen => {
                    root.transfer = true;
                }
                step(d) => {
                    root.step(d);
                }
            }
        }

        Text {
            text: root.transfer ? @tr("From account") : @tr("Account");
            color: Theme.muted;
        }

        ScrollView {
            height: min(from-list.preferred-height, 128px);
            from-list := VerticalLayout {
                for account in FinanceStore.accounts: ChoiceRow {
                    label: account.name;
                    icon: @image-url("../icons/wallet.svg");
                    chosen: account.id == root.account-id;
                    picked => {
                        root.account-id = account.id;
                        root.from-currency = account.currency;
                    }
                }

                // The archived account the movement already has stays pickable.
                for account in FinanceStore.archived-accounts: VerticalLayout {
                    if account.id == root.orig-account-id: ChoiceRow {
                        label: Strings.archived-account(account.name);
                        icon: @image-url("../icons/wallet.svg");
                        chosen: account.id == root.account-id;
                        picked => {
                            root.account-id = account.id;
                            root.from-currency = account.currency;
                        }
                    }
                }
            }
        }

        if root.transfer: Text {
            text: @tr("To account");
            color: Theme.muted;
        }

        if root.transfer: ScrollView {
            height: min(to-list.preferred-height, 128px);
            to-list := VerticalLayout {
                for account in FinanceStore.accounts: ChoiceRow {
                    label: account.name;
                    icon: @image-url("../icons/wallet.svg");
                    chosen: account.id == root.to-account-id;
                    picked => {
                        root.to-account-id = account.id;
                        root.to-currency = account.currency;
                    }
                }

                // The archived account the movement already has stays pickable.
                for account in FinanceStore.archived-accounts: VerticalLayout {
                    if account.id == root.orig-to-id: ChoiceRow {
                        label: Strings.archived-account(account.name);
                        icon: @image-url("../icons/wallet.svg");
                        chosen: account.id == root.to-account-id;
                        picked => {
                            root.to-account-id = account.id;
                            root.to-currency = account.currency;
                        }
                    }
                }
            }
        }

        if !root.transfer: Text {
            text: @tr("Category");
            color: Theme.muted;
        }

        if !root.transfer: ScrollView {
            height: 128px;
            VerticalLayout {
                ChoiceRow {
                    label: @tr("No category");
                    icon: @image-url("../icons/x.svg");
                    chosen: !root.has-category;
                    picked => {
                        root.has-category = false;
                    }
                }

                // Those of the kind, and the archived one the movement already has.
                for c in FinanceStore.category-choices: VerticalLayout {
                    if c.kind == root.kind && (!c.archived || (root.has-category && c.id == root.category-id)): ChoiceRow {
                        label: c.archived ? Strings.archived-category(c.name) : c.name;
                        icon: @image-url("../icons/tag.svg");
                        chosen: root.has-category && c.id == root.category-id;
                        picked => {
                            root.has-category = true;
                            root.category-id = c.id;
                            root.category-kind = c.kind;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            InkField {
                text <=> root.amount;
                placeholder-text: @tr("Amount");
                init => {
                    self.focus();
                }
                accepted(text) => {
                    root.submit();
                }
            }

            Text {
                text: root.from-currency;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }

        if root.transfer && root.to-currency != "" && root.to-currency != root.from-currency: HorizontalLayout {
            spacing: 8px;
            InkField {
                text <=> root.to-amount;
                placeholder-text: @tr("Amount that arrives");
                accepted(text) => {
                    root.submit();
                }
            }

            Text {
                text: root.to-currency;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }

        Text {
            text: @tr("Date");
            color: Theme.muted;
        }

        HorizontalLayout {
            height: 36px;
            alignment: start;
            picker := InkDatePopup {
                y: 36px;
                day: root.date.day;
                month: root.date.month;
                year: root.date.year;
                picked(date) => {
                    root.date = date;
                }
            }

            SubtleButton {
                text: Strings.date(root.date.day, root.date.month, root.date.year);
                icon: @image-url("../icons/calendar.svg");
                color: Palette.foreground;
                clicked => {
                    picker.show();
                }
            }
        }

        InkField {
            text <=> root.description;
            placeholder-text: @tr("Description (optional)");
            accepted(text) => {
                root.submit();
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.critical;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            if root.editing: SubtleButton {
                text: @tr("Delete");
                color: Palette.foreground;
                clicked => {
                    confirm.show();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            SubtleButton {
                text: @tr("Cancel");
                color: Palette.foreground;
                clicked => {
                    root.cancel();
                }
            }

            InkButton {
                text: root.editing ? @tr("Save") : @tr("Create");
                clicked => {
                    root.submit();
                }
            }
        }
    }

    confirm := PopupWindow {
        x: (root.width - self.width) / 2;
        y: 72px;
        width: 320px;
        PopupSurface {
            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    text: Strings.delete-transaction-question(root.amount-label, Strings.date(root.date.day, root.date.month, root.date.year));
                    wrap: word-wrap;
                }

                if root.restorable: HorizontalLayout {
                    spacing: 4px;
                    InkCheck {
                        checked: root.restore;
                        label: restore-text.text;
                        toggled(on) => {
                            root.restore = on;
                        }
                    }

                    restore-text := Text {
                        text: root.installment-total > 0 ? Strings.restore-installment(root.installment-number, root.installment-total) : @tr("Also mark the scheduled payment as pending again");
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    SubtleButton {
                        text: @tr("Cancel");
                        color: Palette.foreground;
                        init => {
                            self.focus();
                        }
                        clicked => {
                            confirm.close();
                        }
                    }

                    InkButton {
                        text: @tr("Delete");
                        clicked => {
                            confirm.close();
                            root.error = root.delete(root.restorable && root.restore);
                        }
                    }
                }
            }
        }
    }
}

// Records an expense, income or transfer, or edits one, depending on how it is opened. Closing by clicking
// outside discards it.
export component TransactionCreator inherits PopupWindow {
    // Set by the opener before show().
    in property <bool> editing;
    in property <int> tx-id;
    in property <TxKind> tx-kind;
    in property <bool> tx-transfer;
    in property <int> tx-to-account-id;
    in property <int> tx-account-id;
    in property <bool> tx-has-category;
    in property <int> tx-category-id;
    in property <string> tx-amount;
    in property <string> tx-from-currency;
    in property <string> tx-to-currency;
    in property <string> tx-to-amount;
    in property <string> tx-amount-label;
    in property <Date> tx-date;
    in property <string> tx-description;
    in property <bool> tx-restorable;
    in property <int> tx-installment-number;
    in property <int> tx-installment-total;

    close-policy: close-on-click-outside;
    width: 400px;

    PopupSurface {
        CreatorBody {
            editing: root.editing;
            amount-label: root.tx-amount-label;
            kind: root.tx-kind;
            transfer: root.tx-transfer;
            account-id: root.tx-account-id;
            to-account-id: root.tx-to-account-id;
            orig-account-id: root.tx-account-id;
            orig-to-id: root.tx-to-account-id;
            has-category: root.tx-has-category;
            category-id: root.tx-category-id;
            category-kind: root.tx-kind;
            amount: root.tx-amount;
            from-currency: root.tx-from-currency;
            to-currency: root.tx-to-currency;
            to-amount: root.tx-to-amount;
            date: root.tx-date;
            description: root.tx-description;
            restorable: root.tx-restorable;
            installment-number: root.tx-installment-number;
            installment-total: root.tx-installment-total;
            save(transfer, kind, account, to-account, has-category, category, amount, to-amount, date, description) => {
                let error = transfer ? (root.editing ? FinanceStore.update-transfer(root.tx-id, account, to-account, amount, to-amount, date, description) : FinanceStore.create-transfer(account, to-account, amount, to-amount, date, description)) : (root.editing ? FinanceStore.update-transaction(root.tx-id, kind, account, has-category, category, amount, date, description) : FinanceStore.create-transaction(kind, account, has-category, category, amount, date, description));
                if error == "" {
                    root.close();
                }
                return error;
            }
            delete(restore) => {
                let error = FinanceStore.delete-transaction(root.tx-id, restore);
                if error == "" {
                    root.close();
                }
                return error;
            }
            cancel => {
                root.close();
            }
        }
    }
}
