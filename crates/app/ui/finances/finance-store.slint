import { Date } from "std-widgets.slint";
import { FinanceTab, MovementFilter, TransactionRow, TxKind } from "transaction-row.slint";
import { AccountKind, AccountRow, CurrencyRow, RateRow } from "account-row.slint";
import { BillRow } from "bill-row.slint";
import { BucketRow } from "bucket-row.slint";
import { CategoryRow } from "category-row.slint";
import { ScheduleForm, ScheduledRow } from "scheduled-row.slint";
import { ReserveDetail, ReserveRow } from "reserve-row.slint";
import { SummaryBar, SummaryFigure } from "summary-row.slint";

// What the Finances views show and ask for. Rust fills the data and answers the callbacks;
// the views read and call it directly instead of forwarding it through the window.
export global FinanceStore {
    // False until the user picks the main currency.
    in property <bool> has-currency;
    in property <[CurrencyRow]> currencies;
    // The main currency code, once chosen.
    in property <string> main-currency;
    // The non-main currencies some account uses; edited in one place.
    in property <[RateRow]> rates;
    // The active accounts; the archived ones are apart.
    in property <[AccountRow]> accounts;
    in property <[AccountRow]> archived-accounts;
    // Some active account is a credit card.
    in property <bool> has-cards;
    // The Accounts tab: some active account is plain, so it can hold a reserve.
    in property <bool> has-reservable;
    // The reserves, active then archived.
    in property <[ReserveRow]> reserves;
    in property <string> error;
    // The tab shown; Rust loads only what it needs.
    in-out property <FinanceTab> tab: FinanceTab.summary;
    // The movements of the month shown; only its month and year matter.
    in property <Date> month;
    in property <[TransactionRow]> transactions;
    // The kind of movement the Movements tab lists; changing it needs a refresh.
    in-out property <MovementFilter> movement-filter: MovementFilter.all;
    // The "to pay" tab: what is due in the month shown, and the overdue ones in the current month.
    in property <[ScheduledRow]> due;
    // The card bills due in that month, and the overdue ones in the current month.
    in property <[BillRow]> bills;
    // The Accounts tab's net worth: the total, the assets and debts, and the biggest positive accounts as bars.
    in property <string> worth-total;
    in property <string> worth-assets;
    in property <string> worth-debts;
    in property <[SummaryBar]> worth-bars;
    // The Summary tab, for the month shown: each figure with its change versus the month before.
    in property <SummaryFigure> summary-income;
    in property <SummaryFigure> summary-expense;
    in property <SummaryFigure> summary-balance;
    in property <SummaryFigure> summary-accounts;
    in property <[SummaryBar]> summary-bars;
    // Some account is not in the main currency, so the totals use exchange rates.
    in property <bool> summary-uses-rates;
    in property <[TransactionRow]> summary-recent;
    // The Budget tab, for the month shown: false until the first bucket exists.
    in property <bool> has-buckets;
    // The active buckets with their percentage of the month; then the archived ones.
    in property <[BucketRow]> buckets;
    in property <[BucketRow]> archived-buckets;
    // The income the percentages apply to, the month it belongs to, and what no bucket gets.
    in property <string> budget-base;
    in property <Date> budget-base-month;
    in property <string> budget-unassigned;
    // The setting: use the previous month's income instead of the shown month's.
    in property <bool> budget-previous;
    // The kind the Categories tab lists.
    in-out property <TxKind> category-kind: TxKind.expense;
    // False only while there are no categories at all, which offers the suggested ones.
    in property <bool> has-categories;
    // Of `category-kind`: active ones with their total of the month; then the archived ones.
    in property <[CategoryRow]> categories;
    in property <[CategoryRow]> archived-categories;
    // The month's total of that kind without category, "" when there is none.
    in property <string> uncategorized-total;
    // Every category of both kinds, for the movement modal to pick from.
    in property <[CategoryRow]> category-choices;

    // The ones that return a string give the error to show; empty means it worked.
    callback choose-currency(string) -> string;
    // name, kind, bank, currency code, initial balance, exchange rate ("" when it is not asked).
    callback create-account(string, AccountKind, string, string, string, string) -> string;
    callback update-account(int, string, AccountKind, string, string, string, string) -> string;
    // name, bank, currency code, limit, closing day, due day, exchange rate. The days are the
    // typed text; core validates them.
    // name, bank, currency code, initial balance, limit, exchange rate.
    callback create-credit-line(string, string, string, string, string, string) -> string;
    callback update-credit-line(int, string, string, string, string, string, string) -> string;
    callback create-card(string, string, string, string, string, string, string) -> string;
    callback update-card(int, string, string, string, string, string, string, string) -> string;
    // The exchange rates modal reports each field edited, then saves them all or discards them.
    callback edit-rate(string, string);
    callback save-rates() -> string;
    callback discard-rates();
    // Changing the main currency: the rates it asks for (suggested ones filled in), then save.
    // The fields report their edits through edit-rate.
    callback main-change-rates(string) -> [RateRow];
    callback change-main-currency(string) -> string;
    callback archive-account(int, bool) -> string;
    callback delete-account(int) -> string;
    callback create-reserve(string, int) -> string;
    callback rename-reserve(int, string) -> string;
    callback archive-reserve(int, bool) -> string;
    callback delete-reserve(int) -> string;
    // reserve, amount, date, description.
    callback reserve-money(int, string, Date, string) -> string;
    callback withdraw-reserve(int, string, Date, string) -> string;
    callback reserve-detail(int) -> ReserveDetail;
    callback create-transaction(TxKind, int, bool, int, string, Date, string) -> string;
    callback update-transaction(int, TxKind, int, bool, int, string, Date, string) -> string;
    callback create-transfer(int, int, string, string, Date, string) -> string;
    callback update-transfer(int, int, int, string, string, Date, string) -> string;
    // The second argument returns the scheduled payment the movement came from to the schedule.
    callback delete-transaction(int, bool) -> string;
    // kind, account, has category, category, amount, description, first date, form, installments.
    callback create-scheduled(TxKind, int, bool, int, string, string, Date, ScheduleForm, string) -> string;
    // id, account, has category, category, amount, description, next date, frequency (recurring only).
    callback update-scheduled(int, int, bool, int, string, string, Date, ScheduleForm) -> string;
    // id, date, amount of the movement it records.
    callback confirm-scheduled(int, Date, string) -> string;
    callback skip-scheduled(int) -> string;
    callback delete-scheduled(int) -> string;
    callback create-category(TxKind, string) -> string;
    callback rename-category(int, string) -> string;
    callback archive-category(int, bool) -> string;
    callback delete-category(int) -> string;
    callback create-suggested() -> string;
    callback create-bucket(string) -> string;
    callback rename-bucket(int, string) -> string;
    // bucket, typed percent of the shown month's income.
    callback set-share(int, string) -> string;
    callback archive-bucket(int, bool) -> string;
    callback delete-bucket(int) -> string;
    // category, bucket, true to put it in the bucket and false to take it out.
    callback assign-category(int, int, bool) -> string;
    // true: the previous month's income is the base.
    callback set-budget-base(bool) -> string;
    callback create-suggested-budget() -> string;
    // -1 / +1 moves a month; 0 goes back to the current one.
    callback shift(int);
    // Reload on entering the module or when the language changes the amount style.
    callback refresh();
}
