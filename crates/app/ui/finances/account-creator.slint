import { Palette, ScrollView } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { InkField } from "../ink-field.slint";
import { PopupSurface } from "../popup-surface.slint";
import { SettingsTab } from "../settings/settings-tab.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { ChoiceRow } from "../study/session-logger.slint";
import { AccountKind } from "account-row.slint";
import { FinanceStore } from "finance-store.slint";

// Rebuilt on every show(), so the fields and the error always start fresh.
component CreatorBody inherits FocusScope {
    in property <bool> editing;
    in property <bool> archived;
    in property <bool> in-use;
    // What the delete confirmation names: the saved name, not the one being typed.
    in property <string> saved-name;
    // The modal gives the initial values and the user edits them here.
    in-out property <string> name;
    in-out property <AccountKind> kind;
    in-out property <string> bank;
    in-out property <string> balance;
    // Cards and lines: the limit and the days of the month, as typed.
    in-out property <string> limit;
    in-out property <string> closing;
    in-out property <string> due;
    // The currency code; fixed once the account has movements.
    in-out property <string> currency;
    // The exchange rate typed when the chosen currency has none yet.
    in-out property <string> rate;
    // The picked currency has no rate yet; it opens on the main or the account's own, which never do.
    property <bool> needs-rate;
    // name, kind, bank, currency, balance, limit, closing day, due day, rate.
    callback save(string, AccountKind, string, string, string, string, string, string, string) -> string;
    callback toggle-archived() -> string;
    callback delete() -> string;
    callback cancel;

    property <string> error;
    // A card stays a card and an account stays an account, so the other kinds are not offered.
    // Credit kinds are picked in their own row when creating, so the plain kinds fit in one row.
    property <bool> credit: root.kind == AccountKind.credit || root.kind == AccountKind.credit-line;
    property <[AccountKind]> kinds: root.credit ? [] : [AccountKind.checking, AccountKind.demand, AccountKind.savings, AccountKind.cash];

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    function submit() {
        root.error = root.save(root.name, root.kind, root.bank, root.currency, root.balance, root.limit, root.closing, root.due, root.rate);
    }

    // Arrow keys move the choice, like the tabs they are drawn as.
    function step(delta: int) {
        let i = root.kind == AccountKind.checking ? 0 : root.kind == AccountKind.demand ? 1 : root.kind == AccountKind.savings ? 2 : root.kind == AccountKind.cash ? 3 : root.kind == AccountKind.credit ? 4 : 5;
        root.kind = root.kinds[max(0, min(root.kinds.length - 1, i + delta))];
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: root.kind == AccountKind.credit ? (root.editing ? @tr("Edit card") : @tr("New card")) : root.kind == AccountKind.credit-line ? (root.editing ? @tr("Edit credit line") : @tr("New credit line")) : (root.editing ? @tr("Edit account") : @tr("New account"));
            font-size: 14px;
            font-weight: 700;
        }

        InkField {
            text <=> root.name;
            placeholder-text: @tr("Account name");
            init => {
                self.focus();
            }
            accepted(text) => {
                root.submit();
            }
        }

        if !root.editing: HorizontalLayout {
            spacing: 0px;
            alignment: start;
            accessible-role: tab-list;
            SettingsTab {
                text: @tr("Account");
                selected: !root.credit;
                chosen => {
                    root.kind = AccountKind.checking;
                }
            }

            SettingsTab {
                text: Strings.account-kind(AccountKind.credit);
                selected: root.kind == AccountKind.credit;
                chosen => {
                    root.kind = AccountKind.credit;
                }
            }

            SettingsTab {
                text: Strings.account-kind(AccountKind.credit-line);
                selected: root.kind == AccountKind.credit-line;
                chosen => {
                    root.kind = AccountKind.credit-line;
                }
            }
        }

        if root.kinds.length > 1: HorizontalLayout {
            spacing: 0px;
            alignment: start;
            accessible-role: tab-list;
            for k in root.kinds: SettingsTab {
                text: Strings.account-kind(k);
                selected: root.kind == k;
                chosen => {
                    root.kind = k;
                }
                step(d) => {
                    root.step(d);
                }
            }
        }

        InkField {
            text <=> root.bank;
            placeholder-text: @tr("Bank (optional)");
            accepted(text) => {
                root.submit();
            }
        }

        Text {
            text: @tr("Currency");
            color: Theme.muted;
        }

        if root.in-use: Text {
            text: root.currency;
            accessible-description: @tr("Movements use this account, so its currency can't be changed.");
        }

        if !root.in-use: ScrollView {
            height: min(currency-list.preferred-height, 128px);
            currency-list := VerticalLayout {
                for c in FinanceStore.currencies: ChoiceRow {
                    label: c.code + " " + c.symbol;
                    icon: @image-url("../icons/wallet.svg");
                    chosen: c.code == root.currency;
                    picked => {
                        root.currency = c.code;
                        root.needs-rate = c.needs-rate;
                    }
                }
            }
        }

        // Asked only the first time a currency is used.
        if root.needs-rate: HorizontalLayout {
            spacing: 8px;
            Text {
                text: Strings.rate-prefix(root.currency);
                vertical-alignment: center;
            }

            InkField {
                text <=> root.rate;
                placeholder-text: @tr("Exchange rate");
                accepted(text) => {
                    root.submit();
                }
            }

            Text {
                text: FinanceStore.main-currency;
                vertical-alignment: center;
            }
        }

        if root.kind != AccountKind.credit: InkField {
            text <=> root.balance;
            placeholder-text: @tr("Initial balance");
            accepted(text) => {
                root.submit();
            }
        }

        if root.kind == AccountKind.credit || root.kind == AccountKind.credit-line: InkField {
            text <=> root.limit;
            placeholder-text: @tr("Credit limit");
            accepted(text) => {
                root.submit();
            }
        }

        if root.kind == AccountKind.credit: HorizontalLayout {
            spacing: 8px;
            InkField {
                text <=> root.closing;
                placeholder-text: @tr("Closing day (1-31)");
                accepted(text) => {
                    root.submit();
                }
            }

            InkField {
                text <=> root.due;
                placeholder-text: @tr("Payment day (1-31)");
                accepted(text) => {
                    root.submit();
                }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.critical;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            if root.editing: SubtleButton {
                text: root.archived ? @tr("Restore") : @tr("Archive");
                color: Palette.foreground;
                clicked => {
                    root.error = root.toggle-archived();
                }
            }

            // An account with movements can only be archived.
            if root.editing && !root.in-use: SubtleButton {
                text: @tr("Delete");
                color: Palette.foreground;
                clicked => {
                    confirm.show();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            SubtleButton {
                text: @tr("Cancel");
                color: Palette.foreground;
                clicked => {
                    root.cancel();
                }
            }

            InkButton {
                text: root.editing ? @tr("Save") : @tr("Create");
                clicked => {
                    root.submit();
                }
            }
        }
    }

    confirm := PopupWindow {
        x: (root.width - self.width) / 2;
        y: 72px;
        width: 320px;
        PopupSurface {
            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    text: Strings.delete-account-question(root.saved-name);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    SubtleButton {
                        text: @tr("Cancel");
                        color: Palette.foreground;
                        init => {
                            self.focus();
                        }
                        clicked => {
                            confirm.close();
                        }
                    }

                    InkButton {
                        text: @tr("Delete");
                        clicked => {
                            confirm.close();
                            root.error = root.delete();
                        }
                    }
                }
            }
        }
    }
}

// Creates an account or edits one, depending on how it is opened. Closing by clicking outside
// discards it.
export component AccountCreator inherits PopupWindow {
    // Set by the opener before show().
    in property <bool> editing;
    in property <int> account-id;
    in property <string> account-name;
    in property <AccountKind> account-kind;
    in property <string> account-bank;
    in property <string> account-balance;
    in property <string> account-limit;
    in property <string> account-closing;
    in property <string> account-due;
    in property <string> account-currency;
    in property <bool> account-archived;
    in property <bool> account-in-use;

    close-policy: close-on-click-outside;
    width: 400px;

    PopupSurface {
        CreatorBody {
            editing: root.editing;
            archived: root.account-archived;
            in-use: root.account-in-use;
            saved-name: root.account-name;
            name: root.account-name;
            kind: root.account-kind;
            bank: root.account-bank;
            balance: root.account-balance;
            limit: root.account-limit;
            closing: root.account-closing;
            due: root.account-due;
            currency: root.account-currency;
            save(name, kind, bank, currency, balance, limit, closing, due, rate) => {
                let error = kind == AccountKind.credit-line ? (root.editing ? FinanceStore.update-credit-line(root.account-id, name, bank, currency, balance, limit, rate) : FinanceStore.create-credit-line(name, bank, currency, balance, limit, rate)) : kind == AccountKind.credit ? (root.editing ? FinanceStore.update-card(root.account-id, name, bank, currency, limit, closing, due, rate) : FinanceStore.create-card(name, bank, currency, limit, closing, due, rate)) : (root.editing ? FinanceStore.update-account(root.account-id, name, kind, bank, currency, balance, rate) : FinanceStore.create-account(name, kind, bank, currency, balance, rate));
                if error == "" {
                    root.close();
                }
                return error;
            }
            toggle-archived => {
                let error = FinanceStore.archive-account(root.account-id, !root.account-archived);
                if error == "" {
                    root.close();
                }
                return error;
            }
            delete => {
                let error = FinanceStore.delete-account(root.account-id);
                if error == "" {
                    root.close();
                }
                return error;
            }
            cancel => {
                root.close();
            }
        }
    }
}
