import { ScrollView } from "std-widgets.slint";
import { EmptyState } from "../empty-state.slint";
import { Theme } from "../theme.slint";
import { AccountPreview } from "account-preview.slint";
import { AccountRow } from "account-row.slint";
import { AccountsCard, CardsCard } from "accounts-list.slint";
import { CreditUsageCard, NetWorthCard } from "accounts-side.slint";
import { FinanceStore } from "finance-store.slint";

// The accounts and cards with their balances on the left; net worth and credit use on the right.
export component AccountsTab inherits VerticalLayout {
    callback new-account();
    callback edit-account(AccountRow);

    property <string> error;

    // Archiving or restoring from a row; a refusal shows above the cards.
    function archive(a: AccountRow) {
        root.error = FinanceStore.archive-account(a.id, !a.archived);
    }

    if FinanceStore.accounts.length == 0 && FinanceStore.archived-accounts.length == 0: EmptyState {
        title: @tr("Add your first account");
        description: @tr("Register where your money is, such as a bank account or cash, with what it holds today. Every account shows its balance.");
        action: @tr("New account");
        clicked => {
            root.new-account();
        }

        AccountPreview { }
    }

    if FinanceStore.accounts.length > 0 || FinanceStore.archived-accounts.length > 0: ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: 12px;
            padding-right: 12px; // clears the scroll bar
            if root.error != "": Text {
                text: root.error;
                color: Theme.critical;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    horizontal-stretch: 3;
                    min-width: 0px;
                    preferred-width: 0px;
                    AccountsCard {
                        edit(a) => {
                            root.edit-account(a);
                        }
                        archive(a) => {
                            root.archive(a);
                        }
                    }

                    CardsCard {
                        edit(a) => {
                            root.edit-account(a);
                        }
                        archive(a) => {
                            root.archive(a);
                        }
                    }
                }

                VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    horizontal-stretch: 2;
                    min-width: 0px;
                    preferred-width: 0px;
                    NetWorthCard { }

                    CreditUsageCard { }
                }
            }
        }
    }
}
