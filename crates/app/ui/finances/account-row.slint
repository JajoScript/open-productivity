import { Date } from "std-widgets.slint";

export enum AccountKind { checking, demand, savings, cash, credit, credit-line }

// `balance` arrives formatted for display; `initial` formatted for the edit field.
export struct AccountRow {
    id: int,
    name: string,
    kind: AccountKind,
    bank: string,
    // The currency code.
    currency: string,
    balance: string,
    initial: string,
    archived: bool,
    // Some movement uses it, so it can only be archived.
    in-use: bool,
    // Cards and lines (empty or 0 otherwise): the limit formatted for the edit field and for
    // display, the days of the month, and the figures `core` computed.
    limit: string,
    limit-text: string,
    closing-day: int,
    due-day: int,
    used: string,
    // A card: the limit left. A plain account with reserves: the balance minus them; "" otherwise.
    available: string,
    // Used part of the limit in per mille; above 1000 when over it.
    use-permille: int,
    // The card's unpaid bill formatted, "" when there is none, and its due date.
    bill: string,
    bill-due: Date,
    over-limit: bool,
}

export struct CurrencyRow {
    code: string,
    symbol: string,
    // Not the main currency and no exchange rate yet: choosing it asks for one.
    needs-rate: bool,
}

// A non-main currency some account uses, with its rate to the main one formatted for the edit field.
export struct RateRow {
    code: string,
    rate: string,
}
