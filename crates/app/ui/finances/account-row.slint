export enum AccountKind { checking, demand, savings, cash }

// `balance` arrives formatted for display; `initial` formatted for the edit field.
export struct AccountRow {
    id: int,
    name: string,
    kind: AccountKind,
    bank: string,
    balance: string,
    initial: string,
}

export struct CurrencyRow {
    code: string,
    symbol: string,
}
