import { Strings } from "../strings.slint";
import { Theme } from "../theme.slint";
import { AccountKind } from "account-row.slint";
import { AccountColumns, AccountRowFrame } from "account-line.slint";

// A credit card or line: name with bank and terms, the unpaid bill when there is one, the limit.
export component CardLine inherits AccountRowFrame {
    property <string> terms: root.account.kind == AccountKind.credit-line ? Strings.account-kind(AccountKind.credit-line) : Strings.card-closes(root.account.closing-day);

    icon: @image-url("../icons/credit-card.svg");
    height: root.account.bill != "" ? 68px : 52px;
    label: Strings.account-line-label(root.account.name, Strings.card-used(root.account.used, root.account.limit-text), Strings.card-available(root.account.available));

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        min-width: 0px;
        preferred-width: 0px;
        opacity: root.account.archived ? 0.55 : 1;
        Text {
            text: root.account.name;
            font-weight: 600;
            overflow: elide;
            accessible-role: none;
        }

        Text {
            text: root.account.bank != "" ? root.account.bank + " · " + root.terms : root.terms;
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
            accessible-role: none;
        }

        if root.account.bill != "": Text {
            text: Strings.card-bill(root.account.bill, Strings.date(root.account.bill-due.day, root.account.bill-due.month, root.account.bill-due.year));
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
            accessible-role: none;
        }
    }

    Text {
        text: root.account.limit-text;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
        horizontal-alignment: right;
        width: AccountColumns.amount;
        opacity: root.account.archived ? 0.55 : 1;
        accessible-role: none;
    }
}
