import { Palette } from "std-widgets.slint";
import { Strings } from "../strings.slint";
import { Theme } from "../theme.slint";
import { AccountRow } from "account-row.slint";

// A credit card: its terms, what it used of the limit, what is left and a thin bar of the use.
export component CardLine inherits Rectangle {
    in property <AccountRow> account;
    callback opened;

    height: 72px;
    border-radius: 6px;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background {
        duration: Theme.fast;
        easing: Theme.ease-out;
    }
    forward-focus: focus;
    accessible-role: button;
    accessible-label: Strings.account-line-label(root.account.name, Strings.card-used(root.account.used, root.account.limit-text), Strings.card-available(root.account.available));
    accessible-action-default => {
        root.opened();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 16px; // clears the ListView scroll bar
        spacing: 8px;
        Image {
            source: @image-url("../icons/wallet.svg");
            colorize: Theme.muted;
            width: 16px;
            image-fit: contain;
            accessible-role: none;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.account.name;
                opacity: root.account.archived ? 0.55 : 1;
                overflow: elide;
                accessible-role: none;
            }

            Text {
                property <string> terms: root.account.bank != "" ? root.account.bank + " · " + Strings.card-terms(root.account.closing-day, root.account.due-day) : Strings.card-terms(root.account.closing-day, root.account.due-day);
                text: root.account.bill != "" ? self.terms + " · " + Strings.card-bill(root.account.bill, Strings.date(root.account.bill-due.day, root.account.bill-due.month, root.account.bill-due.year)) : self.terms;
                color: Theme.muted;
                overflow: elide;
                accessible-role: none;
            }

            Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: Theme.hairline;
                opacity: root.account.archived ? 0.55 : 1;
                Rectangle {
                    x: 0px;
                    width: parent.width * min(1, root.account.use-permille / 1000);
                    border-radius: parent.border-radius;
                    background: root.account.over-limit ? Theme.critical : Theme.ink;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            width: 220px; // fixed, so every card's bar ends at the same x
            Text {
                text: Strings.card-used(root.account.used, root.account.limit-text);
                opacity: root.account.archived ? 0.55 : 1;
                font-weight: 600;
                horizontal-alignment: right;
                accessible-role: none;
            }

            Text {
                text: Strings.card-available(root.account.available);
                color: root.account.over-limit ? Theme.critical : Theme.muted;
                horizontal-alignment: right;
                accessible-role: none;
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }

    touch := TouchArea {
        clicked => {
            root.opened();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.opened();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}
