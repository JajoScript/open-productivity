import { Palette, ListView } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { SettingsTab } from "../settings/settings-tab.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { AccountRow } from "account-row.slint";
import { AccountsTab } from "accounts-tab.slint";
import { CategoriesTab } from "categories-tab.slint";
import { CategoryRow } from "category-row.slint";
import { FinanceStore } from "finance-store.slint";
import { FinanceTab, TransactionRow } from "transaction-row.slint";
import { SummaryTab } from "summary-tab.slint";
import { DueTab } from "due-tab.slint";
import { BillRow } from "bill-row.slint";
import { ScheduledRow } from "scheduled-row.slint";
import { TransactionsTab } from "transactions-tab.slint";

// First use: the main currency has no default, the user chooses it once.
component CurrencyPicker inherits HorizontalLayout {
    property <string> chosen;
    property <string> error;

    alignment: center;
    vertical-stretch: 1;

    VerticalLayout {
        max-width: 440px;
        spacing: 6px;
        alignment: start;
        Text {
            text: @tr("Choose your main currency");
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: @tr("Your accounts and balances will use it. You can change it later.");
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        // The eleven rows, so the button sits right under them; scrolls on short windows.
        ListView {
            min-height: 120px;
            preferred-height: 396px;
            for c in FinanceStore.currencies: Rectangle {
                height: 36px;
                border-radius: 6px;
                background: root.chosen == c.code ? Theme.selected : t.pressed ? Theme.pressed : t.has-hover ? Theme.hover : transparent;
                accessible-role: radio-button;
                accessible-label: c.code + " " + c.symbol;
                accessible-checkable: true;
                accessible-checked: root.chosen == c.code;
                accessible-action-default => {
                    root.chosen = c.code;
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text {
                        text: c.code;
                        font-weight: root.chosen == c.code ? 700 : 400;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        accessible-role: none;
                    }

                    Text {
                        text: c.symbol;
                        color: Theme.muted;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }

                t := TouchArea {
                    clicked => {
                        root.chosen = c.code;
                    }
                }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.critical;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            InkButton {
                text: @tr("Confirm");
                enabled: root.chosen != "";
                clicked => {
                    root.error = FinanceStore.choose-currency(root.chosen);
                }
            }
        }
    }
}

// Summary, movements, accounts and categories in tabs; the main currency is chosen the first time.
export component FinancesView inherits VerticalLayout {
    // Open the window's modals: a new or existing account, a new or existing movement.
    callback new-account();
    callback edit-account(AccountRow);
    callback new-transaction();
    callback edit-transaction(TransactionRow);
    callback new-scheduled();
    callback edit-scheduled(ScheduledRow);
    callback confirm-scheduled(ScheduledRow);
    callback pay-bill(BillRow);
    callback new-category();
    callback edit-category(CategoryRow);
    callback edit-rates();
    callback edit-main-currency();

    padding: 24px;
    padding-top: 20px;
    spacing: 12px;

    function choose(tab: FinanceTab) {
        if FinanceStore.tab != tab {
            FinanceStore.tab = tab;
            FinanceStore.refresh();
        }
    }

    Text {
        text: @tr("Finances");
        font-size: 24px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }

    if FinanceStore.has-currency: HorizontalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 0px;
            alignment: start;
            accessible-role: tab-list;
            SettingsTab {
                text: @tr("Summary");
                selected: FinanceStore.tab == FinanceTab.summary;
                chosen => {
                    root.choose(FinanceTab.summary);
                }
                step(d) => {
                    if d > 0 {
                        root.choose(FinanceTab.movements);
                    }
                }
            }

            SettingsTab {
                text: @tr("Movements");
                selected: FinanceStore.tab == FinanceTab.movements;
                chosen => {
                    root.choose(FinanceTab.movements);
                }
                step(d) => {
                    root.choose(d < 0 ? FinanceTab.summary : FinanceTab.due);
                }
            }

            SettingsTab {
                text: @tr("To pay");
                selected: FinanceStore.tab == FinanceTab.due;
                chosen => {
                    root.choose(FinanceTab.due);
                }
                step(d) => {
                    root.choose(d < 0 ? FinanceTab.movements : FinanceTab.accounts);
                }
            }

            SettingsTab {
                text: @tr("Accounts");
                selected: FinanceStore.tab == FinanceTab.accounts;
                chosen => {
                    root.choose(FinanceTab.accounts);
                }
                step(d) => {
                    root.choose(d < 0 ? FinanceTab.due : FinanceTab.categories);
                }
            }

            SettingsTab {
                text: @tr("Categories");
                selected: FinanceStore.tab == FinanceTab.categories;
                chosen => {
                    root.choose(FinanceTab.categories);
                }
                step(d) => {
                    if d < 0 {
                        root.choose(FinanceTab.accounts);
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // With no accounts, the empty states carry the button.
        if FinanceStore.tab == FinanceTab.movements && FinanceStore.accounts.length > 0: InkButton {
            text: @tr("New movement");
            clicked => {
                root.new-transaction();
            }
        }

        if FinanceStore.tab == FinanceTab.due && FinanceStore.accounts.length > 0: InkButton {
            text: @tr("New scheduled payment");
            clicked => {
                root.new-scheduled();
            }
        }

        if FinanceStore.tab == FinanceTab.categories && FinanceStore.has-categories: InkButton {
            text: @tr("New category");
            clicked => {
                root.new-category();
            }
        }

        if FinanceStore.tab == FinanceTab.accounts: SubtleButton {
            text: Strings.main-currency-button(FinanceStore.main-currency);
            color: Palette.foreground;
            clicked => {
                root.edit-main-currency();
            }
        }

        if FinanceStore.tab == FinanceTab.accounts && FinanceStore.rates.length > 0: SubtleButton {
            text: @tr("Exchange rates");
            color: Palette.foreground;
            clicked => {
                root.edit-rates();
            }
        }

        if FinanceStore.tab == FinanceTab.accounts && (FinanceStore.accounts.length > 0 || FinanceStore.archived-accounts.length > 0): InkButton {
            text: @tr("New account");
            clicked => {
                root.new-account();
            }
        }
    }

    if FinanceStore.error != "": Text {
        text: FinanceStore.error;
        color: Theme.critical;
        wrap: word-wrap;
    }

    if !FinanceStore.has-currency: CurrencyPicker { }

    if FinanceStore.has-currency && FinanceStore.tab == FinanceTab.summary: SummaryTab {
        vertical-stretch: 1;
        edit-transaction(t) => {
            root.edit-transaction(t);
        }
    }

    if FinanceStore.has-currency && FinanceStore.tab == FinanceTab.movements: TransactionsTab {
        vertical-stretch: 1;
        new-account => {
            root.new-account();
        }
        edit-transaction(t) => {
            root.edit-transaction(t);
        }
    }

    if FinanceStore.has-currency && FinanceStore.tab == FinanceTab.due: DueTab {
        vertical-stretch: 1;
        new-account => {
            root.new-account();
        }
        edit-scheduled(d) => {
            root.edit-scheduled(d);
        }
        confirm-scheduled(d) => {
            root.confirm-scheduled(d);
        }
        pay-bill(b) => {
            root.pay-bill(b);
        }
    }

    if FinanceStore.has-currency && FinanceStore.tab == FinanceTab.accounts: AccountsTab {
        vertical-stretch: 1;
        new-account => {
            root.new-account();
        }
        edit-account(a) => {
            root.edit-account(a);
        }
    }

    if FinanceStore.has-currency && FinanceStore.tab == FinanceTab.categories: CategoriesTab {
        vertical-stretch: 1;
        new-category => {
            root.new-category();
        }
        edit-category(c) => {
            root.edit-category(c);
        }
    }
}
