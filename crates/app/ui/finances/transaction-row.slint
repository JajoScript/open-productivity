import { Date } from "std-widgets.slint";

export enum TxKind { expense, income }

export enum FinanceTab { summary, movements, accounts, categories }

// `amount` arrives signed (not for a transfer) and formatted for display; `input` formatted for the edit field.
export struct TransactionRow {
    id: int,
    kind: TxKind,
    // A transfer moves money from `account` to `to-account`; it has no kind nor category.
    transfer: bool,
    to-account-id: int,
    to-account: string,
    // The currency codes of the source and, for a transfer, the destination account.
    currency: string,
    to-currency: string,
    // The amount that arrives, formatted for the edit field; "" unless a transfer crosses currencies.
    to-input: string,
    account-id: int,
    account: string,
    has-category: bool,
    category-id: int,
    // "" without category.
    category: string,
    date: Date,
    description: string,
    amount: string,
    input: string,
}
