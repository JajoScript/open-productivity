import { Palette, ListView } from "std-widgets.slint";
import { EmptyState } from "../empty-state.slint";
import { Strings } from "../strings.slint";
import { Theme } from "../theme.slint";
import { FinanceStore } from "finance-store.slint";
import { SettingsTab } from "../settings/settings-tab.slint";
import { SubtleButton } from "../subtle-button.slint";
import { FinanceCard, FinanceCardHeader } from "finance-card.slint";
import { FinanceTableHeader, FinanceTxRow } from "finance-table.slint";
import { MovementFilter, TransactionRow } from "transaction-row.slint";

export component TransactionLine inherits Rectangle {
    in property <TransactionRow> tx;
    callback opened;

    property <string> title: root.tx.description != "" ? root.tx.description : root.tx.transfer ? Strings.transfer : Strings.tx-kind(root.tx.kind);
    property <string> day: Strings.date(root.tx.date.day, root.tx.date.month, root.tx.date.year);

    height: 56px;
    border-radius: 6px;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background {
        duration: Theme.fast;
        easing: Theme.ease-out;
    }
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.tx.transfer ? Strings.transfer-line-label(root.title, root.tx.account, root.tx.to-account, root.day, root.tx.amount) : Strings.transaction-line-label(root.title, root.tx.account, root.day, root.tx.amount);
    accessible-action-default => {
        root.opened();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 16px; // clears the ListView scroll bar
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                overflow: elide;
                accessible-role: none;
            }

            Text {
                text: root.tx.transfer ? Strings.transfer-detail(root.tx.account, root.tx.to-account, root.day) : root.tx.has-category ? Strings.transaction-detail-category(root.tx.category, root.tx.account, root.day) : Strings.transaction-detail(root.tx.account, root.day);
                color: Theme.muted;
                overflow: elide;
                accessible-role: none;
            }
        }

        Text {
            text: root.tx.amount;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: right;
            accessible-role: none;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }

    touch := TouchArea {
        clicked => {
            root.opened();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.opened();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}

// The movements of one month in a card: month navigation, kind filter and the table.
export component TransactionsTab inherits VerticalLayout {
    callback new-account();
    callback edit-transaction(TransactionRow);

    function filter(f: MovementFilter) {
        if FinanceStore.movement-filter != f {
            FinanceStore.movement-filter = f;
            FinanceStore.refresh();
        }
    }

    FinanceCard {
        vertical-stretch: 1;
        FinanceCardHeader {
            title: Strings.month-year(FinanceStore.month.month, FinanceStore.month.year);
            SubtleButton {
                icon: @image-url("../icons/chevron-left.svg");
                label: @tr("Previous month");
                color: Palette.foreground;
                clicked => {
                    FinanceStore.shift(-1);
                }
            }

            SubtleButton {
                icon: @image-url("../icons/chevron-right.svg");
                label: @tr("Next month");
                color: Palette.foreground;
                clicked => {
                    FinanceStore.shift(1);
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            accessible-role: tab-list;
            SettingsTab {
                text: @tr("movement filter" => "All");
                selected: FinanceStore.movement-filter == MovementFilter.all;
                chosen => {
                    root.filter(MovementFilter.all);
                }
                step(d) => {
                    if d > 0 {
                        root.filter(MovementFilter.income);
                    }
                }
            }

            SettingsTab {
                text: @tr("Income");
                selected: FinanceStore.movement-filter == MovementFilter.income;
                chosen => {
                    root.filter(MovementFilter.income);
                }
                step(d) => {
                    root.filter(d < 0 ? MovementFilter.all : MovementFilter.expense);
                }
            }

            SettingsTab {
                text: @tr("Expenses");
                selected: FinanceStore.movement-filter == MovementFilter.expense;
                chosen => {
                    root.filter(MovementFilter.expense);
                }
                step(d) => {
                    root.filter(d < 0 ? MovementFilter.income : MovementFilter.transfer);
                }
            }

            SettingsTab {
                text: @tr("Transfers");
                selected: FinanceStore.movement-filter == MovementFilter.transfer;
                chosen => {
                    root.filter(MovementFilter.transfer);
                }
                step(d) => {
                    if d < 0 {
                        root.filter(MovementFilter.expense);
                    }
                }
            }
        }

        if FinanceStore.transactions.length == 0: EmptyState {
            title: FinanceStore.accounts.length == 0 ? @tr("Create an account first") : @tr("No movements this month.");
            description: FinanceStore.accounts.length == 0 ? @tr("Expenses and income are recorded against an account. Add one, such as a bank account or cash, to start.") : @tr("Record what you spend and what you earn. Each movement updates the balance of its account.");
            action: FinanceStore.accounts.length == 0 ? @tr("New account") : "";
            clicked => {
                root.new-account();
            }
        }

        if FinanceStore.transactions.length > 0: VerticalLayout {
            vertical-stretch: 1;
            FinanceTableHeader {
                description: @tr("Description");
                account: @tr("Account");
                category: @tr("Category");
                date: @tr("Date");
                amount: @tr("Amount");
            }

            ListView {
                vertical-stretch: 1;
                for tx in FinanceStore.transactions: FinanceTxRow {
                    tx: tx;
                    opened => {
                        root.edit-transaction(tx);
                    }
                }
            }
        }
    }
}
