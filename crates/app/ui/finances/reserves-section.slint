import { Palette } from "std-widgets.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { ArchiveTabs } from "accounts-list.slint";
import { FinanceColumns } from "finance-table.slint";
import { FinanceStore } from "finance-store.slint";
import { ReserveRow } from "reserve-row.slint";

component ReserveLine inherits Rectangle {
    in property <ReserveRow> reserve;
    callback opened;

    height: 44px;
    border-radius: 6px;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background {
        duration: Theme.fast;
        easing: Theme.ease-out;
    }
    forward-focus: focus;
    accessible-role: button;
    accessible-label: Strings.reserve-line-label(root.reserve.name, root.reserve.account-name, root.reserve.balance);
    accessible-action-default => {
        root.opened();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: FinanceColumns.gap;
        Text {
            text: root.reserve.name;
            opacity: root.reserve.archived ? 0.55 : 1;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            accessible-role: none;
        }

        Text {
            text: "\{root.reserve.account-name} (\{root.reserve.currency})";
            color: Theme.muted;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            accessible-role: none;
        }

        Text {
            text: root.reserve.balance;
            opacity: root.reserve.archived ? 0.55 : 1;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 150px;
            accessible-role: none;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }

    touch := TouchArea {
        clicked => {
            root.opened();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.opened();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}

// The reserves of the accounts, active or archived, with what they hold; lives under the buckets.
export component ReservesSection inherits VerticalLayout {
    callback new-reserve();
    callback edit-reserve(ReserveRow);

    // Reserving and withdrawing work on the first active reserve, which the list puts first.
    property <bool> has-active: FinanceStore.reserves.length > 0 && !FinanceStore.reserves[0].archived;

    spacing: 12px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: @tr("Reserves");
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            text: Strings.reserved-line(FinanceStore.reserved-total);
            color: Theme.muted;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if FinanceStore.has-reservable: SubtleButton {
            text: @tr("Create");
            color: Palette.foreground;
            outlined: true;
            clicked => {
                root.new-reserve();
            }
        }

        SubtleButton {
            text: @tr("reserve action" => "Reserve");
            color: Palette.foreground;
            outlined: true;
            enabled: root.has-active;
            clicked => {
                root.edit-reserve(FinanceStore.reserves[0]);
            }
        }

        SubtleButton {
            text: @tr("Withdraw");
            color: Palette.foreground;
            outlined: true;
            enabled: root.has-active;
            clicked => {
                root.edit-reserve(FinanceStore.reserves[0]);
            }
        }
    }

    tabs := ArchiveTabs { }

    VerticalLayout {
        for reserve in FinanceStore.reserves: ReserveLine {
            reserve: reserve;
            visible: reserve.archived == tabs.archived;
            height: reserve.archived == tabs.archived ? 44px : 0px;
            opened => {
                root.edit-reserve(reserve);
            }
        }

        if FinanceStore.reserves.length == 0: Text {
            text: @tr("Nothing here.");
            color: Theme.muted;
            height: 40px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
