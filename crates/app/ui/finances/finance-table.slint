import { Palette } from "std-widgets.slint";
import { Strings } from "../strings.slint";
import { Theme } from "../theme.slint";
import { TransactionRow, TxKind } from "transaction-row.slint";

// Column sizes shared by the header and the rows so they line up: the icon, the date and the
// amount are fixed; description, account and category share what is left by weight.
export global FinanceColumns {
    out property <length> icon: 20px;
    out property <length> date: 64px;
    out property <length> amount: 184px;
    out property <float> description: 3;
    out property <float> account: 3;
    out property <float> category: 2;
    out property <length> gap: 12px;
}

export component HeaderLabel inherits Text {
    color: Theme.muted;
    font-size: 11px;
    font-weight: 600;
    vertical-alignment: center;
    overflow: elide;
}

// The column titles; an empty one leaves its column blank.
export component FinanceTableHeader inherits HorizontalLayout {
    in property <string> description;
    in property <string> account;
    in property <string> category;
    in property <string> date;
    in property <string> amount;

    height: 28px;
    padding-left: 8px;
    padding-right: 16px; // clears the ListView scroll bar
    spacing: FinanceColumns.gap;
    accessible-role: none;

    Rectangle {
        width: FinanceColumns.icon;
    }

    HeaderLabel {
        text: root.description.to-uppercase();
        horizontal-stretch: FinanceColumns.description;
        min-width: 0px;
        preferred-width: 0px;
    }

    HeaderLabel {
        text: root.account.to-uppercase();
        horizontal-stretch: FinanceColumns.account;
        min-width: 0px;
        preferred-width: 0px;
    }

    HeaderLabel {
        text: root.category.to-uppercase();
        horizontal-stretch: FinanceColumns.category;
        min-width: 0px;
        preferred-width: 0px;
    }

    HeaderLabel {
        text: root.date.to-uppercase();
        width: FinanceColumns.date;
    }

    HeaderLabel {
        text: root.amount.to-uppercase();
        width: FinanceColumns.amount;
        horizontal-alignment: right;
    }
}

// One movement as a table row: direction icon, description, account, category, date, amount.
export component FinanceTxRow inherits Rectangle {
    in property <TransactionRow> tx;
    callback opened;

    property <string> title: root.tx.description != "" ? root.tx.description : root.tx.transfer ? Strings.transfer : root.tx.has-category ? root.tx.category : Strings.tx-kind(root.tx.kind);
    property <string> day: Strings.date(root.tx.date.day, root.tx.date.month, root.tx.date.year);
    property <string> accounts: root.tx.transfer ? Strings.transfer-accounts(root.tx.account, root.tx.to-account) : root.tx.account;
    property <image> direction: root.tx.transfer ? @image-url("../icons/arrow-left-right.svg") : root.tx.kind == TxKind.income ? @image-url("../icons/arrow-up-right.svg") : @image-url("../icons/arrow-down-right.svg");

    height: 44px;
    border-radius: 6px;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background {
        duration: Theme.fast;
        easing: Theme.ease-out;
    }
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.tx.transfer ? Strings.transfer-line-label(root.title, root.tx.account, root.tx.to-account, root.day, root.tx.amount) : Strings.transaction-line-label(root.title, root.tx.account, root.day, root.tx.amount);
    accessible-action-default => {
        root.opened();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 16px; // clears the ListView scroll bar
        spacing: FinanceColumns.gap;
        Rectangle {
            width: FinanceColumns.icon;
            Image {
                source: root.direction;
                colorize: Theme.ink;
                width: 16px;
                height: 16px;
                accessible-role: none;
            }
        }

        Text {
            text: root.title;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: FinanceColumns.description;
            min-width: 0px;
            preferred-width: 0px;
            accessible-role: none;
        }

        Text {
            text: root.accounts;
            color: Theme.muted;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: FinanceColumns.account;
            min-width: 0px;
            preferred-width: 0px;
            accessible-role: none;
        }

        Text {
            text: root.tx.has-category ? root.tx.category : "—";
            color: Theme.muted;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: FinanceColumns.category;
            min-width: 0px;
            preferred-width: 0px;
            accessible-role: none;
        }

        Text {
            text: Strings.short-date(root.tx.date.day, root.tx.date.month);
            color: Theme.muted;
            overflow: elide;
            vertical-alignment: center;
            width: FinanceColumns.date;
            accessible-role: none;
        }

        Text {
            text: root.tx.amount;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: FinanceColumns.amount;
            accessible-role: none;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }

    touch := TouchArea {
        clicked => {
            root.opened();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.opened();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}
