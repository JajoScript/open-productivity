import { Date, Palette } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { InkDatePopup } from "../ink-date-popup.slint";
import { InkField } from "../ink-field.slint";
import { InkFieldButton } from "../ink-field-button.slint";
import { InkOption, InkSelect } from "../ink-select.slint";
import { FormField } from "../form-field.slint";
import { PopupSurface } from "../popup-surface.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { FinanceStore } from "finance-store.slint";
import { ScheduleForm, ScheduledRow } from "scheduled-row.slint";
import { TxKind } from "transaction-row.slint";

// Rebuilt on every show(), so the fields and the error always start fresh.
component ScheduledBody inherits FocusScope {
    in property <bool> editing;
    // The payment being edited, or the blank one; its account stays pickable even if archived.
    in property <ScheduledRow> due;
    in-out property <TxKind> kind;
    in-out property <int> account-id;
    in-out property <string> currency;
    in-out property <bool> has-category;
    in-out property <int> category-id;
    in-out property <string> amount;
    in-out property <string> description;
    in-out property <Date> date;
    in-out property <ScheduleForm> form;
    in-out property <string> installments;
    callback save(TxKind, int, bool, int, string, string, Date, ScheduleForm, string) -> string;
    callback delete() -> string;
    callback cancel;

    property <string> error;
    property <bool> recurring: root.form == ScheduleForm.weekly || root.form == ScheduleForm.monthly || root.form == ScheduleForm.yearly;
    // What the selects show for the chosen ids.
    property <string> account-name;
    property <string> category-name;

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    function submit() {
        root.error = root.save(root.kind, root.account-id, root.has-category, root.category-id, root.amount, root.description, root.date, root.form, root.installments);
    }

    function set-kind(kind: TxKind) {
        if root.kind != kind {
            root.has-category = false;
        }
        root.kind = kind;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: root.editing ? @tr("Edit scheduled payment") : @tr("New scheduled payment");
            font-size: 14px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 12px;
            // The kind of a saved payment does not change.
            if !root.editing: FormField {
                label: @tr("Type");
                InkSelect {
                    label: @tr("Type");
                    text: Strings.tx-kind(root.kind);
                    InkOption {
                        label: Strings.tx-kind(TxKind.expense);
                        chosen: root.kind == TxKind.expense;
                        picked => {
                            root.set-kind(TxKind.expense);
                        }
                    }

                    InkOption {
                        label: Strings.tx-kind(TxKind.income);
                        chosen: root.kind == TxKind.income;
                        picked => {
                            root.set-kind(TxKind.income);
                        }
                    }
                }
            }

            FormField {
                label: root.currency == "" ? @tr("Amount") : @tr("Amount ({})", root.currency);
                InkField {
                    text <=> root.amount;
                    placeholder-text: @tr("Amount");
                    init => {
                        self.focus();
                    }
                    accepted(text) => {
                        root.submit();
                    }
                }
            }
        }

        // The form of a saved payment is fixed; only a recurring one changes its frequency.
        if !root.editing || root.recurring: FormField {
            label: @tr("Recurring");
            InkSelect {
                label: @tr("Recurring");
                text: root.form == ScheduleForm.once ? @tr("One-time") : root.form == ScheduleForm.installments ? @tr("Installments") : Strings.schedule-form(root.form, 0, 0);
                if !root.editing: InkOption {
                    label: @tr("One-time");
                    chosen: root.form == ScheduleForm.once;
                    picked => {
                        root.form = ScheduleForm.once;
                    }
                }

                InkOption {
                    label: Strings.schedule-form(ScheduleForm.weekly, 0, 0);
                    chosen: root.form == ScheduleForm.weekly;
                    picked => {
                        root.form = ScheduleForm.weekly;
                    }
                }

                InkOption {
                    label: Strings.schedule-form(ScheduleForm.monthly, 0, 0);
                    chosen: root.form == ScheduleForm.monthly;
                    picked => {
                        root.form = ScheduleForm.monthly;
                    }
                }

                InkOption {
                    label: Strings.schedule-form(ScheduleForm.yearly, 0, 0);
                    chosen: root.form == ScheduleForm.yearly;
                    picked => {
                        root.form = ScheduleForm.yearly;
                    }
                }

                if !root.editing: InkOption {
                    label: @tr("Installments");
                    chosen: root.form == ScheduleForm.installments;
                    picked => {
                        root.form = ScheduleForm.installments;
                    }
                }
            }
        }

        if root.form == ScheduleForm.installments && !root.editing: FormField {
            label: @tr("Installments");
            InkField {
                text <=> root.installments;
                placeholder-text: @tr("Number of installments (2 or more)");
                accepted(text) => {
                    root.submit();
                }
            }
        }

        FormField {
            label: @tr("Account");
            InkSelect {
                label: @tr("Account");
                text: root.account-name;
                for account in FinanceStore.accounts: InkOption {
                    label: account.name;
                    chosen: account.id == root.account-id;
                    picked => {
                        root.account-id = account.id;
                        root.account-name = account.name;
                        root.currency = account.currency;
                    }
                }

                // The archived account the payment already has stays pickable.
                for account in FinanceStore.archived-accounts: VerticalLayout {
                    if account.id == root.due.account-id: InkOption {
                        label: Strings.archived-account(account.name);
                        chosen: account.id == root.account-id;
                        picked => {
                            root.account-id = account.id;
                            root.account-name = Strings.archived-account(account.name);
                            root.currency = account.currency;
                        }
                    }
                }
            }
        }

        FormField {
            label: @tr("Category");
            InkSelect {
                label: @tr("Category");
                text: root.has-category ? root.category-name : @tr("No category");
                InkOption {
                    label: @tr("No category");
                    chosen: !root.has-category;
                    picked => {
                        root.has-category = false;
                    }
                }

                // Those of the kind, and the archived one the payment already has.
                for c in FinanceStore.category-choices: VerticalLayout {
                    if c.kind == root.kind && (!c.archived || (root.has-category && c.id == root.category-id)): InkOption {
                        label: c.archived ? Strings.archived-category(c.name) : c.name;
                        chosen: root.has-category && c.id == root.category-id;
                        picked => {
                            root.has-category = true;
                            root.category-id = c.id;
                            root.category-name = c.archived ? Strings.archived-category(c.name) : c.name;
                        }
                    }
                }
            }
        }

        FormField {
            label: root.editing ? @tr("Next date") : @tr("First date");
            Rectangle {
                height: 36px;
                picker := InkDatePopup {
                    y: 38px;
                    day: root.date.day;
                    month: root.date.month;
                    year: root.date.year;
                    picked(date) => {
                        root.date = date;
                    }
                }

                InkFieldButton {
                    label: root.editing ? @tr("Next date") : @tr("First date");
                    text: Strings.date(root.date.day, root.date.month, root.date.year);
                    icon: @image-url("../icons/calendar.svg");
                    clicked => {
                        picker.show();
                    }
                }
            }
        }

        FormField {
            label: @tr("Description");
            InkField {
                text <=> root.description;
                placeholder-text: @tr("Optional");
                accepted(text) => {
                    root.submit();
                }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.critical;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            if root.editing: SubtleButton {
                text: @tr("Delete");
                color: Palette.foreground;
                clicked => {
                    confirm.show();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            SubtleButton {
                text: @tr("Cancel");
                color: Palette.foreground;
                clicked => {
                    root.cancel();
                }
            }

            InkButton {
                text: root.editing ? @tr("Save") : @tr("Create");
                clicked => {
                    root.submit();
                }
            }
        }
    }

    // The opener gives ids; these fill in the names the selects show, once, when the form is built.
    for account in FinanceStore.accounts: Rectangle {
        width: 0px;
        height: 0px;
        init => {
            if account.id == root.account-id {
                root.account-name = account.name;
            }
        }
    }

    for account in FinanceStore.archived-accounts: Rectangle {
        width: 0px;
        height: 0px;
        init => {
            if account.id == root.account-id {
                root.account-name = Strings.archived-account(account.name);
            }
        }
    }

    for c in FinanceStore.category-choices: Rectangle {
        width: 0px;
        height: 0px;
        init => {
            if root.has-category && c.id == root.category-id {
                root.category-name = c.archived ? Strings.archived-category(c.name) : c.name;
            }
        }
    }

    confirm := PopupWindow {
        x: (root.width - self.width) / 2;
        y: 72px;
        width: 320px;
        PopupSurface {
            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    text: Strings.delete-scheduled-question(root.description != "" ? root.description : Strings.tx-kind(root.kind));
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    SubtleButton {
                        text: @tr("Cancel");
                        color: Palette.foreground;
                        init => {
                            self.focus();
                        }
                        clicked => {
                            confirm.close();
                        }
                    }

                    InkButton {
                        text: @tr("Delete");
                        clicked => {
                            confirm.close();
                            root.error = root.delete();
                        }
                    }
                }
            }
        }
    }
}

// Creates a scheduled payment or edits one, depending on how it is opened. Closing by clicking
// outside discards it.
export component ScheduledCreator inherits PopupWindow {
    // Set by the opener before show().
    in property <bool> editing;
    in property <ScheduledRow> due;

    // A payment was scheduled (not edited or deleted), just before the modal closes.
    callback saved;

    close-policy: close-on-click-outside;
    width: 440px;

    PopupSurface {
        ScheduledBody {
            editing: root.editing;
            due: root.due;
            kind: root.due.kind;
            account-id: root.due.account-id;
            currency: root.due.currency;
            has-category: root.due.has-category;
            category-id: root.due.category-id;
            amount: root.due.input;
            description: root.due.description;
            date: root.due.next-date;
            form: root.due.form;
            installments: "";
            save(kind, account, has-category, category, amount, description, date, form, installments) => {
                let error = root.editing ? FinanceStore.update-scheduled(root.due.id, account, has-category, category, amount, description, date, form) : FinanceStore.create-scheduled(kind, account, has-category, category, amount, description, date, form, installments);
                if error == "" {
                    if !root.editing {
                        root.saved();
                    }
                    root.close();
                }
                return error;
            }
            delete => {
                let error = FinanceStore.delete-scheduled(root.due.id);
                if error == "" {
                    root.close();
                }
                return error;
            }
            cancel => {
                root.close();
            }
        }
    }
}
