import { Palette, ScrollView } from "std-widgets.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { FinanceStore } from "finance-store.slint";
import { AccountsCard } from "summary-accounts.slint";
import { BalanceCard } from "summary-balance.slint";
import { CategoryCard } from "summary-category.slint";
import { KpiCard } from "summary-kpi.slint";
import { LatestCard } from "summary-latest.slint";
import { SummaryCardKind } from "summary-row.slint";
import { UpcomingCard } from "summary-upcoming.slint";
import { TransactionRow } from "transaction-row.slint";

// The month at a glance: four KPIs, the balance chart beside the category donut, then the
// latest movements, the upcoming payments and the accounts.
export component SummaryTab inherits ScrollView {
    callback edit-transaction(TransactionRow);

    VerticalLayout {
        alignment: start;
        spacing: 12px;
        padding-right: 16px; // clears the scroll bar
        padding-bottom: 24px;
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: Strings.month-year(FinanceStore.month.month, FinanceStore.month.year);
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            SubtleButton {
                icon: @image-url("../icons/chevron-left.svg");
                label: @tr("Previous month");
                color: Palette.foreground;
                clicked => {
                    FinanceStore.shift(-1);
                }
            }

            SubtleButton {
                icon: @image-url("../icons/chevron-right.svg");
                label: @tr("Next month");
                color: Palette.foreground;
                clicked => {
                    FinanceStore.shift(1);
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            SubtleButton {
                text: @tr("Today");
                color: Palette.foreground;
                outlined: true;
                clicked => {
                    FinanceStore.shift(0);
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            KpiCard {
                label: @tr("Total balance");
                data: FinanceStore.summary-total;
                kind: SummaryCardKind.total;
            }

            KpiCard {
                label: @tr("Balance");
                data: FinanceStore.summary-balance;
                kind: SummaryCardKind.balance;
            }

            KpiCard {
                label: @tr("summary card" => "Income");
                data: FinanceStore.summary-income;
                kind: SummaryCardKind.income;
            }

            KpiCard {
                label: @tr("Expenses");
                data: FinanceStore.summary-expense;
                kind: SummaryCardKind.expense;
            }
        }

        if FinanceStore.rates.length > 0: Text {
            text: Strings.rates-note;
            color: Theme.muted;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 12px;
            BalanceCard { }

            CategoryCard { }
        }

        LatestCard {
            edit-transaction(t) => {
                root.edit-transaction(t);
            }
        }

        UpcomingCard { }

        AccountsCard { }
    }
}
