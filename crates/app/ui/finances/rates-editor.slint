import { Palette, ScrollView } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { InkField } from "../ink-field.slint";
import { PopupSurface } from "../popup-surface.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { FinanceStore } from "finance-store.slint";

// Rebuilt on every show(), so the fields and the error always start fresh.
component EditorBody inherits FocusScope {
    callback cancel;

    property <string> error;

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    init => {
        // Drops what a previous, discarded edit left behind.
        FinanceStore.discard-rates();
    }

    function submit() {
        root.error = FinanceStore.save-rates();
        if root.error == "" {
            root.cancel();
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: @tr("Exchange rates");
            font-size: 14px;
            font-weight: 700;
        }

        Text {
            text: @tr("What one unit of each currency is worth in your main currency. Every total uses these rates.");
            color: Theme.muted;
            wrap: word-wrap;
        }

        ScrollView {
            height: min(list.preferred-height, 240px);
            list := VerticalLayout {
                spacing: 8px;
                for r in FinanceStore.rates: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Strings.rate-prefix(r.code);
                        min-width: 72px;
                        vertical-alignment: center;
                    }

                    InkField {
                        text: r.rate;
                        placeholder-text: @tr("Exchange rate");
                        edited(text) => {
                            FinanceStore.edit-rate(r.code, text);
                        }
                        accepted(text) => {
                            root.submit();
                        }
                    }

                    Text {
                        text: FinanceStore.main-currency;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.critical;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
            }

            SubtleButton {
                text: @tr("Cancel");
                color: Palette.foreground;
                clicked => {
                    root.cancel();
                }
            }

            InkButton {
                text: @tr("Save");
                clicked => {
                    root.submit();
                }
            }
        }
    }
}

// Edits the exchange rate of every non-main currency in use. Closing by clicking outside
// discards the changes.
export component RatesEditor inherits PopupWindow {
    close-policy: close-on-click-outside;
    width: 400px;

    PopupSurface {
        EditorBody {
            cancel => {
                root.close();
            }
        }
    }
}
