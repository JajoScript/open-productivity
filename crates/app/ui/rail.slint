import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One per built module; a module joins the rail when its first slice ships.
export enum Module { tasks, habits, settings }

// Label beside a rail icon: fades in over the second half of the rail's opening and slides in 8px.
component RailLabel inherits Text {
    in property <float> reveal;

    x: 48px - (1 - root.reveal) * 8px;
    vertical-alignment: center;
    overflow: elide;
    opacity: max(0, root.reveal * 2 - 1);
    accessible-role: none;
}

component RailButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    // 0 collapsed, 1 fully open.
    in property <float> reveal;
    out property <bool> focused: focus.has-focus;
    callback clicked;

    height: 40px;
    border-radius: 6px;
    background: root.selected ? Theme.selected : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }
    forward-focus: focus;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    // Pinned to the left, so the icon stays put while the rail opens.
    Image {
        x: 10px;
        source: root.icon;
        colorize: root.selected ? Palette.foreground : Theme.muted;
        width: 20px;
        height: 20px;
        accessible-role: none;
    }

    RailLabel {
        width: parent.width - self.x - 8px;
        text: root.label;
        reveal: root.reveal;
        color: root.selected ? Palette.foreground : Theme.muted;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}

// Icon rail that switches between the app's modules. It opens over the content on hover or
// keyboard focus to show the module names; the window keeps only the collapsed width for it.
export component Rail inherits Rectangle {
    in-out property <Module> module;

    property <length> collapsed: 56px;
    property <length> open: 200px;
    property <bool> expanded: hover.has-hover || tasks.focused || habits.focused || settings.focused;
    // Derived from the animated width, so the labels move in step with the panel.
    property <float> reveal: (root.width - root.collapsed) / (root.open - root.collapsed);

    width: root.collapsed;
    background: Palette.alternate-background;
    clip: true;

    states [
        opened when root.expanded: {
            width: root.open;
            // Hover intent: a pointer passing through does not open it.
            in {
                animate width { duration: Theme.enter; delay: 250ms; easing: Theme.ease-out; }
            }
            out {
                animate width { duration: Theme.fast; easing: Theme.ease-out; }
            }
        }
    ]

    // Wraps the buttons, so it keeps its hover while the pointer is over them.
    hover := TouchArea {
        VerticalLayout {
            padding: 8px;
            padding-top: 16px;
            spacing: 4px;

            Rectangle {
                height: 24px;
                Image {
                    x: 0px;
                    width: 40px;
                    height: parent.height;
                    source: @image-url("app-icons/fill-black.svg");
                    colorize: Palette.foreground;
                    image-fit: contain;
                    accessible-role: image;
                    accessible-label: "Open Productivity";
                }

                RailLabel {
                    width: parent.width - self.x;
                    text: "Open Productivity";
                    font-weight: 600;
                    reveal: root.reveal;
                }
            }

            Rectangle {
                height: 12px;
            }

            tasks := RailButton {
                icon: @image-url("icons/list-todo.svg");
                label: @tr("Tasks");
                reveal: root.reveal;
                selected: root.module == Module.tasks;
                clicked => {
                    root.module = Module.tasks;
                }
            }

            habits := RailButton {
                icon: @image-url("icons/repeat.svg");
                label: @tr("Habits");
                reveal: root.reveal;
                selected: root.module == Module.habits;
                clicked => {
                    root.module = Module.habits;
                }
            }

            // Takes the spare height, pinning Settings to the bottom.
            Rectangle {
                vertical-stretch: 1;
            }

            settings := RailButton {
                icon: @image-url("icons/settings.svg");
                label: @tr("Settings");
                reveal: root.reveal;
                selected: root.module == Module.settings;
                clicked => {
                    root.module = Module.settings;
                }
            }
        }
    }

    // Hairline between the rail and the content; the only edge, as the rail casts no shadow.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.hairline;
    }
}
