// Messages shown by native dialogs and the log; msgids are English, see lang/README.md.
export global Strings {
    out property <string> already-running: @tr("Open Productivity is already running.");
    out property <string> pick-folder: @tr("Choose the folder where your data will be stored");
    out property <string> newer-schema: @tr("This instance was created with a newer version of Open Productivity. Update the application to open it.");
    out property <string> missing-arg: @tr("The folder after --instance is missing.");
    out property <string> corrupt-registry: @tr("The instance list file is damaged and will be replaced when you choose a folder.");

    public pure function no-instance-here(path: string) -> string {
        return @tr("There is no Open Productivity instance in {}. Create a new one here?", path);
    }

    public pure function folder-not-found(path: string) -> string {
        return @tr("The instance folder was not found: {}. Choose another one.", path);
    }

    public pure function db-failed(error: string) -> string {
        return @tr("Could not open the database: {}", error);
    }

    public pure function failed(error: string) -> string {
        return @tr("Unexpected error: {}", error);
    }

    out property <string> habit-empty-name: @tr("Give the habit a name.");
    out property <string> habit-no-days: @tr("Pick at least one day.");
    out property <string> habit-future-start: @tr("The start date can't be in the future.");

    // Monday-first initials of the weekday toggles; the context keeps equal English letters apart.
    out property <[string]> day-letters: [@tr("Monday initial" => "M"), @tr("Tuesday initial" => "T"), @tr("Wednesday initial" => "W"), @tr("Thursday initial" => "T"), @tr("Friday initial" => "F"), @tr("Saturday initial" => "S"), @tr("Sunday initial" => "S")];

    public pure function habit-failed(error: string) -> string {
        return @tr("Could not save the habit: {}", error);
    }

    public pure function task-failed(error: string) -> string {
        return @tr("Could not save the task: {}", error);
    }

    public pure function calendar-failed(error: string) -> string {
        return @tr("Could not load the calendar: {}", error);
    }

    // Tasks of a calendar day that do not fit in its cell.
    public pure function more-tasks(n: int) -> string {
        return @tr("+{}", n);
    }

    public pure function settings-failed(error: string) -> string {
        return @tr("Could not save the settings: {}", error);
    }

    public pure function open-failed(error: string) -> string {
        return @tr("Could not open the link: {}", error);
    }

    public pure function synced-warning(path: string) -> string {
        return @tr("{} looks like a synced folder (OneDrive, Dropbox, Google Drive). SQLite can lose or corrupt changes there. Use it anyway?", path);
    }

    public pure function already-instance(path: string) -> string {
        return @tr("{} is already an instance. Use Open folder to open it.", path);
    }

    public pure function instances-failed(error: string) -> string {
        return @tr("Could not change the instances: {}", error);
    }

    out property <string> export-title: @tr("Export a copy");

    public pure function export-done(path: string) -> string {
        return @tr("Copy saved to {}", path);
    }

    public pure function export-failed(error: string) -> string {
        return @tr("Could not export the copy: {}", error);
    }

    public pure function list-failed(error: string) -> string {
        return @tr("Could not save the list: {}", error);
    }

    out property <string> title-empty: @tr("The title can't be empty.");
    out property <string> list-exists: @tr("A list with that name already exists.");
    out property <string> list-name-empty: @tr("The name can't be empty.");
    out property <string> time-invalid: @tr("Enter the time as HH:MM, like 09:30.");
    out property <string> time-needs-date: @tr("A time needs a due date.");
    out property <string> end-needs-start: @tr("Set a start time before the end.");
    out property <string> end-not-after-start: @tr("The end must be after the start.");
    out property <string> task-title-empty: @tr("Write a title for the task.");

    // English is month/day/year; translations may reorder the placeholders.
    public pure function date(day: int, month: int, year: int) -> string {
        return @tr("{1}/{0}/{2}", day, month, year);
    }

    // Date picker header, e.g. "November 2026"; translations may add words ("de").
    public pure function month-year(month: int, year: int) -> string {
        return @tr("{0} {1}", month-name(month), year);
    }

    // Header of the Tasks module, e.g. "Thursday, November 5"; translations reorder it.
    public pure function long-date(day: int, month: int, weekday: int) -> string {
        return @tr("{0}, {1} {2}", weekday-name(weekday), month-name(month), day);
    }

    // Week tab title, e.g. "November 2 – November 8"; translations reorder it.
    public pure function week-range(start-day: int, start-month: int, end-day: int, end-month: int) -> string {
        return @tr("{1} {0} – {3} {2}", start-day, month-name(start-month), end-day, month-name(end-month));
    }

    // Block of seven days in the habits grid.
    public pure function week-label(n: int) -> string {
        return @tr("WK {}", n);
    }

    // Streak, best streak and share of the month done, under a habit name.
    public pure function habit-streaks(streak: int, best: int) -> string {
        return @tr("Streak {} · Best {}", streak, best);
    }

    // Header of the habits section in Today of Tasks.
    public pure function habits-today(done: int, total: int) -> string {
        return @tr("HABITS · {}/{}", done, total);
    }

    public pure function tasks-today(done: int, total: int) -> string {
        return @tr("TASKS · {}/{}", done, total);
    }

    // Habits done out of those that applied in a block of seven days, and the share.
    public pure function week-total(done: int, applicable: int, pct: int) -> string {
        return @tr("{}/{} {}%", done, applicable, pct);
    }

    public pure function percent(pct: int) -> string {
        return @tr("{}%", pct);
    }

    // 0 is Monday.
    public pure function weekday-name(weekday: int) -> string {
        return weekday == 0 ? @tr("Monday") : weekday == 1 ? @tr("Tuesday") : weekday == 2 ? @tr("Wednesday") : weekday == 3 ? @tr("Thursday") : weekday == 4 ? @tr("Friday") : weekday == 5 ? @tr("Saturday") : @tr("Sunday");
    }

    pure function month-name(month: int) -> string {
        return month == 1 ? @tr("January") : month == 2 ? @tr("February") : month == 3 ? @tr("March") : month == 4 ? @tr("April") : month == 5 ? @tr("May") : month == 6 ? @tr("June") : month == 7 ? @tr("July") : month == 8 ? @tr("August") : month == 9 ? @tr("September") : month == 10 ? @tr("October") : month == 11 ? @tr("November") : @tr("December");
    }

    // Monday-first column heads of the date picker.
    // Hour label of the week grid's left column; the same in every language.
    public pure function hour(h: int) -> string {
        return h < 10 ? "0\{h}:00" : "\{h}:00";
    }

    out property <[string]> weekdays: [@tr("Mo"), @tr("Tu"), @tr("We"), @tr("Th"), @tr("Fr"), @tr("Sa"), @tr("Su")];
}
