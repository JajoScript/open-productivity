import { AccountKind } from "finances/account-row.slint";
import { ScheduleForm } from "finances/scheduled-row.slint";
import { TxKind } from "finances/transaction-row.slint";
import { SuggestedCategory } from "finances/category-row.slint";

// Messages shown by native dialogs and the log; msgids are English, see lang/README.md.
export global Strings {
    out property <string> already-running: @tr("Open Productivity is already running.");
    out property <string> pick-folder: @tr("Choose the folder where your data will be stored");
    out property <string> newer-schema: @tr("This instance was created with a newer version of Open Productivity. Update the application to open it.");
    out property <string> missing-arg: @tr("The folder after --instance is missing.");
    out property <string> corrupt-registry: @tr("The instance list file is damaged and will be replaced when you choose a folder.");

    public pure function no-instance-here(path: string) -> string {
        return @tr("There is no Open Productivity instance in {}. Create a new one here?", path);
    }

    public pure function folder-not-found(path: string) -> string {
        return @tr("The instance folder was not found: {}. Choose another one.", path);
    }

    public pure function db-failed(error: string) -> string {
        return @tr("Could not open the database: {}", error);
    }

    public pure function failed(error: string) -> string {
        return @tr("Unexpected error: {}", error);
    }

    out property <string> habit-empty-name: @tr("Give the habit a name.");
    out property <string> habit-no-days: @tr("Pick at least one day.");
    out property <string> habit-future-start: @tr("The start date can't be in the future.");
    out property <string> habit-not-found: @tr("That habit no longer exists.");
    out property <string> habit-future-day: @tr("That day hasn't happened yet.");
    out property <string> habit-before-start: @tr("The habit hadn't started on that day.");
    out property <string> habit-not-scheduled: @tr("The habit doesn't apply on that weekday.");
    out property <string> habit-future-month: @tr("That month hasn't happened yet.");
    out property <string> habit-month-out-of-range: @tr("That month is out of range.");

    // Monday-first initials of the weekday toggles; the context keeps equal English letters apart.
    out property <[string]> day-letters: [@tr("Monday initial" => "M"), @tr("Tuesday initial" => "T"), @tr("Wednesday initial" => "W"), @tr("Thursday initial" => "T"), @tr("Friday initial" => "F"), @tr("Saturday initial" => "S"), @tr("Sunday initial" => "S")];

    public pure function habit-failed(error: string) -> string {
        return @tr("Could not save the habit: {}", error);
    }

    out property <string> study-empty-name: @tr("Give the subject a name.");
    out property <string> study-empty-title: @tr("Give the topic a title.");
    out property <string> study-bad-minutes: @tr("Enter the minutes as a whole number, like 45.");
    out property <string> study-future-date: @tr("The date can't be in the future.");
    out property <string> study-no-subject: @tr("Choose a subject.");
    out property <string> study-archived: @tr("That subject is archived. Restore it to log sessions.");
    out property <string> study-no-topic: @tr("That topic is no longer available.");
    out property <string> study-no-session: @tr("That session no longer exists.");
    out property <string> study-session-active: @tr("A session is already running.");
    out property <string> study-no-active-session: @tr("No session is running.");
    out property <string> study-too-short: @tr("Study at least a minute to save it. Discard it if you don't need it.");
    out property <string> study-discard-question: @tr("Discard this session? The time will be lost.");

    // Accessible name of a subject row.
    public pure function subject-line-label(name: string, duration: string, sessions: int) -> string {
        return @tr("{}, {}, {} sessions", name, duration, sessions);
    }

    // The detail's totals line for an archived subject.
    public pure function subject-archived-stats(duration: string, sessions: int) -> string {
        return @tr("{} · {}× · Archived", duration, sessions);
    }

    public pure function delete-session-question(duration: string, date: string) -> string {
        return @tr("Delete the {} session on {}? This can't be undone.", duration, date);
    }

    public pure function study-saved(duration: string, break: string) -> string {
        return @tr("Saved {}. Take a {} break.", duration, break);
    }

    // Shown when a Pomodoro moves to its break, and back.
    public pure function study-break-started() -> string {
        return @tr("Pomodoro done. Time for a break.");
    }

    public pure function study-focus-started() -> string {
        return @tr("Break over. Back to focus.");
    }

    public pure function study-failed(error: string) -> string {
        return @tr("Could not save the study session: {}", error);
    }

    public pure function study-load-failed(error: string) -> string {
        return @tr("Could not load the subjects: {}", error);
    }

    // Accessible name of a bar of the minutes-per-day chart.
    public pure function day-minutes-label(day: int, month: int, year: int, minutes: int) -> string {
        return @tr("{}: {} min", Strings.date(day, month, year), minutes);
    }

    // Header of the subjects list.
    public pure function subjects-count(n: int) -> string {
        return @tr("Subjects · {}", n);
    }

    // Time studied and number of sessions on a subject, e.g. "1h 30m · 3×".
    public pure function subject-stats(duration: string, sessions: int) -> string {
        return @tr("{} · {}×", duration, sessions);
    }

    public pure function task-failed(error: string) -> string {
        return @tr("Could not save the task: {}", error);
    }

    public pure function calendar-failed(error: string) -> string {
        return @tr("Could not load the calendar: {}", error);
    }

    // Tasks of a calendar day that do not fit in its cell.
    public pure function more-tasks(n: int) -> string {
        return @tr("+{}", n);
    }

    public pure function settings-failed(error: string) -> string {
        return @tr("Could not save the settings: {}", error);
    }

    public pure function open-failed(error: string) -> string {
        return @tr("Could not open the link: {}", error);
    }

    public pure function synced-warning(path: string) -> string {
        return @tr("{} looks like a synced folder (OneDrive, Dropbox, Google Drive). SQLite can lose or corrupt changes there. Use it anyway?", path);
    }

    public pure function already-instance(path: string) -> string {
        return @tr("{} is already an instance. Use Open folder to open it.", path);
    }

    public pure function instances-failed(error: string) -> string {
        return @tr("Could not change the instances: {}", error);
    }

    out property <string> export-title: @tr("Export a copy");

    public pure function export-done(path: string) -> string {
        return @tr("Copy saved to {}", path);
    }

    public pure function export-failed(error: string) -> string {
        return @tr("Could not export the copy: {}", error);
    }

    public pure function list-failed(error: string) -> string {
        return @tr("Could not save the list: {}", error);
    }

    out property <string> title-empty: @tr("The title can't be empty.");
    out property <string> list-exists: @tr("A list with that name already exists.");
    out property <string> list-name-empty: @tr("The name can't be empty.");
    out property <string> time-invalid: @tr("Enter the time as HH:MM, like 09:30.");
    out property <string> time-needs-date: @tr("A time needs a due date.");
    out property <string> end-needs-start: @tr("Set a start time before the end.");
    out property <string> end-not-after-start: @tr("The end must be after the start.");
    out property <string> repeat-needs-date: @tr("A repeating task needs a due date.");
    out property <string> interval-invalid: @tr("Enter a whole number from 1 to 999.");
    out property <string> task-title-empty: @tr("Write a title for the task.");
    out property <string> task-cannot-create: @tr("Tasks can't be created in this view.");
    out property <string> task-not-found: @tr("That task no longer exists.");
    out property <string> list-not-found: @tr("That list no longer exists.");

    // English is month/day/year; translations may reorder the placeholders.
    public pure function date(day: int, month: int, year: int) -> string {
        return @tr("{1}/{0}/{2}", day, month, year);
    }

    // Date picker header, e.g. "November 2026"; translations may add words ("de").
    public pure function month-year(month: int, year: int) -> string {
        return @tr("{0} {1}", month-name(month), year);
    }

    // Header of the Tasks module, e.g. "Thursday, November 5"; translations reorder it.
    public pure function long-date(day: int, month: int, weekday: int) -> string {
        return @tr("{0}, {1} {2}", weekday-name(weekday), month-name(month), day);
    }

    // Week tab title, e.g. "November 2 – November 8"; translations reorder it.
    public pure function week-range(start-day: int, start-month: int, end-day: int, end-month: int) -> string {
        return @tr("{1} {0} – {3} {2}", start-day, month-name(start-month), end-day, month-name(end-month));
    }

    // Block of seven days in the habits grid.
    public pure function week-label(n: int) -> string {
        return @tr("WK {}", n);
    }

    // Streak, best streak and share of the month done, under a habit name.
    public pure function habit-streaks(streak: int, best: int) -> string {
        return @tr("Streak {} · Best {}", streak, best);
    }

    // Header of the habits section in Today of Tasks.
    public pure function habits-today(done: int, total: int) -> string {
        return @tr("HABITS · {}/{}", done, total);
    }

    // Habits done out of those that apply on a day of the month calendar.
    public pure function habits-day(done: int, total: int) -> string {
        return @tr("Habits {}/{}", done, total);
    }

    public pure function tasks-today(done: int, total: int) -> string {
        return @tr("TASKS · {}/{}", done, total);
    }

    // Habits done out of those that applied in a block of seven days, and the share.
    public pure function week-total(done: int, applicable: int, pct: int) -> string {
        return @tr("{}/{} {}%", done, applicable, pct);
    }

    public pure function percent(pct: int) -> string {
        return @tr("{}%", pct);
    }

    // 0 is Monday.
    public pure function weekday-name(weekday: int) -> string {
        return weekday == 0 ? @tr("Monday") : weekday == 1 ? @tr("Tuesday") : weekday == 2 ? @tr("Wednesday") : weekday == 3 ? @tr("Thursday") : weekday == 4 ? @tr("Friday") : weekday == 5 ? @tr("Saturday") : @tr("Sunday");
    }

    pure function month-name(month: int) -> string {
        return month == 1 ? @tr("January") : month == 2 ? @tr("February") : month == 3 ? @tr("March") : month == 4 ? @tr("April") : month == 5 ? @tr("May") : month == 6 ? @tr("June") : month == 7 ? @tr("July") : month == 8 ? @tr("August") : month == 9 ? @tr("September") : month == 10 ? @tr("October") : month == 11 ? @tr("November") : @tr("December");
    }

    // Monday-first column heads of the date picker.
    // Hour label of the week grid's left column; the same in every language.
    public pure function hour(h: int) -> string {
        return h < 10 ? "0\{h}:00" : "\{h}:00";
    }

    out property <[string]> weekdays: [@tr("Mo"), @tr("Tu"), @tr("We"), @tr("Th"), @tr("Fr"), @tr("Sa"), @tr("Su")];

    out property <string> finance-empty-name: @tr("Give the account a name.");
    out property <string> finance-invalid-amount: @tr("Enter the amount as a positive number, with only the decimals the currency uses.");
    out property <string> finance-no-currency: @tr("Choose the main currency first.");
    out property <string> finance-no-account: @tr("That account no longer exists.");
    out property <string> finance-no-transaction: @tr("That movement no longer exists.");

    out property <string> finance-no-category: @tr("That category no longer exists.");
    out property <string> finance-duplicate-name: @tr("A category of this type already has that name.");
    out property <string> finance-category-in-use: @tr("Movements use this category, so it can't be deleted. Archive it instead.");
    out property <string> finance-categories-exist: @tr("There are already categories.");
    out property <string> finance-category-kind: @tr("That category belongs to the other type of movement.");
    out property <string> finance-same-account: @tr("Choose two different accounts.");
    out property <string> finance-account-in-use: @tr("Movements use this account, so it can't be deleted. Archive it instead.");
    out property <string> finance-account-archived: @tr("That account is archived. Restore it to use it.");
    out property <string> finance-invalid-rate: @tr("Enter the exchange rate as a positive number with up to 6 decimals.");
    out property <string> finance-currency-locked: @tr("Movements use this account, so its currency can't be changed.");
    out property <string> rates-note: @tr("Totals use today's exchange rates.");
    out property <string> transfer: @tr("Transfer");
    out property <string> no-category: @tr("No category");
    out property <string> same-as-last-month: @tr("Same as last month");
    out property <string> finance-category-archived: @tr("That category is archived. Restore it to use it.");

    public pure function vs-last-month(change: string) -> string {
        return @tr("{} vs last month", change);
    }

    public pure function finance-missing-rate(currency: string) -> string {
        return @tr("Enter the exchange rate of {} to your main currency.", currency);
    }

    // Start of "1 USD = 987.24 CLP" for a rate field.
    public pure function rate-prefix(currency: string) -> string {
        return @tr("1 {} =", currency);
    }

    public pure function main-currency-button(currency: string) -> string {
        return @tr("Main currency: {}", currency);
    }

    public pure function main-change-note(currency: string) -> string {
        return @tr("Amounts stay as they are; only the totals change to {}. Enter what one unit of each currency is worth in {}.", currency, currency);
    }

    public pure function finance-failed(error: string) -> string {
        return @tr("Could not save: {}", error);
    }

    public pure function finance-load-failed(error: string) -> string {
        return @tr("Could not load the accounts: {}", error);
    }

    public pure function account-kind(kind: AccountKind) -> string {
        if kind == AccountKind.checking {
            return @tr("Checking");
        }
        if kind == AccountKind.demand {
            return @tr("Demand deposit");
        }
        if kind == AccountKind.savings {
            return @tr("Savings");
        }
        if kind == AccountKind.credit {
            return @tr("Credit card");
        }
        return @tr("Cash");
    }

    public pure function card-terms(closing: int, due: int) -> string {
        return @tr("Closes on day {} · Pay on day {}", closing, due);
    }

    public pure function card-used(used: string, limit: string) -> string {
        return @tr("{} of {}", used, limit);
    }

    public pure function card-available(available: string) -> string {
        return @tr("{} available", available);
    }

    public pure function account-kind-bank(kind: AccountKind, bank: string) -> string {
        return @tr("{} · {}", Strings.account-kind(kind), bank);
    }

    public pure function tx-kind(kind: TxKind) -> string {
        return kind == TxKind.expense ? @tr("Expense") : @tr("Income");
    }

    public pure function suggested-category(category: SuggestedCategory) -> string {
        return category == SuggestedCategory.food ? @tr("Food") : category == SuggestedCategory.transport ? @tr("Transport") : category == SuggestedCategory.housing ? @tr("Housing") : category == SuggestedCategory.bills ? @tr("Bills") : category == SuggestedCategory.health ? @tr("Health") : category == SuggestedCategory.leisure ? @tr("Leisure") : category == SuggestedCategory.shopping ? @tr("Shopping") : category == SuggestedCategory.salary ? @tr("Salary") : @tr("Other income");
    }

    public pure function archived-account(name: string) -> string {
        return @tr("{} (archived)", name);
    }

    public pure function delete-account-question(name: string) -> string {
        return @tr("Delete the account {}? This can't be undone.", name);
    }

    // Second line of a transfer: the accounts and the date.
    public pure function transfer-detail(from: string, to: string, date: string) -> string {
        return @tr("{} → {} · {}", from, to, date);
    }

    public pure function transfer-line-label(title: string, from: string, to: string, date: string, amount: string) -> string {
        return @tr("{}, from {} to {}, {}, {}", title, from, to, date, amount);
    }

    public pure function archived-category(name: string) -> string {
        return @tr("{} (archived)", name);
    }

    public pure function category-line-label(name: string, total: string) -> string {
        return @tr("{}, {}", name, total);
    }

    public pure function delete-category-question(name: string) -> string {
        return @tr("Delete the category {}? This can't be undone.", name);
    }

    // Second line of a movement with a category: category, account and date.
    public pure function transaction-detail-category(category: string, account: string, date: string) -> string {
        return @tr("{} · {} · {}", category, account, date);
    }

    // Second line of a movement: its account and date.
    public pure function transaction-detail(account: string, date: string) -> string {
        return @tr("{} · {}", account, date);
    }

    public pure function transaction-line-label(title: string, account: string, date: string, amount: string) -> string {
        return @tr("{}, {}, {}, {}", title, account, date, amount);
    }

    public pure function delete-transaction-question(amount: string, date: string) -> string {
        return @tr("Delete the movement of {} on {}? This can't be undone.", amount, date);
    }

    public pure function schedule-form(form: ScheduleForm, number: int, total: int) -> string {
        if form == ScheduleForm.once {
            return @tr("One-time");
        }
        if form == ScheduleForm.weekly {
            return @tr("Weekly");
        }
        if form == ScheduleForm.monthly {
            return @tr("Monthly");
        }
        if form == ScheduleForm.yearly {
            return @tr("Yearly");
        }
        return @tr("Installment {} of {}", number, total);
    }

    public pure function bill-closed(date: string) -> string {
        return @tr("Bill closed on {}", date);
    }

    public pure function card-bill(amount: string, date: string) -> string {
        return @tr("Bill: {} · due {}", amount, date);
    }

    public pure function bill-line-label(card: string, closed: string, due: string, amount: string) -> string {
        return @tr("{}, {}, due {}, {}", card, closed, due, amount);
    }

    public pure function due-line-label(title: string, account: string, kind: string, date: string, amount: string) -> string {
        return @tr("{}, {}, {}, {}, {}", title, account, kind, date, amount);
    }

    public pure function delete-scheduled-question(title: string) -> string {
        return @tr("Delete the scheduled payment {}? The movements it already recorded stay. This can't be undone.", title);
    }

    public pure function skip-scheduled-question(title: string) -> string {
        return @tr("Skip {}? No movement is recorded and the payment moves on to its next date.", title);
    }

    public pure function restore-installment(number: int, total: int) -> string {
        return @tr("Also return installment {} of {} to the schedule", number, total);
    }

    public pure function schedules-use-account(n: int) -> string {
        return @tr("{n} scheduled payment uses this account." | "{n} scheduled payments use this account." % n);
    }

    out property <string> finance-invalid-schedule: @tr("Check the installments: there must be at least 2.");
    out property <string> finance-no-scheduled: @tr("That scheduled payment no longer exists.");
    out property <string> finance-invalid-limit: @tr("The credit limit must be an amount greater than zero.");
    out property <string> finance-invalid-day: @tr("The days must be numbers from 1 to 31.");
    out property <string> finance-kind-locked: @tr("A credit card can't become another kind of account, nor the reverse.");
    out property <string> finance-scheduled-done: @tr("That scheduled payment is already finished.");

    public pure function account-line-label(name: string, kind: string, balance: string) -> string {
        return @tr("{}, {}, {}", name, kind, balance);
    }
}
