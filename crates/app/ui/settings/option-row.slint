import { Palette } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// One choice of a radio group: ink ring with a dot when chosen. Arrows ask the group to move.
export component OptionRow inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback chosen;
    callback step(int);

    height: 36px;
    border-radius: 6px;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }
    forward-focus: focus;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.chosen();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            border-width: root.checked ? 2px : 1.5px;
            border-color: root.checked ? Theme.ink : Theme.muted;
            animate border-color { duration: Theme.fast; easing: Theme.ease-out; }

            Rectangle {
                width: root.checked ? 8px : 0px;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.ink;
                animate width { duration: Theme.enter; easing: Theme.ease-out; }
            }
        }

        Text {
            text: root.text;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            root.chosen();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.chosen();
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.LeftArrow {
                root.step(-1);
                return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.RightArrow {
                root.step(1);
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}
