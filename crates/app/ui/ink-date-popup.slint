import { Date, Palette } from "std-widgets.slint";
import { PopupSurface } from "popup-surface.slint";
import { Strings } from "strings.slint";
import { SubtleButton } from "subtle-button.slint";
import { Theme } from "theme.slint";

// One month as laid out by core: 42 cells, Monday first, 0 for days outside the month.
export struct MonthView {
    year: int,
    month: int,
    days: [int],
    today: int,
}

// Implemented in Rust on top of core::calendar.
export global Calendar {
    // The month `delta` months away from year/month (1-12).
    pure callback month(int, int, int) -> MonthView;
    pure callback today() -> Date;
    // The date `days` away (negative goes back); the input date when out of range.
    pure callback shift(Date, int) -> Date;
}

component DayCell inherits Rectangle {
    in property <int> day;
    in property <bool> selected;
    in property <bool> today;
    // The keyboard cursor is on this day (and the grid has focus).
    in property <bool> cursor;
    in property <string> label;
    callback clicked;

    border-radius: 6px;
    border-width: root.cursor ? 2px : 0px;
    border-color: root.selected ? Theme.on-ink : Palette.foreground;
    background: root.selected ? Theme.ink : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected || root.cursor;
    accessible-action-default => {
        root.clicked();
    }

    Text {
        text: root.day;
        color: root.selected ? Theme.on-ink : Palette.foreground;
        font-weight: root.today ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    // Today is marked with a short ink bar under the number.
    if root.today && !root.selected: Rectangle {
        y: parent.height - 6px;
        width: 10px;
        height: 2px;
        border-radius: 1px;
        background: Palette.foreground;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Date picker in the monochrome system. Picking a day closes it at once.
export component InkDatePopup inherits PopupWindow {
    // The chosen date, marked in the grid; day 0 means none (opens on today's month).
    in property <int> day;
    in property <int> month;
    in property <int> year;
    callback picked(Date);

    // The popup content is rebuilt on every show(), so this starts on the right month each time;
    // the arrows then replace it.
    property <MonthView> view: root.day > 0 ? Calendar.month(root.year, root.month, 0) : Calendar.month(Calendar.today().year, Calendar.today().month, 0);
    property <length> cell-w: 36px;
    property <length> cell-h: 32px;

    close-policy: close-on-click-outside;
    width: 7 * root.cell-w + 24px;

    // Keyboard cursor: starts on the task's date, else today.
    property <Date> cursor: root.day > 0 ? { year: root.year, month: root.month, day: root.day } : Calendar.today();

    // Moves the cursor and follows it when it leaves the month shown.
    function move(days: int) {
        root.cursor = Calendar.shift(root.cursor, days);
        if root.cursor.month != root.view.month || root.cursor.year != root.view.year {
            root.view = Calendar.month(root.cursor.year, root.cursor.month, 0);
        }
    }

    // PageUp/PageDown: the cursor lands on day 1 of the other month (no day clamping needed).
    function move-month(delta: int) {
        root.view = Calendar.month(root.view.year, root.view.month, delta);
        root.cursor = { year: root.view.year, month: root.view.month, day: 1 };
    }

    function choose(date: Date) {
        root.close();
        root.picked(date);
    }

    PopupSurface {
        border-radius: 8px;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 2px;
                Text {
                    text: Strings.month-year(root.view.month, root.view.year);
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                SubtleButton {
                    icon: @image-url("icons/chevron-left.svg");
                    label: @tr("Previous month");
                    color: Palette.foreground;
                    clicked => {
                        root.view = Calendar.month(root.view.year, root.view.month, -1);
                    }
                }

                SubtleButton {
                    icon: @image-url("icons/chevron-right.svg");
                    label: @tr("Next month");
                    color: Palette.foreground;
                    clicked => {
                        root.view = Calendar.month(root.view.year, root.view.month, 1);
                    }
                }
            }

            HorizontalLayout {
                for name in Strings.weekdays: Text {
                    width: root.cell-w;
                    text: name;
                    font-size: 12px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                height: 6 * root.cell-h;
                // One tab stop for the whole grid.
                grid := FocusScope {
                    init => {
                        self.focus();
                    }
                    key-pressed(event) => {
                        if event.text == Key.LeftArrow {
                            root.move(-1);
                        } else if event.text == Key.RightArrow {
                            root.move(1);
                        } else if event.text == Key.UpArrow {
                            root.move(-7);
                        } else if event.text == Key.DownArrow {
                            root.move(7);
                        } else if event.text == Key.PageUp {
                            root.move-month(-1);
                        } else if event.text == Key.PageDown {
                            root.move-month(1);
                        } else if event.text == Key.Return || event.text == Key.Space {
                            root.choose(root.cursor);
                        } else if event.text == Key.Escape {
                            root.close();
                        } else {
                            return reject;
                        }
                        accept
                    }
                }

                for d[i] in root.view.days: DayCell {
                    x: mod(i, 7) * root.cell-w;
                    y: floor(i / 7) * root.cell-h;
                    width: root.cell-w;
                    height: root.cell-h;
                    visible: d > 0;
                    day: d;
                    today: d == root.view.today;
                    label: Strings.date(d, root.view.month, root.view.year);
                    cursor: grid.has-focus && d == root.cursor.day && root.view.month == root.cursor.month && root.view.year == root.cursor.year;
                    selected: d == root.day && root.view.month == root.month && root.view.year == root.year;
                    clicked => {
                        root.choose({ year: root.view.year, month: root.view.month, day: d });
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                SubtleButton {
                    text: @tr("Today");
                    color: Palette.foreground;
                    clicked => {
                        root.choose(Calendar.today());
                    }
                }
            }
        }
    }
}
