import { Palette, ListView } from "std-widgets.slint";
import { EmptyState } from "../empty-state.slint";
import { InkButton } from "../ink-button.slint";
import { InkCheck } from "../ink-check.slint";
import { ActiveSessionCard } from "active-session-card.slint";
import { DayBarRow, DaysChart, DaysTab } from "days-chart.slint";
import { SessionPanel } from "session-panel.slint";
import { SettingsTab } from "../settings/settings-tab.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { SubjectDetail, SessionRow } from "subject-detail.slint";
import { SubjectPreview } from "subject-preview.slint";
import { StudyMode, SubjectRow, SubjectTab, TopicRow } from "subject-row.slint";

component SubjectLine inherits Rectangle {
    in property <SubjectRow> subject;
    callback opened;

    height: 40px;
    border-radius: 6px;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background {
        duration: Theme.fast;
        easing: Theme.ease-out;
    }
    forward-focus: focus;
    accessible-role: button;
    accessible-label: Strings.subject-line-label(root.subject.name, root.subject.duration, root.subject.sessions);
    accessible-action-default => {
        root.opened();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 16px; // clears the ListView scroll bar
        spacing: 8px;
        Image {
            source: @image-url("../icons/notebook-text.svg");
            colorize: Theme.muted;
            opacity: root.subject.archived ? 0.6 : 1;
            width: 16px;
            image-fit: contain;
            accessible-role: none;
        }

        Text {
            text: root.subject.name;
            color: root.subject.archived ? Theme.muted : Palette.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        Text {
            text: Strings.subject-stats(root.subject.duration, root.subject.sessions);
            color: Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: right;
            accessible-role: none;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }

    touch := TouchArea {
        clicked => {
            root.opened();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.opened();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}

component TopicLine inherits Rectangle {
    in property <TopicRow> topic;
    callback toggled(bool);

    height: 36px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background {
        duration: Theme.fast;
        easing: Theme.ease-out;
    }

    // Wraps the controls, so the row keeps its hover while the pointer is over them.
    touch := TouchArea {
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 16px; // clears the ListView scroll bar
            spacing: 8px;
            InkCheck {
                checked: root.topic.done;
                label: root.topic.title;
                toggled(done) => {
                    root.toggled(done);
                }
            }

            Text {
                text: root.topic.title;
                color: root.topic.done ? Theme.done : Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }

            Text {
                text: root.topic.subject;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
                max-width: 240px;
                accessible-role: none;
            }

            if root.topic.has-due: Text {
                text: Strings.date(root.topic.due.day, root.topic.due.month, root.topic.due.year);
                color: Theme.muted;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

// Active / Archived / All; the owner reads `tab` when `changed` fires.
component SubjectTabs inherits HorizontalLayout {
    in-out property <SubjectTab> tab;
    callback changed;

    spacing: 4px;
    alignment: start;
    accessible-role: tab-list;

    function choose(t: SubjectTab) {
        root.tab = t;
        root.changed();
    }

    // Arrow keys move the choice and the focus together, like a native radio group.
    function step(delta: int) {
        let i = root.tab == SubjectTab.active ? 0 : root.tab == SubjectTab.archived ? 1 : 2;
        let next = max(0, min(2, i + delta));
        if next == 0 {
            root.choose(SubjectTab.active);
            active-tab.focus();
        } else if next == 1 {
            root.choose(SubjectTab.archived);
            archived-tab.focus();
        } else {
            root.choose(SubjectTab.all);
            all-tab.focus();
        }
    }

    active-tab := SettingsTab {
        text: @tr("Active");
        selected: root.tab == SubjectTab.active;
        chosen => {
            root.choose(SubjectTab.active);
        }
        step(d) => {
            root.step(d);
        }
    }

    archived-tab := SettingsTab {
        text: @tr("Archived");
        selected: root.tab == SubjectTab.archived;
        chosen => {
            root.choose(SubjectTab.archived);
        }
        step(d) => {
            root.step(d);
        }
    }

    all-tab := SettingsTab {
        text: @tr("All");
        selected: root.tab == SubjectTab.all;
        chosen => {
            root.choose(SubjectTab.all);
        }
        step(d) => {
            root.step(d);
        }
    }
}

// Subjects and the time studied on each, or one subject's detail; sessions are logged from the header.
export component StudyView inherits VerticalLayout {
    // The subjects of the chosen tab.
    in property <[SubjectRow]> subjects;
    // Whether any subject exists at all, whatever the tab shows.
    in property <bool> any-subject;
    // Whether there is an active subject to log a session on.
    in property <bool> can-log;
    // Pending topics and those done today, of active subjects.
    in property <[TopicRow]> topics;
    // The topics due today.
    in property <[TopicRow]> today-topics;
    in property <SubjectRow> detail;
    in property <[SessionRow]> sessions;
    in property <string> error;
    in property <string> notice;
    in property <bool> active;
    in property <string> active-subject;
    in property <string> active-topic;
    in property <string> clock;
    in property <bool> paused;
    in property <bool> pomodoro;
    in property <bool> on-break;
    in property <int> pomodoros;
    in-out property <SubjectTab> tab;
    // Minutes per day, already summed; the panel beside the lists.
    in property <[DayBarRow]> days;
    in property <string> days-total;
    in property <bool> days-has-minutes;
    in-out property <DaysTab> days-tab;
    callback days-tab-changed();
    in-out property <bool> detail-open;
    // The session screen replaces the whole view while open.
    in-out property <bool> session-open;
    // For the session screen: the subjects it can start on, the chosen subject's pending topics.
    in property <[SubjectRow]> session-subjects;
    in property <[TopicRow]> session-topics;
    in property <int> session-initial-subject;
    in-out property <StudyMode> session-mode;
    pure callback session-preview(StudyMode) -> string;
    pure callback session-break-minutes(StudyMode) -> int;
    callback session-start(int, bool, int, StudyMode) -> string;
    callback session-subject-changed(int);
    callback new-subject();
    callback new-topic();
    callback log-session();
    callback start-session();
    callback finish-session();
    callback discard-session();
    callback pause-session();
    callback resume-session();
    callback set-topic-done(int, bool);
    callback tab-changed();
    callback open-subject(int);
    callback rename-subject();
    callback set-archived(int, bool);
    callback delete-session(int);

    // Two columns once the content fits the lists and the 320px panel.
    property <bool> wide: root.width - 48px >= 900px;

    padding: 24px;
    padding-top: 20px;
    spacing: 12px;

    if root.session-open: SessionPanel {
        subjects: root.session-subjects;
        topics: root.session-topics;
        initial-subject: root.session-initial-subject;
        error: root.error;
        notice: root.notice;
        active: root.active;
        active-subject: root.active-subject;
        active-topic: root.active-topic;
        clock: root.clock;
        paused: root.paused;
        pomodoro: root.pomodoro;
        on-break: root.on-break;
        pomodoros: root.pomodoros;
        mode <=> root.session-mode;
        preview(mode) => {
            return root.session-preview(mode);
        }
        break-minutes(mode) => {
            return root.session-break-minutes(mode);
        }
        subject-changed(id) => {
            root.session-subject-changed(id);
        }
        start(id, has-topic, topic-id, mode) => {
            return root.session-start(id, has-topic, topic-id, mode);
        }
        finish => {
            root.finish-session();
        }
        discard => {
            root.discard-session();
        }
        pause => {
            root.pause-session();
        }
        resume => {
            root.resume-session();
        }
        close => {
            root.session-open = false;
        }
    }

    if !root.session-open: VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("Study");
                font-size: 24px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            SubtleButton {
                text: @tr("New subject");
                color: Palette.foreground;
                clicked => {
                    root.new-subject();
                }
            }

            SubtleButton {
                text: @tr("New topic");
                color: Palette.foreground;
                enabled: root.can-log;
                clicked => {
                    root.new-topic();
                }
            }

            SubtleButton {
                text: @tr("Start session");
                color: Palette.foreground;
                enabled: root.can-log && !root.active;
                clicked => {
                    root.start-session();
                }
            }

            InkButton {
                text: @tr("Log session");
                enabled: root.can-log;
                clicked => {
                    root.log-session();
                }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.critical;
            wrap: word-wrap;
        }

        if root.notice != "": Text {
            text: root.notice;
            color: Theme.muted;
            wrap: word-wrap;
        }

        if root.active: ActiveSessionCard {
            subject: root.active-subject;
            topic: root.active-topic;
            clock: root.clock;
            paused: root.paused;
            pomodoro: root.pomodoro;
            on-break: root.on-break;
            pomodoros: root.pomodoros;
            opened => {
                root.start-session();
            }
            finish => {
                root.finish-session();
            }
            discard => {
                root.discard-session();
            }
            pause => {
                root.pause-session();
            }
            resume => {
                root.resume-session();
            }
        }

        if !root.any-subject: EmptyState {
            title: @tr("Create your first subject");
            description: @tr("Group what you study by subject. Every session you log adds hours to its subject, so you can see how much time each one gets.");
            action: @tr("New subject");
            clicked => {
                root.new-subject();
            }

            SubjectPreview { }
        }

        if root.any-subject && root.detail-open: SubjectDetail {
            subject: root.detail;
            sessions: root.sessions;
            back => {
                root.detail-open = false;
            }
            rename => {
                root.rename-subject();
            }
            set-archived(archived) => {
                root.set-archived(root.detail.id, archived);
            }
            delete-session(id) => {
                root.delete-session(id);
            }
        }

        if root.any-subject && !root.detail-open: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 24px;
            VerticalLayout {
                spacing: 12px;
                Text {
                    text: @tr("Today's study");
                    font-weight: 700;
                    color: Palette.foreground.with-alpha(0.7);
                }

                if root.today-topics.length == 0: Text {
                    text: @tr("Nothing due today. Give a topic today's date to see it here.");
                    color: Theme.muted;
                    wrap: word-wrap;
                }

                // No ListView: the section is short and takes its natural height.
                if root.today-topics.length > 0: VerticalLayout {
                    for topic in root.today-topics: TopicLine {
                        topic: topic;
                        toggled(done) => {
                            root.set-topic-done(topic.id, done);
                        }
                    }
                }

                Text {
                    text: Strings.subjects-count(root.subjects.length);
                    font-weight: 700;
                    color: Palette.foreground.with-alpha(0.7);
                }

                SubjectTabs {
                    tab <=> root.tab;
                    changed => {
                        root.tab-changed();
                    }
                }

                if root.subjects.length == 0: Text {
                    text: root.tab == SubjectTab.archived ? @tr("No archived subjects. Archive one from its page to tuck it away.") : @tr("No active subjects. Restore one from the Archived tab or create a new one.");
                    color: Theme.muted;
                    wrap: word-wrap;
                }

                if root.subjects.length > 0: ListView {
                    height: min(root.subjects.length * 40px, 240px);
                    for subject in root.subjects: SubjectLine {
                        subject: subject;
                        opened => {
                            root.open-subject(subject.id);
                        }
                    }
                }

                Text {
                    text: @tr("Topics");
                    font-weight: 700;
                    color: Palette.foreground.with-alpha(0.7);
                }

                if root.topics.length == 0: Text {
                    text: @tr("No topics yet. Add what you need to study on a subject with New topic.");
                    color: Theme.muted;
                    wrap: word-wrap;
                }

                if root.topics.length > 0: ListView {
                    height: min(root.topics.length * 36px, 240px);
                    for topic in root.topics: TopicLine {
                        topic: topic;
                        toggled(done) => {
                            root.set-topic-done(topic.id, done);
                        }
                    }
                }

                // Whatever height the lists leave goes to the end of the column, not between sections.
                Rectangle {
                    vertical-stretch: 1;
                }
            }

            // Wide window: the panel sits beside the lists.
            if root.wide: VerticalLayout {
                width: 320px;
                alignment: start;
                DaysChart {
                    days: root.days;
                    total: root.days-total;
                    has-minutes: root.days-has-minutes;
                    tab <=> root.days-tab;
                    changed => {
                        root.days-tab-changed();
                    }
                }
            }
        }

        // Narrow window: the panel goes under the lists.
        if root.any-subject && !root.detail-open && !root.wide: DaysChart {
                    days: root.days;
                    total: root.days-total;
                    has-minutes: root.days-has-minutes;
                    tab <=> root.days-tab;
                    changed => {
                        root.days-tab-changed();
                    }
                }
    }
}
