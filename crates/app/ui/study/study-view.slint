import { Palette, ListView } from "std-widgets.slint";
import { EmptyState } from "../empty-state.slint";
import { InkButton } from "../ink-button.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { SubjectPreview } from "subject-preview.slint";

// A subject with what has been studied on it; `duration` arrives already formatted.
export struct SubjectRow {
    id: int,
    name: string,
    duration: string,
    sessions: int,
}

component SubjectLine inherits Rectangle {
    in property <SubjectRow> subject;

    height: 40px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Image {
            source: @image-url("../icons/notebook-text.svg");
            colorize: Theme.muted;
            width: 16px;
            image-fit: contain;
            accessible-role: none;
        }

        Text {
            text: root.subject.name;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: Strings.subject-stats(root.subject.duration, root.subject.sessions);
            color: Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }
}

// Subjects and the time studied on each; sessions are logged from the header.
export component StudyView inherits VerticalLayout {
    in property <[SubjectRow]> subjects;
    in property <string> error;
    callback new-subject();
    callback log-session();

    padding: 24px;
    padding-top: 20px;
    spacing: 12px;

    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("Study");
                font-size: 24px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            SubtleButton {
                text: @tr("New subject");
                color: Palette.foreground;
                clicked => {
                    root.new-subject();
                }
            }

            InkButton {
                text: @tr("Log session");
                enabled: root.subjects.length > 0;
                clicked => {
                    root.log-session();
                }
            }
        }

        Text {
            text: @tr("Your subjects and study sessions.");
            color: Theme.muted;
        }
    }

    if root.error != "": Text {
        text: root.error;
        color: Theme.critical;
        wrap: word-wrap;
    }

    if root.subjects.length == 0: EmptyState {
        title: @tr("Create your first subject");
        description: @tr("Group what you study by subject. Every session you log adds hours to its subject, so you can see how much time each one gets.");
        action: @tr("New subject");
        clicked => {
            root.new-subject();
        }

        SubjectPreview { }
    }

    if root.subjects.length > 0: Text {
        text: Strings.subjects-count(root.subjects.length);
        font-weight: 700;
        color: Palette.foreground.with-alpha(0.7);
    }

    if root.subjects.length > 0: ListView {
        for subject in root.subjects: SubjectLine {
            subject: subject;
        }
    }
}
