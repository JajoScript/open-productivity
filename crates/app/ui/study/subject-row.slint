import { Date } from "std-widgets.slint";

// A subject with what has been studied on it; `duration` arrives already formatted.
export struct SubjectRow {
    id: int,
    name: string,
    duration: string,
    sessions: int,
    archived: bool,
}

// Which subjects the list shows.
export enum SubjectTab { active, archived, all }

// A task of a subject; `due` only matters when `has-due`.
export struct TopicRow {
    id: int,
    title: string,
    subject: string,
    has-due: bool,
    due: Date,
    done: bool,
}
