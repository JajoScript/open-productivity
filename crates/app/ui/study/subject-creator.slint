import { Palette } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { InkField } from "../ink-field.slint";
import { PopupSurface } from "../popup-surface.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";

// Rebuilt on every show(), so the fields and the error always start fresh.
component CreatorBody inherits FocusScope {
    in property <bool> editing;
    // The modal gives the initial name and the user edits it here.
    in-out property <string> name;
    callback save(string) -> string;
    callback cancel;

    property <string> error;

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    function submit() {
        root.error = root.save(root.name);
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: root.editing ? @tr("Rename subject") : @tr("New subject");
            font-size: 14px;
            font-weight: 700;
        }

        InkField {
            text <=> root.name;
            placeholder-text: @tr("Subject name");
            init => {
                self.focus();
            }
            accepted(text) => {
                root.submit();
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.critical;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            SubtleButton {
                text: @tr("Cancel");
                color: Palette.foreground;
                clicked => {
                    root.cancel();
                }
            }

            InkButton {
                text: root.editing ? @tr("Save") : @tr("Create");
                clicked => {
                    root.submit();
                }
            }
        }
    }
}

// Creates a subject or renames one, depending on how it is opened. Closing by clicking outside
// discards it.
export component SubjectCreator inherits PopupWindow {
    // Return the error to show; empty means it worked and the modal closes.
    callback create(string) -> string;
    callback rename(int, string) -> string;

    // Set by the opener before show().
    in property <bool> editing;
    in property <int> subject-id;
    in property <string> subject-name;

    close-policy: close-on-click-outside;
    width: 360px;

    PopupSurface {
        CreatorBody {
            editing: root.editing;
            name: root.subject-name;
            save(name) => {
                let error = root.editing ? root.rename(root.subject-id, name) : root.create(name);
                if error == "" {
                    root.close();
                }
                return error;
            }
            cancel => {
                root.close();
            }
        }
    }
}
