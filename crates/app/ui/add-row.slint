import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Row-shaped field for a new item: an empty box where the checkbox goes, no frame.
export component AddRow inherits Rectangle {
    in property <string> placeholder;
    callback accepted(string);

    height: 40px;
    border-radius: 6px;
    background: input.has-focus ? transparent : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 10px;
        spacing: 4px;
        Rectangle {
            width: 32px;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 5px;
                border-width: 1.5px;
                border-color: Theme.hairline;
            }
        }

        Rectangle {
            if input.text == "": Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                text: root.placeholder;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }

            input := TextInput {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Palette.foreground;
                selection-background-color: Theme.selection;
                selection-foreground-color: Palette.foreground;
                accessible-label: root.placeholder;
                accepted => {
                    root.accepted(self.text);
                    self.text = "";
                }
            }
        }
    }
}
