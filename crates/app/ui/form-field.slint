import { Theme } from "theme.slint";

// A small label above a form control.
export component FormField {
    in property <string> label;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.muted;
            accessible-role: none;
        }

        @children
    }
}
