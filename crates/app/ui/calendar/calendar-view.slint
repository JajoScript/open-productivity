import { Date, ListView, Palette } from "std-widgets.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { DragBoard } from "../tasks/drag-board.slint";
import { SettingsTab } from "../settings/settings-tab.slint";
import { CalendarTask, TaskChip } from "task-chip.slint";
import { CalendarHabit, HabitLine } from "habit-row.slint";
import { WeekBlock, WeekColumn, WeekGrid } from "week-grid.slint";

export { CalendarHabit, CalendarTask, WeekBlock, WeekColumn }

export enum CalendarMode { month, week }

// One cell of the month grid: the day and the tasks due on it.
export struct CalendarDay {
    date: Date,
    day: int,
    // False for the filler days of the neighbouring months.
    in-month: bool,
    today: bool,
    tasks: [CalendarTask],
    // The habits that apply that day and those done; one summary row after the tasks.
    habits-done: int,
    habits-total: int,
}

component CalendarCell inherits Rectangle {
    in property <CalendarDay> cell;
    callback chosen;
    pure callback payload(int) -> data-transfer;
    // A drag is over the cell: returns whether it is one of our tasks.
    callback drag-over(Point, Point, data-transfer) -> bool;
    callback dropped(data-transfer);
    callback chip-dragging(bool, CalendarTask, Point, length, Point);

    property <length> row-h: 20px;
    // Rows that fit under the day number. The habit summary keeps its row unless a single row is
    // left and there are tasks; when the tasks do not fit, the last of theirs is "+N".
    property <int> fit: max(1, Math.floor((root.height - 38px) / root.row-h));
    property <bool> summary: root.cell.habits-total > 0 && (root.fit > 1 || root.cell.tasks.length == 0);
    property <int> room: root.summary ? root.fit - 1 : root.fit;
    property <bool> overflow: root.cell.tasks.length > root.room;
    property <int> shown: root.overflow ? root.room - 1 : root.cell.tasks.length;

    // Equal cells whatever their content.
    preferred-width: 0px;
    preferred-height: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    clip: true;
    border-radius: 6px;
    background: drop.has-drag ? Theme.selected : touch.has-hover ? Theme.hover : root.cell.today ? Theme.field : transparent;
    animate background { duration: Theme.fast; easing: Theme.ease-out; }
    border-width: 1px;
    border-color: Theme.hairline;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: @tr("New task on {0}", Strings.date(root.cell.date.day, root.cell.date.month, root.cell.date.year));
    accessible-action-default => {
        root.chosen();
    }

    drop := DropArea {
        // Only our own task chips; text dragged from other apps is refused.
        can-drop(event) => {
            root.drag-over(self.absolute-position, event.position, event.data) ? DragAction.move : DragAction.none
        }
        dropped(event) => {
            root.dropped(event.data);
            return event.proposed-action;
        }

        // Placed by hand, not in a layout: the rows that fit depend on the cell's height, and a
        // layout would feed its own content size back into it.
        Rectangle {
            x: 6px;
            y: 6px;
            width: max(24px, number.preferred-width + 8px);
            height: 24px;
            border-radius: 5px;
            background: root.cell.today ? Theme.ink : transparent;
            number := Text {
                text: root.cell.day;
                font-size: 12px;
                font-weight: root.cell.today ? 700 : 400;
                color: root.cell.today ? Theme.on-ink : root.cell.in-month ? Palette.foreground : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // The cell's own click sits under the chips, so it comes before them.
        touch := TouchArea {
            clicked => {
                root.chosen();
            }
        }

        for t[i] in root.cell.tasks: TaskChip {
            visible: i < root.shown;
            x: 6px;
            y: 32px + i * root.row-h;
            width: parent.width - 12px;
            height: root.row-h;
            task: t;
            payload: root.payload(t.id);
            ink: root.cell.in-month ? Palette.foreground : Theme.muted;
            changed dragging => {
                root.chip-dragging(self.dragging, t, self.absolute-position, self.width, { x: self.grab-x, y: self.grab-y });
            }
            clicked => {
                root.chosen();
            }
        }

        if root.summary: HabitLine {
            x: 6px;
            y: 32px + (root.shown + (root.overflow ? 1 : 0)) * root.row-h;
            width: parent.width - 12px;
            height: root.row-h;
            habit: {
                name: Strings.habits-day(root.cell.habits-done, root.cell.habits-total),
                done: root.cell.habits-done == root.cell.habits-total,
            };
            ink: root.cell.in-month ? Palette.foreground : Theme.muted;
        }

        if root.overflow: Text {
            x: 6px;
            y: 32px + root.shown * root.row-h;
            width: parent.width - 12px;
            height: root.row-h;
            text: Strings.more-tasks(root.cell.tasks.length - root.shown);
            font-size: 12px;
            color: Theme.muted;
            overflow: elide;
            vertical-alignment: center;
        }

        focus := FocusScope {
            width: 0px; // keyboard only; clicks go to the TouchArea
            key-pressed(event) => {
                if event.text == Key.Space || event.text == Key.Return {
                    root.chosen();
                    return accept;
                }
                reject
            }
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: 6px;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}

// One section of the side panel: a title with its count over a scrolling list.
component PanelSection inherits VerticalLayout {
    in property <string> title;
    in property <[CalendarTask]> tasks;
    pure callback payload(int) -> data-transfer;
    callback chip-dragging(bool, CalendarTask, Point, length, Point);

    spacing: 4px;
    padding: 8px;

    HorizontalLayout {
        padding-left: 4px;
        spacing: 8px;
        height: 28px;
        Text {
            text: root.title;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.tasks.length;
            color: Theme.muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    ListView {
        for t in root.tasks: TaskChip {
            height: 28px;
            task: t;
            payload: root.payload(t.id);
            changed dragging => {
                root.chip-dragging(self.dragging, t, self.absolute-position, self.width, { x: self.grab-x, y: self.grab-y });
            }
        }
    }
}

// The month as a grid, Monday first, tasks placed by due date. Pressing a day asks to add a task;
// dragging a task onto a day (or from the side panel) reschedules it.
export component CalendarView inherits DragBoard {
    // Rows of seven days.
    in property <[[CalendarDay]]> weeks;
    // The month shown; only its month and year matter.
    in property <Date> month;
    in property <string> error;
    // Pending tasks past due, and without a date: the side panel.
    in property <[CalendarTask]> overdue;
    in property <[CalendarTask]> undated;
    in property <CalendarMode> mode;
    // The week view: seven days, and the minutes since midnight of the current time.
    in property <[WeekColumn]> week;
    in property <int> now;
    // -1 / +1 moves a month (or a week); 0 goes back to the current one.
    callback shift(int);
    callback set-mode(CalendarMode);
    callback day-chosen(Date);
    callback reschedule(int, Date);
    // Dropped on the week grid at a place in the day (minutes since midnight), or on a day's
    // "No time" strip.
    callback reschedule-at(int, Date, int);
    callback reschedule-untimed(int, Date);
    // The minutes a drop at the given minutes lands on.
    pure callback slot(int) -> int;

    // A narrow window gives the whole width to the grid.
    property <bool> show-panel: root.width >= 800px;

    HorizontalLayout {
        padding: 24px;
        padding-top: 20px;
        spacing: 12px;

        VerticalLayout {
            spacing: 12px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text {
                    text: @tr("Calendar");
                    font-size: 24px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }

                SubtleButton {
                    icon: @image-url("../icons/chevron-left.svg");
                    label: root.mode == CalendarMode.month ? @tr("Previous month") : @tr("Previous week");
                    clicked => {
                        root.shift(-1);
                    }
                }

                Text {
                    text: root.mode == CalendarMode.month || root.week.length < 7 ? Strings.month-year(root.month.month, root.month.year) : Strings.date(root.week[0].date.day, root.week[0].date.month, root.week[0].date.year) + " \u{2013} " + Strings.date(root.week[6].date.day, root.week[6].date.month, root.week[6].date.year);
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    min-width: 120px;
                }

                SubtleButton {
                    icon: @image-url("../icons/chevron-right.svg");
                    label: root.mode == CalendarMode.month ? @tr("Next month") : @tr("Next week");
                    clicked => {
                        root.shift(1);
                    }
                }

                SubtleButton {
                    text: @tr("Today");
                    color: Palette.foreground;
                    clicked => {
                        root.shift(0);
                    }
                }

                Rectangle {
                    width: 12px;
                }

                SettingsTab {
                    text: @tr("Month");
                    selected: root.mode == CalendarMode.month;
                    chosen => {
                        root.set-mode(CalendarMode.month);
                    }
                }

                SettingsTab {
                    text: @tr("Week");
                    selected: root.mode == CalendarMode.week;
                    chosen => {
                        root.set-mode(CalendarMode.week);
                    }
                }
            }

            if root.error != "": Text {
                text: root.error;
                color: Theme.critical;
                wrap: word-wrap;
            }

            if root.mode == CalendarMode.month: HorizontalLayout {
                spacing: 4px;
                for name in Strings.weekdays: Text {
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    text: name;
                    color: Theme.muted;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }

            if root.mode == CalendarMode.month: VerticalLayout {
                spacing: 4px;
                vertical-stretch: 1;
                for row in root.weeks: HorizontalLayout {
                    spacing: 4px;
                    for cell in row: CalendarCell {
                        cell: cell;
                        payload(id) => {
                            return root.task-payload(id);
                        }
                        drag-over(area, pos, data) => {
                            return root.follow(area, pos, data);
                        }
                        dropped(data) => {
                            root.reschedule(root.land(data), cell.date);
                        }
                        chip-dragging(dragging, t, at, width, grab) => {
                            root.card-dragging(dragging, { id: t.id, title: t.title }, at, width, grab);
                        }
                        chosen => {
                            root.day-chosen(cell.date);
                        }
                    }
                }
            }

            if root.mode == CalendarMode.week: WeekGrid {
                vertical-stretch: 1;
                days: root.week;
                now: root.now;
                slot(m) => {
                    return root.slot(m);
                }
                payload(id) => {
                    return root.task-payload(id);
                }
                drag-over(area, pos, data) => {
                    return root.follow(area, pos, data);
                }
                dropped-at(data, date, minutes) => {
                    root.reschedule-at(root.land(data), date, minutes);
                }
                dropped-untimed(data, date) => {
                    root.reschedule-untimed(root.land(data), date);
                }
                chip-dragging(dragging, t, at, width, grab) => {
                    root.card-dragging(dragging, { id: t.id, title: t.title }, at, width, grab);
                }
            }
        }

        // Dropping on the panel does nothing; the date is removed in the task editor. The bottom
        // margin keeps the lists clear of the floating button.
        if root.show-panel: VerticalLayout {
            width: 220px;
            padding-bottom: 72px;
            Rectangle {
                border-radius: 6px;
                background: Theme.field;
                VerticalLayout {
                    PanelSection {
                        title: @tr("smart list" => "Overdue");
                        tasks: root.overdue;
                        payload(id) => {
                            return root.task-payload(id);
                        }
                        chip-dragging(dragging, t, at, width, grab) => {
                            root.card-dragging(dragging, { id: t.id, title: t.title }, at, width, grab);
                        }
                    }

                    PanelSection {
                        title: @tr("No date");
                        tasks: root.undated;
                        payload(id) => {
                            return root.task-payload(id);
                        }
                        chip-dragging(dragging, t, at, width, grab) => {
                            root.card-dragging(dragging, { id: t.id, title: t.title }, at, width, grab);
                        }
                    }
                }
            }
        }
    }
}
