import { Palette } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// A task in a day cell; the calendar only shows it.
export struct CalendarTask {
    id: int,
    // From core: the title with its start time in front, when it has one.
    title: string,
    done: bool,
}

// A task title that can be dragged to a day. A click is not a drag, so it still reaches `clicked`.
export component TaskChip inherits Rectangle {
    in property <CalendarTask> task;
    // What a drop receives; built by the app so foreign drags can be told apart.
    in property <data-transfer> payload;
    in property <color> ink: Palette.foreground;
    callback clicked;
    // For the board's floating copy: whether this chip is in flight and where it was grabbed.
    out property <bool> dragging: drag.dragging;
    out property <length> grab-x: touch.pressed-x;
    out property <length> grab-y: touch.pressed-y;

    border-radius: 4px;
    background: touch.has-hover ? Theme.hover : transparent;
    opacity: drag.dragging ? 0.4 : 1;
    accessible-role: button;
    accessible-label: root.task.title;
    accessible-action-default => {
        root.clicked();
    }

    drag := DragArea {
        allow-move: true;
        data: root.payload;

        Text {
            x: 2px;
            width: parent.width - 4px;
            text: root.task.title;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            color: root.task.done ? Theme.done : root.ink;
            accessible-role: none;
        }

        touch := TouchArea {
            clicked => {
                root.clicked();
            }
        }
    }
}
