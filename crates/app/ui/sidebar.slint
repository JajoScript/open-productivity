import { ListView, Palette } from "std-widgets.slint";
import { InkField } from "ink-field.slint";
import { ListEntry } from "list-entry.slint";
import { NavEntry } from "nav-entry.slint";
import { SubtleButton } from "subtle-button.slint";
import { Theme } from "theme.slint";
import { TaskView } from "tasks/tasks-view.slint";

export component Sidebar inherits Rectangle {
    in property <string> instance-name;
    in property <bool> settings-open;
    in property <TaskView> current-view;
    in property <int> current-list-id;
    in property <int> today-count;
    in property <int> all-count;
    in property <[ListEntry]> lists;
    callback select-view(TaskView);
    callback select-list(int);
    callback create-list(string);
    callback open-settings;

    property <bool> adding;

    background: Palette.alternate-background;

    VerticalLayout {
        padding: 8px;
        padding-top: 12px;
        spacing: 2px;
        // The open instance, so the user always knows which data they are looking at.
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: root.instance-name;
                font-weight: 600;
                overflow: elide;
                height: 36px;
                vertical-alignment: center;
            }
        }

        NavEntry {
            icon: @image-url("icons/sun.svg");
            text: @tr("Today");
            count: root.today-count;
            selected: !root.settings-open && root.current-view == TaskView.today;
            clicked => {
                root.select-view(TaskView.today);
            }
        }

        NavEntry {
            icon: @image-url("icons/list-todo.svg");
            text: @tr("Tasks");
            count: root.all-count;
            selected: !root.settings-open && root.current-view == TaskView.all;
            clicked => {
                root.select-view(TaskView.all);
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 4px;
            padding-top: 16px;
            padding-bottom: 4px;
            Text {
                text: @tr("Lists");
                font-weight: 600;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            SubtleButton {
                icon: @image-url("icons/plus.svg");
                label: @tr("New list");
                clicked => {
                    root.adding = true;
                }
            }
        }

        if root.adding: FocusScope {
            height: name-input.preferred-height;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.adding = false;
                    return accept;
                }
                reject
            }
            name-input := InkField {
                placeholder-text: @tr("List name");
                init => {
                    self.focus();
                }
                accepted(text) => {
                    root.create-list(text);
                    root.adding = false;
                }
            }
        }

        ListView {
            for entry in root.lists: NavEntry {
                icon: @image-url("icons/list.svg");
                text: entry.name;
                count: entry.count;
                selected: !root.settings-open && root.current-view == TaskView.list && root.current-list-id == entry.id;
                clicked => {
                    root.select-list(entry.id);
                }
            }
        }

        // Pinned to the bottom: the list above takes all the spare height.
        NavEntry {
            icon: @image-url("icons/settings.svg");
            text: @tr("Settings");
            selected: root.settings-open;
            clicked => {
                root.open-settings();
            }
        }
    }
}
