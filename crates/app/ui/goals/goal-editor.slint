import { Date, Palette } from "std-widgets.slint";
import { FormField } from "../form-field.slint";
import { InkButton } from "../ink-button.slint";
import { Calendar, InkDatePopup } from "../ink-date-popup.slint";
import { InkField } from "../ink-field.slint";
import { InkFieldButton } from "../ink-field-button.slint";
import { InkOption, InkSelect } from "../ink-select.slint";
import { InkTextArea } from "../ink-text-area.slint";
import { PopupSurface } from "../popup-surface.slint";
import { SettingsTab } from "../settings/settings-tab.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { AccountKind } from "../finances/account-row.slint";
import { FinanceStore } from "../finances/finance-store.slint";
import { GoalKind, GoalsStore } from "goals-store.slint";

// The measure a new goal takes; it never changes afterwards.
enum Measure { none, numeric, money }

// Rebuilt on every show(), so the fields and the error always start fresh.
component EditorBody inherits FocusScope {
    in property <bool> editing;
    in-out property <GoalKind> kind;
    in-out property <string> goal-title;
    in-out property <string> emoji;
    in-out property <string> description;
    in-out property <bool> has-deadline;
    in-out property <Date> deadline;
    // Only a goal can have a measure, and it is chosen once.
    in-out property <bool> numeric;
    in-out property <string> target;
    in-out property <string> unit;
    // A money goal: `amount` in the currency of its reserve's account, chosen once.
    in-out property <bool> money;
    in-out property <string> amount;
    in-out property <int> account-id;
    in-out property <string> account-name;
    in-out property <string> currency;
    callback save(GoalKind, string, string, string, bool, Date, bool, string, string, bool, string, int) -> string;
    callback cancel;

    property <string> error;

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    function submit() {
        root.error = root.save(root.kind, root.goal-title, root.emoji, root.description, root.has-deadline, root.deadline, root.numeric && root.kind == GoalKind.goal, root.target, root.unit, root.money && root.kind == GoalKind.goal, root.amount, root.account-id);
    }

    function measure() -> Measure {
        return root.numeric ? Measure.numeric : root.money ? Measure.money : Measure.none;
    }

    function choose(m: Measure) {
        root.numeric = m == Measure.numeric;
        root.money = m == Measure.money;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: root.editing ? @tr("Edit goal") : @tr("New goal or project");
            font-size: 14px;
            font-weight: 700;
        }

        // The kind is chosen once; it never changes afterwards.
        if !root.editing: HorizontalLayout {
            alignment: start;
            accessible-role: tab-list;
            SettingsTab {
                text: @tr("Goal");
                selected: root.kind == GoalKind.goal;
                chosen => {
                    root.kind = GoalKind.goal;
                }
                step(d) => {
                    root.kind = d < 0 ? GoalKind.goal : GoalKind.project;
                }
            }

            SettingsTab {
                text: @tr("Project");
                selected: root.kind == GoalKind.project;
                chosen => {
                    root.kind = GoalKind.project;
                }
                step(d) => {
                    root.kind = d < 0 ? GoalKind.goal : GoalKind.project;
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            FormField {
                width: 96px;
                label: @tr("Emoji");
                InkField {
                    text <=> root.emoji;
                    placeholder-text: "🎯";
                }
            }

            FormField {
                label: @tr("Title");
                InkField {
                    text <=> root.goal-title;
                    placeholder-text: @tr("Title");
                    init => {
                        self.focus();
                    }
                    accepted(text) => {
                        root.submit();
                    }
                }
            }
        }

        FormField {
            label: @tr("Description");
            InkTextArea {
                text <=> root.description;
                placeholder-text: @tr("Optional");
                min-height: 80px;
                submitted => {
                    root.submit();
                }
            }
        }

        // The measure is chosen once, for goals only.
        if !root.editing && root.kind == GoalKind.goal: HorizontalLayout {
            alignment: start;
            accessible-role: tab-list;
            SettingsTab {
                text: @tr("No measure");
                selected: root.measure() == Measure.none;
                chosen => {
                    root.choose(Measure.none);
                }
                step(d) => {
                    root.choose(d > 0 ? Measure.numeric : Measure.none);
                }
            }

            SettingsTab {
                text: @tr("Numeric");
                selected: root.measure() == Measure.numeric;
                chosen => {
                    root.choose(Measure.numeric);
                }
                step(d) => {
                    root.choose(d > 0 ? Measure.money : Measure.none);
                }
            }

            SettingsTab {
                text: @tr("Money");
                selected: root.measure() == Measure.money;
                chosen => {
                    root.choose(Measure.money);
                }
                step(d) => {
                    root.choose(d > 0 ? Measure.money : Measure.numeric);
                }
            }
        }

        if root.numeric && root.kind == GoalKind.goal: HorizontalLayout {
            spacing: 12px;
            FormField {
                label: @tr("Target");
                InkField {
                    text <=> root.target;
                    placeholder-text: "100";
                    accepted(text) => {
                        root.submit();
                    }
                }
            }

            FormField {
                label: @tr("Unit");
                InkField {
                    text <=> root.unit;
                    placeholder-text: @tr("Optional");
                    accepted(text) => {
                        root.submit();
                    }
                }
            }
        }

        if root.money && root.kind == GoalKind.goal: HorizontalLayout {
            spacing: 12px;
            FormField {
                label: root.currency == "" ? @tr("Target amount") : @tr("Target amount ({})", root.currency);
                InkField {
                    text <=> root.amount;
                    placeholder-text: "100.000";
                    accepted(text) => {
                        root.submit();
                    }
                }
            }

            // The reserve is created in this account, and it never moves.
            if root.editing: FormField {
                label: @tr("Account");
                Text {
                    text: root.account-name;
                    height: 36px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if !root.editing: FormField {
                label: @tr("Account");
                InkSelect {
                    label: @tr("Account");
                    text: root.account-name;
                    for account in FinanceStore.accounts: VerticalLayout {
                        if account.kind != AccountKind.credit && account.kind != AccountKind.credit-line: InkOption {
                            label: account.name;
                            chosen: account.id == root.account-id;
                            picked => {
                                root.account-id = account.id;
                                root.account-name = account.name;
                                root.currency = account.currency;
                            }
                        }
                    }
                }
            }
        }

        if root.money && root.kind == GoalKind.goal && !root.editing: Text {
            text: @tr("The money is set aside in a reserve of the account, also shown in Finances.");
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        FormField {
            label: @tr("Deadline");
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    height: 36px;
                    picker := InkDatePopup {
                        y: 38px;
                        day: root.has-deadline ? root.deadline.day : 0;
                        month: root.deadline.month;
                        year: root.deadline.year;
                        picked(date) => {
                            root.deadline = date;
                            root.has-deadline = true;
                        }
                    }

                    InkFieldButton {
                        label: @tr("Deadline");
                        text: root.has-deadline ? Strings.date(root.deadline.day, root.deadline.month, root.deadline.year) : @tr("No deadline");
                        icon: @image-url("../icons/calendar.svg");
                        clicked => {
                            picker.show();
                        }
                    }
                }

                if root.has-deadline: SubtleButton {
                    icon: @image-url("../icons/x.svg");
                    label: @tr("Remove deadline");
                    clicked => {
                        root.has-deadline = false;
                    }
                }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.critical;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            SubtleButton {
                text: @tr("Cancel");
                color: Palette.foreground;
                clicked => {
                    root.cancel();
                }
            }

            InkButton {
                text: root.editing ? @tr("Save") : @tr("Create");
                clicked => {
                    root.submit();
                }
            }
        }
    }
}

// Creates a goal or project, or edits the open one, depending on how it is opened. Closing by
// clicking outside discards it.
export component GoalEditor inherits PopupWindow {
    // Set by the opener before show(); editing starts from the open goal.
    in property <bool> editing;

    close-policy: close-on-click-outside;
    width: 440px;

    PopupSurface {
        EditorBody {
            editing: root.editing;
            goal-title: root.editing ? GoalsStore.detail.title : "";
            emoji: root.editing ? GoalsStore.detail.emoji : "";
            description: root.editing ? GoalsStore.detail.description : "";
            has-deadline: root.editing ? GoalsStore.detail.has-deadline : false;
            deadline: root.editing ? GoalsStore.detail.deadline : Calendar.today();
            numeric: root.editing ? GoalsStore.detail.is-numeric : false;
            target: root.editing && GoalsStore.detail.is-numeric ? "\{GoalsStore.detail.target}" : "";
            unit: root.editing ? GoalsStore.detail.unit : "";
            money: root.editing ? GoalsStore.detail.is-financial : false;
            amount: root.editing ? GoalsStore.detail.target-input : "";
            account-id: root.editing ? GoalsStore.detail.account-id : 0;
            account-name: root.editing ? GoalsStore.detail.account-name : "";
            currency: root.editing ? GoalsStore.detail.currency : "";
            save(kind, title, emoji, description, has-deadline, deadline, numeric, target, unit, money, amount, account) => {
                let error = root.editing ? GoalsStore.update(GoalsStore.detail.id, title, emoji, description, has-deadline, deadline, numeric, target, unit, money, amount, account) : GoalsStore.create(kind, title, emoji, description, has-deadline, deadline, numeric, target, unit, money, amount, account);
                if error == "" {
                    root.close();
                }
                return error;
            }
            cancel => {
                root.close();
            }
        }
    }
}
