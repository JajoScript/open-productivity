import { ScrollView } from "std-widgets.slint";
import { EmptyState } from "../empty-state.slint";
import { InkButton } from "../ink-button.slint";
import { SettingsTab } from "../settings/settings-tab.slint";
import { Theme } from "../theme.slint";
import { GoalCard } from "goal-card.slint";
import { GoalDetail } from "goal-detail.slint";
import { GoalsSidebar } from "goals-sidebar.slint";
import { GoalTab, GoalsStore } from "goals-store.slint";

// What the empty state shows: three cards in use, quiet and non-interactive.
component GoalsPreview inherits HorizontalLayout {
    spacing: 8px;
    accessible-role: none;
    for n in 3: Rectangle {
        width: 56px;
        height: 68px;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.hairline;
        opacity: n == 0 ? 1 : 0.6;
        Rectangle {
            height: 28px;
            y: 0px;
            background: Theme.selected;
            border-top-left-radius: 7px;
            border-top-right-radius: 7px;
        }

        Rectangle {
            x: 8px;
            y: 38px;
            width: 40px;
            height: 6px;
            border-radius: 3px;
            background: Theme.hairline;
        }

        Rectangle {
            x: 8px;
            y: 50px;
            width: 24px;
            height: 6px;
            border-radius: 3px;
            background: Theme.hairline;
        }
    }
}

// Goals and projects as cards, nearest deadline first, with the open one in a side panel.
export component GoalsView inherits VerticalLayout {
    // Open the window's editor modal.
    callback new-goal();
    callback edit-goal();
    callback new-task();
    callback new-entry();

    property <length> gap: 16px;
    property <[GoalTab]> tabs: [GoalTab.all, GoalTab.goals, GoalTab.projects, GoalTab.completed, GoalTab.archived];
    property <[string]> tab-names: [@tr("All"), @tr("goal tab" => "Goals"), @tr("Projects"), @tr("goal tab" => "Completed"), @tr("goal tab" => "Archived")];
    property <length> min-card: 240px;

    padding: 24px;
    padding-top: 20px;
    spacing: 12px;

    function choose(index: int) {
        if index >= 0 && index < root.tabs.length && GoalsStore.tab != root.tabs[index] {
            GoalsStore.tab = root.tabs[index];
            GoalsStore.refresh();
        }
    }

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: @tr("Goals");
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        InkButton {
            text: @tr("New goal");
            clicked => {
                root.new-goal();
            }
        }
    }

    Text {
        text: @tr("What you want to reach, and the projects that get you there.");
        color: Theme.muted;
        wrap: word-wrap;
    }

    if GoalsStore.any-goal: HorizontalLayout {
        spacing: 0px;
        alignment: start;
        accessible-role: tab-list;
        for name[i] in root.tab-names: SettingsTab {
            text: name;
            selected: GoalsStore.tab == root.tabs[i];
            chosen => {
                root.choose(i);
            }
            step(d) => {
                root.choose(i + d);
            }
        }
    }

    if GoalsStore.error != "": Text {
        text: GoalsStore.error;
        color: Theme.critical;
        wrap: word-wrap;
    }

    if !GoalsStore.any-goal: EmptyState {
        title: @tr("Set your first goal");
        description: @tr("Write down what you want to reach, with an emoji and a deadline. Each card counts the days you have left.");
        action: @tr("New goal");
        clicked => {
            root.new-goal();
        }

        GoalsPreview { }
    }

    if GoalsStore.any-goal: HorizontalLayout {
        vertical-stretch: 1;
        spacing: 24px;
        padding-top: 12px;
        // Room for the floating create button under the panel's actions.
        padding-bottom: 64px;

        if GoalsStore.goals.length == 0: EmptyState {
            horizontal-stretch: 1;
            title: GoalsStore.tab == GoalTab.completed ? @tr("Nothing completed yet") : GoalsStore.tab == GoalTab.archived ? @tr("Nothing archived") : GoalsStore.tab == GoalTab.projects ? @tr("No projects yet") : @tr("No goals yet");
            description: GoalsStore.tab == GoalTab.completed ? @tr("When you finish a goal, mark it as completed and it stays here, so you can see everything you achieved.") : GoalsStore.tab == GoalTab.archived ? @tr("Archive a goal you set aside to take it off the list without deleting it. You can restore it whenever you want.") : @tr("Write down what you want to reach, with an emoji and a deadline. Each card counts the days you have left.");
            action: GoalsStore.tab == GoalTab.completed || GoalsStore.tab == GoalTab.archived ? "" : @tr("New goal");
            clicked => {
                root.new-goal();
            }

            GoalsPreview { }
        }

        if GoalsStore.goals.length > 0: grid := ScrollView {
            // The scroll bar takes the right edge of the viewport.
            property <length> avail: self.visible-width - 16px;
            property <int> cols: max(1, floor((self.avail + root.gap) / (root.min-card + root.gap)));
            property <length> card-w: (self.avail - (self.cols - 1) * root.gap) / self.cols;

            content-height: ceil(GoalsStore.goals.length / self.cols) * (224px + root.gap);
            horizontal-stretch: 1;

            for goal[i] in GoalsStore.goals: GoalCard {
                x: mod(i, grid.cols) * (grid.card-w + root.gap);
                y: floor(i / grid.cols) * (self.height + root.gap);
                width: grid.card-w;
                goal: goal;
                selected: GoalsStore.detail-open && GoalsStore.detail.id == goal.id;
                opened => {
                    GoalsStore.open(goal.id);
                }
            }
        }

        if !GoalsStore.detail-open: GoalsSidebar { }

        if GoalsStore.detail-open: GoalDetail {
            width: 320px;
            goal: GoalsStore.detail;
            tasks: GoalsStore.tasks;
            entries: GoalsStore.entries;
            close => {
                GoalsStore.detail-open = false;
            }
            edit => {
                root.edit-goal();
            }
            add-task => {
                root.new-task();
            }
            add-entry => {
                root.new-entry();
            }
            delete => {
                GoalsStore.error = GoalsStore.delete(GoalsStore.detail.id);
            }
            complete => {
                GoalsStore.error = GoalsStore.complete(GoalsStore.detail.id);
            }
            set-archived(archived) => {
                GoalsStore.error = GoalsStore.set-archived(GoalsStore.detail.id, archived);
            }
        }
    }
}
