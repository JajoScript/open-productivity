import { Theme } from "../theme.slint";

// "Tasks   33 % · 1/3" (or a label and `counts`) over a thin bar. `percent` comes from core.
export component GoalProgress inherits VerticalLayout {
    in property <int> done;
    in property <int> total;
    in property <int> percent;
    in property <string> label: @tr("Tasks");
    // When set, shown after the percent instead of "done/total".
    in property <string> counts;

    spacing: 4px;
    accessible-role: none;

    HorizontalLayout {
        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.muted;
            accessible-role: none;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: root.counts != "" ? @tr("{} % · {}", root.percent, root.counts) : @tr("{} % · {}/{}", root.percent, root.done, root.total);
            font-size: 12px;
            color: Theme.muted;
            accessible-role: none;
        }
    }

    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.hairline;
        accessible-role: none;
        Rectangle {
            x: 0px;
            width: parent.width * root.percent / 100;
            border-radius: 3px;
            background: Theme.ink;
            animate width { duration: Theme.enter; easing: Theme.ease-out; }
        }
    }
}
