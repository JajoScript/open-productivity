import { Palette, ScrollView } from "std-widgets.slint";
import { InkCheck } from "../ink-check.slint";
import { InkButton } from "../ink-button.slint";
import { PopupSurface } from "../popup-surface.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { KindLabel } from "goal-card.slint";
import { GoalProgress } from "goal-progress.slint";
import { ReserveMoveRow } from "../finances/reserve-row.slint";
import { GoalEntryRow, GoalRow, GoalTaskRow, GoalsStore } from "goals-store.slint";

// One goal in a side panel: its emoji, title, description and deadline, with edit and delete.
export component GoalDetail inherits Rectangle {
    in property <GoalRow> goal;
    in property <[GoalTaskRow]> tasks;
    in property <[GoalEntryRow]> entries;
    in property <[ReserveMoveRow]> moves;
    callback close;
    callback edit;
    callback add-task;
    callback add-entry;
    // Opens the reserve modal: to withdraw, or to reserve money.
    callback move-money(bool);
    callback delete;
    callback complete;
    callback set-archived(bool);

    border-width: 1px;
    border-color: Theme.hairline;
    border-radius: 6px;
    clip: true;

    VerticalLayout {
        Rectangle {
            height: 96px;
            background: Theme.selected;

            if root.goal.emoji != "": Text {
                text: root.goal.emoji;
                font-size: 44px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }

            if root.goal.emoji == "": Image {
                source: @image-url("../icons/target.svg");
                colorize: Theme.muted;
                width: 36px;
                height: 36px;
                accessible-role: none;
            }

            HorizontalLayout {
                x: parent.width - self.width - 8px;
                y: 8px;
                width: self.preferred-width;
                height: 28px;
                spacing: 2px;
                SubtleButton {
                    icon: @image-url("../icons/pencil.svg");
                    label: @tr("Edit");
                    clicked => {
                        root.edit();
                    }
                }

                SubtleButton {
                    icon: @image-url("../icons/trash-2.svg");
                    label: @tr("Delete");
                    clicked => {
                        confirm.show();
                    }
                }

                SubtleButton {
                    icon: @image-url("../icons/x.svg");
                    label: @tr("Close");
                    clicked => {
                        root.close();
                    }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                alignment: start;
                width: parent.width;
                KindLabel {
                    kind: root.goal.kind;
                }

                if root.goal.completed || root.goal.archived: Text {
                    text: root.goal.completed && root.goal.archived ? @tr("Completed · Archived") : root.goal.completed ? @tr("goal stamp" => "Completed") : @tr("goal status" => "Archived");
                    font-size: 12px;
                    color: Theme.muted;
                }

                Text {
                    text: root.goal.title;
                    font-size: 18px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Text {
                    text: root.goal.description != "" ? root.goal.description : @tr("No description.");
                    color: root.goal.description != "" ? Palette.foreground : Theme.muted;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 8px;
                }

                Text {
                    text: @tr("Deadline");
                    font-size: 12px;
                    color: Theme.muted;
                }

                Text {
                    text: root.goal.has-deadline ? Strings.date(root.goal.deadline.day, root.goal.deadline.month, root.goal.deadline.year) : @tr("No deadline");
                    wrap: word-wrap;
                }

                if root.goal.has-deadline: Text {
                    text: GoalsStore.days-text(true, root.goal.days-left);
                    color: root.goal.days-left < 0 ? Theme.critical : Palette.foreground;
                    font-weight: 600;
                }

                Rectangle {
                    height: 8px;
                }

                if root.goal.is-numeric: GoalProgress {
                    label: @tr("Progress");
                    counts: GoalsStore.amount-text(root.goal.total, root.goal.target, root.goal.unit);
                    percent: root.goal.numeric-percent;
                }

                if root.goal.is-numeric && root.entries.length == 0: Text {
                    text: @tr("No progress yet.");
                    color: Theme.muted;
                }

                for entry in root.entries: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Strings.date(entry.date.day, entry.date.month, entry.date.year);
                        color: Theme.muted;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    Text {
                        text: root.goal.unit == "" ? "\{entry.value}" : "\{entry.value} \{root.goal.unit}";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                        accessible-role: none;
                    }

                    SubtleButton {
                        icon: @image-url("../icons/x.svg");
                        label: @tr("Delete progress");
                        clicked => {
                            GoalsStore.delete-entry(entry.id);
                        }
                    }
                }

                if root.goal.is-numeric: HorizontalLayout {
                    alignment: end;
                    SubtleButton {
                        text: @tr("Add progress");
                        color: Palette.foreground;
                        clicked => {
                            root.add-entry();
                        }
                    }
                }

                if root.goal.is-numeric: Rectangle {
                    height: 8px;
                }

                if root.goal.is-financial: GoalProgress {
                    label: @tr("Reserved");
                    counts: GoalsStore.money-text(root.goal.reserved, root.goal.target-amount);
                    percent: root.goal.money-percent;
                }

                if root.goal.is-financial: Text {
                    text: root.goal.account-name;
                    font-size: 12px;
                    color: Theme.muted;
                    overflow: elide;
                }

                if root.goal.is-financial && root.moves.length == 0: Text {
                    text: @tr("No moves yet.");
                    color: Theme.muted;
                }

                for m in root.moves: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Strings.date(m.date.day, m.date.month, m.date.year);
                        color: Theme.muted;
                        accessible-role: none;
                    }

                    Text {
                        text: m.description;
                        horizontal-stretch: 1;
                        overflow: elide;
                        accessible-role: none;
                    }

                    Text {
                        text: m.withdraw ? "\u{2212}" + m.amount : "+" + m.amount;
                        font-weight: 600;
                        horizontal-alignment: right;
                        accessible-role: none;
                    }
                }

                if root.goal.is-financial && !root.goal.archived: HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    SubtleButton {
                        text: @tr("Withdraw");
                        color: Palette.foreground;
                        clicked => {
                            root.move-money(true);
                        }
                    }

                    SubtleButton {
                        text: @tr("Reserve money");
                        color: Palette.foreground;
                        clicked => {
                            root.move-money(false);
                        }
                    }
                }

                if root.goal.is-financial: Rectangle {
                    height: 8px;
                }

                if root.goal.tasks-total > 0: GoalProgress {
                    done: root.goal.tasks-done;
                    total: root.goal.tasks-total;
                    percent: root.goal.tasks-percent;
                }

                if root.goal.tasks-total == 0: Text {
                    text: @tr("No tasks yet.");
                    color: Theme.muted;
                }

                for task in root.tasks: HorizontalLayout {
                    spacing: 8px;
                    InkCheck {
                        checked: task.done;
                        label: task.title;
                        toggled(done) => {
                            GoalsStore.set-task-done(task.id, done);
                        }
                    }

                    Text {
                        text: task.title;
                        color: task.done ? Theme.done : Palette.foreground;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: none;
                    }

                    if task.has-due: Text {
                        text: Strings.short-date(task.due.day, task.due.month);
                        color: Theme.muted;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    SubtleButton {
                        text: @tr("Add task");
                        color: Palette.foreground;
                        clicked => {
                            root.add-task();
                        }
                    }
                }
            }
        }

        // One ink action at a time: completing is the step the panel leads to.
        HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: end;
            if !root.goal.archived: SubtleButton {
                icon: @image-url("../icons/archive.svg");
                text: @tr("Archive");
                color: Palette.foreground;
                clicked => {
                    root.set-archived(true);
                }
            }

            if root.goal.archived: SubtleButton {
                icon: @image-url("../icons/archive-restore.svg");
                text: @tr("Restore");
                color: Palette.foreground;
                clicked => {
                    root.set-archived(false);
                }
            }

            if !root.goal.completed && !root.goal.archived: InkButton {
                text: @tr("Complete");
                clicked => {
                    confirm-complete.show();
                }
            }
        }
    }

    confirm-complete := PopupWindow {
        x: (root.width - self.width) / 2;
        y: root.height - 160px;
        width: min(root.width - 24px, 320px);
        PopupSurface {
            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    text: GoalsStore.complete-question(root.goal.title);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    SubtleButton {
                        text: @tr("Cancel");
                        color: Palette.foreground;
                        init => {
                            self.focus();
                        }
                        clicked => {
                            confirm-complete.close();
                        }
                    }

                    InkButton {
                        text: @tr("Complete");
                        clicked => {
                            confirm-complete.close();
                            root.complete();
                        }
                    }
                }
            }
        }
    }

    confirm := PopupWindow {
        x: (root.width - self.width) / 2;
        // Under the header, where Delete is.
        y: 44px;
        width: min(root.width - 24px, 320px);
        PopupSurface {
            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    text: GoalsStore.delete-question(root.goal.title);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    SubtleButton {
                        text: @tr("Cancel");
                        color: Palette.foreground;
                        init => {
                            self.focus();
                        }
                        clicked => {
                            confirm.close();
                        }
                    }

                    InkButton {
                        text: @tr("Delete");
                        clicked => {
                            confirm.close();
                            root.delete();
                        }
                    }
                }
            }
        }
    }
}
