import { Date, Palette } from "std-widgets.slint";
import { InkButton } from "../ink-button.slint";
import { Calendar, InkDatePopup } from "../ink-date-popup.slint";
import { InkField } from "../ink-field.slint";
import { PopupSurface } from "../popup-surface.slint";
import { Strings } from "../strings.slint";
import { SubtleButton } from "../subtle-button.slint";
import { Theme } from "../theme.slint";
import { GoalsStore } from "goals-store.slint";

// Rebuilt on every show(), so the fields and the error always start fresh.
component CreatorBody inherits FocusScope {
    in-out property <Date> date: Calendar.today();
    callback save(string, bool, Date) -> string;
    callback cancel;

    property <string> title;
    property <bool> has-date;
    property <string> error;

    capture-key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        reject
    }

    function submit() {
        root.error = root.save(root.title, root.has-date, root.date);
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: @tr("New task");
            font-size: 14px;
            font-weight: 700;
        }

        InkField {
            text <=> root.title;
            placeholder-text: @tr("Task");
            init => {
                self.focus();
            }
            accepted(text) => {
                root.submit();
            }
        }

        HorizontalLayout {
            height: 36px;
            alignment: start;
            spacing: 4px;
            picker := InkDatePopup {
                y: 36px;
                day: root.has-date ? root.date.day : 0;
                month: root.date.month;
                year: root.date.year;
                picked(date) => {
                    root.date = date;
                    root.has-date = true;
                }
            }

            SubtleButton {
                text: root.has-date ? Strings.date(root.date.day, root.date.month, root.date.year) : @tr("Add date");
                icon: @image-url("../icons/calendar.svg");
                color: root.has-date ? Palette.foreground : Theme.muted;
                clicked => {
                    picker.show();
                }
            }

            if root.has-date: SubtleButton {
                icon: @image-url("../icons/x.svg");
                label: @tr("Remove date");
                clicked => {
                    root.has-date = false;
                }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.critical;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            SubtleButton {
                text: @tr("Cancel");
                color: Palette.foreground;
                clicked => {
                    root.cancel();
                }
            }

            InkButton {
                text: @tr("Add");
                clicked => {
                    root.submit();
                }
            }
        }
    }
}

// Adds a task to the open goal, optionally with a due date. Closing by clicking outside discards it.
export component GoalTaskCreator inherits PopupWindow {
    close-policy: close-on-click-outside;
    width: 360px;

    PopupSurface {
        CreatorBody {
            save(title, has-date, date) => {
                let error = GoalsStore.create-task(GoalsStore.detail.id, title, has-date, date);
                if error == "" {
                    root.close();
                }
                return error;
            }
            cancel => {
                root.close();
            }
        }
    }
}
