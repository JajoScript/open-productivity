import { Palette } from "std-widgets.slint";
import { Strings } from "../strings.slint";
import { Theme } from "../theme.slint";
import { GoalProgress } from "goal-progress.slint";
import { GoalKind, GoalPace, GoalRow, GoalsStore } from "goals-store.slint";

// The kind of a goal as a small label.
export component KindLabel inherits Text {
    in property <GoalKind> kind;

    text: root.kind == GoalKind.project ? @tr("Project") : @tr("Goal");
    font-size: 12px;
    color: Theme.muted;
    accessible-role: none;
}

// "Ahead" / "On pace" / "Behind" as a small pill; only behind is flagged.
export component PaceBadge inherits Rectangle {
    in property <GoalPace> pace;

    width: label.preferred-width + 16px;
    height: 20px;
    border-radius: 10px;
    background: Theme.selected;
    accessible-role: none;

    label := Text {
        text: root.pace == GoalPace.ahead ? @tr("Ahead") : root.pace == GoalPace.behind ? @tr("Behind") : @tr("On pace");
        color: root.pace == GoalPace.behind ? Theme.critical : root.pace == GoalPace.ahead ? Theme.ink : Theme.muted;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// "Completed" as a small pill with a check, in place of the pace.
export component CompletedBadge inherits Rectangle {
    width: row.preferred-width;
    height: 20px;
    border-radius: 10px;
    background: Theme.selected;
    accessible-role: none;

    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;
        Image {
            source: @image-url("../icons/check.svg");
            colorize: Theme.ink;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            accessible-role: none;
        }

        Text {
            text: @tr("goal stamp" => "Completed");
            color: Theme.ink;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// A goal as a card: a band with its emoji, then title, deadline and the days left.
export component GoalCard inherits Rectangle {
    in property <GoalRow> goal;
    in property <bool> selected;
    callback opened;

    height: 224px;
    border-radius: 6px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.ink : Theme.hairline;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background, border-color { duration: Theme.fast; easing: Theme.ease-out; }
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.goal.title + ", " + GoalsStore.days-text(root.goal.has-deadline, root.goal.days-left);
    accessible-action-default => {
        root.opened();
    }

    VerticalLayout {
        // The band takes the height the content leaves, like the legacy cover, so a card without
        // progress bars has no empty bottom.
        Rectangle {
            min-height: 64px;
            vertical-stretch: 1;
            background: Theme.selected;
            border-top-left-radius: 5px;
            border-top-right-radius: 5px;

            if root.goal.emoji != "": Text {
                text: root.goal.emoji;
                font-size: 32px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }

            if root.goal.emoji == "": Image {
                source: @image-url("../icons/target.svg");
                colorize: Theme.muted;
                width: 28px;
                height: 28px;
                accessible-role: none;
            }

            KindLabel {
                x: parent.width - self.width - 10px;
                y: 8px;
                kind: root.goal.kind;
            }
        }

        VerticalLayout {
            vertical-stretch: 0;
            padding: 12px;
            spacing: 6px;
            Text {
                text: root.goal.title;
                font-weight: 700;
                overflow: elide;
                accessible-role: none;
            }

            if root.goal.has-deadline: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: Strings.date(root.goal.deadline.day, root.goal.deadline.month, root.goal.deadline.year);
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }

                if root.goal.completed: CompletedBadge { }

                if !root.goal.completed && root.goal.has-pace: PaceBadge {
                    pace: root.goal.pace;
                }
            }

            Text {
                text: GoalsStore.days-text(root.goal.has-deadline, root.goal.days-left);
                color: !root.goal.completed && root.goal.has-deadline && root.goal.days-left < 0 ? Theme.critical : Palette.foreground;
                font-weight: 600;
                accessible-role: none;
            }

            if root.goal.is-numeric: GoalProgress {
                label: @tr("Progress");
                counts: GoalsStore.amount-text(root.goal.total, root.goal.target, root.goal.unit);
                percent: root.goal.numeric-percent;
            }

            if root.goal.is-financial: GoalProgress {
                label: @tr("Reserved");
                counts: GoalsStore.money-text(root.goal.reserved, root.goal.target-amount);
                percent: root.goal.money-percent;
            }

            if root.goal.tasks-total > 0: GoalProgress {
                done: root.goal.tasks-done;
                total: root.goal.tasks-total;
                percent: root.goal.tasks-percent;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.opened();
        }
    }

    focus := FocusScope {
        width: 0px; // keyboard only; clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.opened();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.foreground;
    }
}
